// rosmsg.nv — a message as bytes this package does not read, and the
// four-byte header that says which way round they are.
//
// `[]` THROUGHOUT.  Nothing here performs anything.
//
// THIS PACKAGE DOES NOT SERIALISE.  A ROS 2 message on the wire is
// Common Data Representation: a header saying which byte order follows,
// then fields laid out with alignment rules of their own.  That is a
// subject with a specification, and the ROS 2 plan gives it its own
// package.  A second implementation of it here would be a second
// original, and the day the two disagreed about a padding byte a bag
// file written by one would be unreadable by the other.
//
// So a message here is a payload, a type and an encapsulation, and the
// payload is opaque.  What this module does own is the FOUR BYTES IN
// FRONT of it, because those are not part of the message: they say
// which byte order the rest is in, they travel with the payload rather
// than with the type, and a reader that skips them reads a
// little-endian message as a big-endian one and gets numbers that are
// wrong by a factor of sixteen million.
//
// AND THE MTU IS A LIMIT WITH NO ERROR BEHIND IT.  A micro-ROS build
// has a transport buffer fixed at compile time — 512 bytes is the
// default on a serial link — and a message that does not fit is dropped
// by the transport, below the layer that could report it.  A node
// publishing a laser scan over a serial link publishes nothing, and
// says nothing.  `fits_mtu` is the check, and it is the reason the
// message carries its own length.

// ── Encapsulation (the four bytes in front) ──────────────────────────

// How many bytes the encapsulation header takes: 4.
//
// Two for the representation identifier and two of options, which are
// zero in everything ROS 2 sends.
pub const ROS_ENCAPSULATION_BYTES = 4

// Plain CDR, most significant byte first: 0x0000.
pub const ROS_CDR_BE = 0x0000
// Plain CDR, least significant byte first: 0x0001.  What every ROS 2
// node on every ordinary processor sends.
pub const ROS_CDR_LE = 0x0001
// Parameter-list CDR, most significant byte first: 0x0002.
pub const ROS_PL_CDR_BE = 0x0002
// Parameter-list CDR, least significant byte first: 0x0003.
pub const ROS_PL_CDR_LE = 0x0003

// ── A message ────────────────────────────────────────────────────────

// A serialised message, its type, and which way round its bytes are.
//
// A PLAIN STRUCT AND NOT A `@value`, because it holds a `Bytes`.  That
// is also why this module is not claimed for a device: a firmware holds
// its payload in a buffer it owns, and hands this package the length
// and the encapsulation rather than a heap value.
pub struct RosMessage
    // The payload, WITHOUT the encapsulation header.
    payload: Bytes
    // The message type, as `rosname.type_id` computes it.
    type_id: Int
    // One of the four `ROS_CDR_*` or `ROS_PL_CDR_*` identifiers.
    encapsulation: Int

// A message from a payload that has no header on it yet.
//
// Little-endian, which is what every ROS 2 node this will talk to
// sends.
pub @tier(system)
fn message(payload: Bytes, type_id: Int) -> RosMessage []
    // Little-endian is what every ROS 2 node this will talk to sends.
    message_with(payload, type_id, ROS_CDR_LE)

// A message from a payload in a stated byte order.
pub @tier(system)
fn message_with(payload: Bytes, type_id: Int, encapsulation: Int) -> RosMessage []
    system
        // The struct is built whole, and the payload is shared rather
        // than copied.
        return RosMessage { payload: payload, type_id: type_id, encapsulation: encapsulation }

// The message a received buffer holds, header and all.
//
// Reads the four-byte header, keeps the rest as the payload, and
// answers a message whose encapsulation is what the header said.  A
// buffer shorter than four bytes answers a message with an
// encapsulation of -1.
pub @tier(system)
fn decode_envelope(buffer: Bytes, type_id: Int) -> RosMessage []
    system
        // A buffer with no room for a header has no header to read and
        // an encapsulation that is not known; nothing was a header, so
        // nothing is dropped from it.
        if bytes.len(buffer) < ROS_ENCAPSULATION_BYTES
            return RosMessage { payload: buffer, type_id: type_id, encapsulation: 0 - 1 }
        // The representation identifier goes big-endian in the header
        // whatever the payload's own byte order is.
        let encapsulation = bytes.u16_be_at(buffer, 0) ?? 0 - 1
        let body: Bytes = bytes.slice(buffer, ROS_ENCAPSULATION_BYTES, bytes.len(buffer))
        return RosMessage { payload: body, type_id: type_id, encapsulation: encapsulation }

// The bytes to send: the four-byte header, then the payload.
pub @tier(system)
fn encode_envelope(m: RosMessage) -> Bytes []
    system
        // The four bytes are the representation identifier, most
        // significant first, and two option bytes that are zero in
        // everything ROS 2 sends.
        return bytes.u16_be(m.encapsulation) + bytes.zeros(2) + m.payload

// Whether the envelope is one of the four this package knows.
pub @tier(system)
fn envelope_is_known(encapsulation: Int) -> Bool []
    // The four identifiers are 0 to 3, so the range is the question.
    encapsulation >= ROS_CDR_BE and encapsulation <= ROS_PL_CDR_LE

// Whether the payload's numbers are least significant byte first.
//
// The one question about a message this package can answer without
// reading the payload, and the one a serialiser has to be told.
pub @tier(system)
fn is_little_endian(m: RosMessage) -> Bool []
    m.encapsulation == ROS_CDR_LE or m.encapsulation == ROS_PL_CDR_LE

// Whether the message carries a parameter list rather than a plain
// structure.
//
// A different layout, used for the discovery messages the middleware
// exchanges rather than for anything a node publishes.
pub @tier(system)
fn is_parameter_list(m: RosMessage) -> Bool []
    m.encapsulation == ROS_PL_CDR_BE or m.encapsulation == ROS_PL_CDR_LE

// The payload, with no header on it.
pub @tier(system)
fn payload(m: RosMessage) -> Bytes []
    system
        // A copy, because a plain `Bytes` answer hands the caller a
        // buffer it may write, and the message's own payload is not its
        // buffer.
        return bytes.clone(m.payload)

// How many bytes the payload holds.
pub @tier(system)
fn payload_length(m: RosMessage) -> Int []
    bytes.len(m.payload)

// How many bytes go on the wire: the payload and the four-byte header.
pub @tier(system)
fn wire_length(m: RosMessage) -> Int []
    // What the transport counts: the payload and the header in front
    // of it.
    bytes.len(m.payload) + ROS_ENCAPSULATION_BYTES

// The encapsulation in words.
pub @tier(system)
fn encapsulation_name(encapsulation: Int) -> Str []
    match encapsulation
        0 => "cdr big endian"   // ROS_CDR_BE
        1 => "cdr little endian"   // ROS_CDR_LE
        2 => "pl cdr big endian"   // ROS_PL_CDR_BE
        3 => "pl cdr little endian"   // ROS_PL_CDR_LE
        _ => "unknown"

// ── The transport's ceiling ──────────────────────────────────────────

// The transport buffer a stock micro-ROS build has: 512 bytes.
//
// Set at compile time in the firmware, shared by every message, and
// the reason a node that publishes a small message every cycle works
// and the same node publishing an image does not.
pub const ROS_DEFAULT_MTU = 512

// Whether the whole message fits in a transport of this size.
//
// Counts the encapsulation header, because the transport does.  A
// message that does not fit is dropped BELOW the layer that could
// report it: the publish call succeeds, nothing arrives, and no error
// appears anywhere.
//
// ```novo
// use rosmsg
// use std.bytes
//
// fn main() [io]
//     let m = rosmsg.message(bytes.zeros(600), 1234)
//     println("${rosmsg.fits_mtu(m, rosmsg.ROS_DEFAULT_MTU)}")   // false
// ```
pub @tier(system)
fn fits_mtu(m: RosMessage, mtu: Int) -> Bool []
    // The header goes out too, so it counts against the buffer.
    wire_length(m) <= mtu

// The largest payload a transport of this size can carry.
//
// The size less the four header bytes, and less whatever the session
// framing takes — `rostransport.framing_overhead` is that number, and
// this takes it as an argument rather than assuming a transport.
pub @tier(system)
fn max_payload(mtu: Int, framing_overhead: Int) -> Int []
    // The session framing and this module's own header both come out
    // of the same buffer the payload does.
    mtu - framing_overhead - ROS_ENCAPSULATION_BYTES

// Whether two messages carry the same type.
pub @tier(system)
fn same_type(a: RosMessage, b: RosMessage) -> Bool []
    a.type_id == b.type_id
