// rosuart.nv — the session of this package over a UART, for a device.
//
// `@tier(embedded)` ON ALL OF IT AND NO ALLOCATION.  A message is built
// in a `Vec[u8; 512]`, framed into a `Vec[u8; 1037]`, and read back
// through a `XrceDeframer`, all of them values the caller holds, so a node
// whose agent sits on the other end of a serial cable runs with no heap.
//
// THE UART IS A TRAIT, `XrceUart[e]`, for the reason `RosTransport[e]`
// is one: the code that frames, retries and matches a reply to its
// request is the part worth testing, and it is the same whether the
// bytes cross a pin or a table in a test.  `ConsoleUart` is the board's
// own: `hal.uart`, which is the console the board's log uses, and the
// UART itself when the image is built with `--hci-uart=physical` (on the
// nRF54LM20 DK that is UARTE30 on P0.06 to P0.09, the J-Link's first
// virtual COM port; `docs/hal/README.md` lists each board's).  A board
// that logs over RTT, the default, has no UART in `hal.uart`: the build
// must say `--hci-uart=physical`, and the console's log lines must go
// elsewhere, because the same wire carries the agent's frames.
//
// WHY NOT `RosTransport`.  That trait's unit is a `Bytes`, and a
// `Bytes` is a heap value that the embedded tier does not admit
// (`bytes.byte_at` and `bytes.from_byte_list` allocate or are refused).
// The device functions here take the message in a `Vec` instead, and
// say what they did in a `RosOutcome`, as the host functions in
// `rostransport` do.  Both are built from the same `xrcewire` and the
// same `RosSession`.
//
// NO CLOCK.  A wait is a number of milliseconds the caller names, spent
// as that many calls to the UART's `uart_pause_ms` between polls.  The
// console's pause is `hal.timer.delay_ms`, so the wait is the board's
// own time and the tests spend none.

use rostransport
use rosret
use xrceframe
use xrcefrag
use xrcestream
use xrcewire

// What a UART supplies to this package: a byte out, a byte in, and a
// pause.
pub trait XrceUart[e]
    // Offer one byte to the transmitter.  Answers whether it took it;
    // a transmitter still busy with the byte before answers false and
    // the caller offers the byte again.
    fn uart_put(self, byte: Int) -> Bool [e]
    // The next received byte, 0 to 255, or -1 when none is waiting.
    fn uart_get(self) -> Int [e]
    // Wait about this many milliseconds.
    fn uart_pause_ms(self, ms: Int) [e]

// The board's console as an `XrceUart`.
//
// A `@value` with no fields: the UART is the board's, and the handle
// only names which implementation of the trait a program wants.
pub @value
struct ConsoleUart
    // Unused; a `@value` needs a field.
    unused: Int

// A handle to the board's console UART.
pub @tier(embedded)
@no_alloc
fn console_uart() -> ConsoleUart []
    ConsoleUart { unused: 0 }

impl XrceUart[hw] for ConsoleUart
    @tier(embedded)
    // cov: skip — a board's register write; the fake UART in the tests stands in for it
    fn uart_put(self, byte: Int) -> Bool [hw]
        hal.uart.try_write_byte(byte) == 0

    @tier(embedded)
    // cov: skip — a board's register read; the fake UART in the tests stands in for it
    fn uart_get(self) -> Int [hw]
        hal.uart.try_read_byte()

    @tier(embedded)
    // cov: skip — the board's timer; the fake UART in the tests stands in for it
    fn uart_pause_ms(self, ms: Int) [hw]
        hal.timer.delay_ms(ms)

// How many times a byte is offered to a busy transmitter before the
// frame is given up: 100000, which at the pause below is far longer than
// a byte takes at the slowest rate in use.
pub const ROS_UART_TX_TRIES = 100000

// Frame the message in `m` and send it, byte by byte.
//
// `f` is the caller's frame buffer, cleared and used here.  Answers
// whether every byte of the frame was taken by the transmitter: a byte
// refused `ROS_UART_TX_TRIES` times in a row stops the send and answers
// false.
pub @tier(embedded)
@no_alloc
fn send<U: XrceUart[e]>(u: U, var m: Vec[u8; 512], var f: Vec[u8; 1037]) -> Bool [e]
    f.clear()
    // A 512-byte payload always frames into 1037 bytes, so this is true.
    var ok = xrceframe.encode(var f, var m, xrceframe.XRCE_ADDR_CLIENT, xrceframe.XRCE_ADDR_AGENT)
    for i in 0..f.len()
        if ok
            var taken = false
            for _try in 0..ROS_UART_TX_TRIES
                if not taken and u.uart_put(f[i] as Int)
                    taken = true
                    break
            ok = taken
    ok

// Wait for one frame from the agent and copy its payload into `m`.
//
// `d` is the caller's de-framer, kept between calls so that a frame cut
// across two calls is not lost.  Polls the UART, one pause of 1 ms
// between rounds, for at most `timeout_ms` milliseconds; a timeout of 0
// takes what is already there.  Answers `XRCE_PUSH_FRAME` when a frame
// arrived, the error code of a frame that arrived damaged
// (`XRCE_PUSH_BAD_CRC`, `XRCE_PUSH_TOO_LONG`), or `XRCE_PUSH_NONE` when
// nothing whole came in time.
pub @tier(embedded)
@no_alloc
fn receive<U: XrceUart[e]>(u: U, var d: xrceframe.XrceDeframer, var m: Vec[u8; 512],
                           timeout_ms: Int) -> Int [e]
    var result = xrceframe.XRCE_PUSH_NONE
    for round in 0..timeout_ms + 1
        if result == xrceframe.XRCE_PUSH_NONE
            // Everything the receiver holds, up to a bound so that a
            // line that never stops cannot hold the caller.
            for _k in 0..2048
                if result == xrceframe.XRCE_PUSH_NONE
                    let b = u.uart_get()
                    if b >= 0
                        result = xrceframe.push_byte(var d, b)
            if result == xrceframe.XRCE_PUSH_NONE and round < timeout_ms
                u.uart_pause_ms(1)
    if result == xrceframe.XRCE_PUSH_FRAME
        m.clear()
        for i in 0..d.payload.len()
            let _ = m.push(d.payload[i])
    result

// An outcome from its three parts.
@tier(embedded)
@no_alloc
fn outcome(s: rostransport.RosSession, code: Int, status: Int) -> rostransport.RosOutcome []
    rostransport.RosOutcome { session: s, code: code, status: status }

// Open a session with the agent over the UART.
//
// Sends CREATE_CLIENT and waits up to `timeout_ms` for the agent's
// STATUS_AGENT.  Answers the session established, or closed when the
// bytes did not go out, nothing came back, or the agent's status was not
// OK.  One exchange and not a retry loop.
pub @tier(embedded)
@no_alloc
fn open<U: XrceUart[e]>(u: U, var d: xrceframe.XrceDeframer, var m: Vec[u8; 512],
                        var f: Vec[u8; 1037], s: rostransport.RosSession,
                        timeout_ms: Int) -> rostransport.RosSession [e]
    let closed = rostransport.session_with_state(s, rostransport.ROS_SESSION_CLOSED)
    let mtu = if s.mtu < 512
        s.mtu
    else
        512
    let _built = xrcewire.create_client(var m, s.client_key, mtu)
    if not send(u, var m, var f)
        return closed
    // An answer to an earlier request, which is not a STATUS_AGENT, is
    // read past; any STATUS_AGENT is the answer, since the agent
    // sends the same one to every CREATE_CLIENT.
    for _i in 0..rostransport.ROS_STALE_FRAMES
        if receive(u, var d, var m, timeout_ms) != xrceframe.XRCE_PUSH_FRAME
            return closed
        let reply = xrcewire.read_reply(var m)
        if reply.kind == xrcewire.XRCE_REPLY_STATUS_AGENT
            if xrcewire.status_is_ok(reply.status)
                return rostransport.session_established(s, xrcewire.XRCE_SESSION_ID)
            return closed
    closed

// Create one entity on the agent from an XML description, and wait for
// its status.
//
// The arguments are those of `rostransport.create_entity`, and so is
// the outcome: `ROS_RET_NOT_INIT` for a session not established,
// `ROS_RET_INVALID_ARGUMENT` when the message does not fit,
// `ROS_RET_AGENT_UNREACHABLE` when the bytes did not go out,
// `ROS_RET_TIMEOUT` when no status for this request came back, and
// `ROS_RET_ERROR` with the agent's number in `status` when it refused.
pub @tier(embedded)
@no_alloc
fn create<U: XrceUart[e]>(u: U, var d: xrceframe.XrceDeframer, var m: Vec[u8; 512],
                          var f: Vec[u8; 1037], s: rostransport.RosSession, object: Int, kind: Int,
                          parent: Int, xml: Str, timeout_ms: Int) -> rostransport.RosOutcome [e]
    if not rostransport.session_is_ready(s)
        return outcome(s, rosret.ROS_RET_NOT_INIT, 0 - 1)
    let request = s.next_request
    let sent = rostransport.session_wrote(rostransport.session_next_request(s))
    if not xrcewire.create_entity(var m, xrcewire.XRCE_STREAM_BEST_EFFORT, s.output_seq,
                                  request, object, kind, parent, xml,
                                  xrcewire.XRCE_CREATE_REPLACE)
        return outcome(s, rosret.ROS_RET_INVALID_ARGUMENT, 0 - 1)
    if not send(u, var m, var f)
        return outcome(s, rosret.ROS_RET_AGENT_UNREACHABLE, 0 - 1)
    // A frame that is not this request's status, an answer to an earlier
    // request that arrived late, is read past.
    for _i in 0..rostransport.ROS_STALE_FRAMES
        if receive(u, var d, var m, timeout_ms) != xrceframe.XRCE_PUSH_FRAME
            return outcome(sent, rosret.ROS_RET_TIMEOUT, 0 - 1)
        let reply = xrcewire.read_reply(var m)
        if reply.kind == xrcewire.XRCE_REPLY_STATUS and reply.request == request
            if xrcewire.status_is_ok(reply.status)
                return outcome(rostransport.session_heard(sent), rosret.ROS_RET_OK, reply.status)
            return outcome(rostransport.session_heard(sent), rosret.ROS_RET_ERROR, reply.status)
    outcome(sent, rosret.ROS_RET_TIMEOUT, 0 - 1)

// Publish one 32-bit integer to a data writer whose topic is
// std_msgs/msg/Int32.
//
// The sample is the four bytes of the number, least significant first:
// the CDR body of an Int32, without the representation header, which the
// agent writes itself.  Sent on the best-effort stream and not waited
// for.  The outcome's code is `ROS_RET_OK` when every byte of the frame
// went out, `ROS_RET_NOT_INIT` for a session not established, and
// `ROS_RET_AGENT_UNREACHABLE` when the transmitter refused.
pub @tier(embedded)
@no_alloc
fn publish_i32<U: XrceUart[e]>(u: U, var m: Vec[u8; 512], var f: Vec[u8; 1037],
                               s: rostransport.RosSession, writer: Int,
                               value: Int) -> rostransport.RosOutcome [e]
    if not rostransport.session_is_ready(s)
        return outcome(s, rosret.ROS_RET_NOT_INIT, 0 - 1)
    let request = s.next_request
    let sent = rostransport.session_wrote(rostransport.session_next_request(s))
    let _begun = xrcewire.begin_write_data(var m, xrcewire.XRCE_STREAM_BEST_EFFORT,
                                           s.output_seq, request, writer)
    let _put = xrcewire.put_sample_i32(var m, value)
    let _len = xrcewire.finish_write_data(var m)
    if not send(u, var m, var f)
        return outcome(s, rosret.ROS_RET_AGENT_UNREACHABLE, 0 - 1)
    outcome(sent, rosret.ROS_RET_OK, 0 - 1)

// Ping the agent if a heartbeat is due, and answer the session.
//
// `elapsed_ms` is how long since this was last called, and `wait_ms` how
// long to wait for the agent's answer. The silence accumulates first. A
// session that is not established is returned as it is; one silent past
// `ROS_SESSION_TIMEOUT_MS` becomes `ROS_SESSION_LOST`, and the node's
// loop then opens a session again; a silence shorter than
// `ROS_HEARTBEAT_MS` sends nothing. Otherwise a GET_INFO goes out and any
// INFO that comes back clears the silence. This is the only thing that
// notices an agent that was restarted: until it does, every publish
// answers `ROS_RET_OK` and arrives nowhere.
pub @tier(embedded)
@no_alloc
fn heartbeat<U: XrceUart[e]>(u: U, var d: xrceframe.XrceDeframer, var m: Vec[u8; 512],
                             var f: Vec[u8; 1037], s: rostransport.RosSession, elapsed_ms: Int,
                             wait_ms: Int) -> rostransport.RosSession [e]
    let waited = rostransport.session_silent(s, elapsed_ms)
    if not rostransport.session_is_ready(waited)
        return waited
    if rostransport.session_is_stale(waited, rostransport.ROS_SESSION_TIMEOUT_MS)
        return rostransport.session_with_state(waited, rostransport.ROS_SESSION_LOST)
    if waited.silent_ms < rostransport.ROS_HEARTBEAT_MS
        return waited
    let _built = xrcewire.ping(var m, waited.next_request)
    if not send(u, var m, var f)
        return waited
    if receive(u, var d, var m, wait_ms) != xrceframe.XRCE_PUSH_FRAME
        return waited
    if xrcewire.read_reply(var m).kind == xrcewire.XRCE_REPLY_INFO
        return rostransport.session_heard(rostransport.session_next_request(waited))
    waited

// ── Subscriptions and the reliable stream ────────────────────────────

// What `poll` took from the UART.
pub @value
struct RosPoll
    // The session after the call. Any message from the agent clears its
    // silence.
    session: rostransport.RosSession
    // The reliable stream after the call.
    stream: xrcestream.RelStream
    // `ROS_RET_OK` when `sample` was found; `ROS_RET_SUBSCRIPTION_TAKE_FAILED`
    // when no whole frame came in time or what came held no sample, which
    // is not an error; `ROS_RET_NOT_INIT` for a session that is not
    // established; `ROS_RET_ERROR` when the agent answered a request with
    // a status that is not OK, and `status` has the number.
    code: Int
    // The agent's status number when `code` is `ROS_RET_ERROR`, else -1.
    status: Int
    // The sample and where its bytes are in the caller's message buffer.
    sample: xrcewire.XrceSample

// A `RosPoll` that took no sample.
@tier(embedded)
@no_alloc
fn poll_none(s: rostransport.RosSession, r: xrcestream.RelStream, code: Int,
             status: Int) -> RosPoll []
    RosPoll { session: s, stream: r, code: code, status: status,
              sample: xrcewire.XrceSample { found: false, request: 0, object: 0, start: 0,
                                            length: 0 } }

// A `RosRelOutcome` from its parts.
@tier(embedded)
@no_alloc
fn rel_outcome(s: rostransport.RosSession, r: xrcestream.RelStream, code: Int,
               status: Int) -> rostransport.RosRelOutcome []
    rostransport.RosRelOutcome { session: s, stream: r, code: code, status: status }

// Ask the agent for samples from a data reader.
//
// The arguments are those of `rostransport.request_data`, and so is the
// outcome. Goes out on the best-effort stream and is not waited for.
pub @tier(embedded)
@no_alloc
fn request_data<U: XrceUart[e]>(u: U, var m: Vec[u8; 512], var f: Vec[u8; 1037],
                                s: rostransport.RosSession, reader: Int, data_stream: Int,
                                max_samples: Int) -> rostransport.RosOutcome [e]
    if not rostransport.session_is_ready(s)
        return outcome(s, rosret.ROS_RET_NOT_INIT, 0 - 1)
    let request = s.next_request
    let sent = rostransport.session_wrote(rostransport.session_next_request(s))
    let _built = xrcewire.read_data(var m, xrcewire.XRCE_STREAM_BEST_EFFORT, s.output_seq,
                                    request, reader, data_stream, max_samples)
    if not send(u, var m, var f)
        return outcome(s, rosret.ROS_RET_AGENT_UNREACHABLE, 0 - 1)
    outcome(sent, rosret.ROS_RET_OK, 0 - 1)

// Publish one 32-bit integer to a data writer on the reliable stream.
//
// The sample is the four bytes of the number, as for `publish_i32`. The
// message takes the next sequence number of the stream and a slot of the
// history `h`, which `xrcestream.history` makes, and stays there until the
// agent acknowledges it. The outcome's code is `ROS_RET_OK` when every byte
// of the frame went out, `ROS_RET_NOT_INIT` for a session not established,
// `ROS_RET_BAD_ALLOC` when `xrcestream.XRCE_HISTORY` messages are already
// unacknowledged, and `ROS_RET_AGENT_UNREACHABLE` when the transmitter
// refused; the sample is kept in that last case and goes out again when the
// agent asks for it.
pub @tier(embedded)
@no_alloc
fn publish_i32_reliable<U: XrceUart[e]>(u: U, var m: Vec[u8; 512], var f: Vec[u8; 1037],
                                        var h: Vec[u8; 2056], s: rostransport.RosSession,
                                        r: xrcestream.RelStream, writer: Int,
                                        value: Int) -> rostransport.RosRelOutcome [e]
    if not rostransport.session_is_ready(s)
        return rel_outcome(s, r, rosret.ROS_RET_NOT_INIT, 0 - 1)
    if not xrcestream.out_can_write(r)
        return rel_outcome(s, r, rosret.ROS_RET_BAD_ALLOC, 0 - 1)
    let request = s.next_request
    let sent = rostransport.session_next_request(s)
    let _begun = xrcewire.begin_write_data(var m, xrcewire.XRCE_STREAM_RELIABLE, r.out_next,
                                           request, writer)
    let _put = xrcewire.put_sample_i32(var m, value)
    let _len = xrcewire.finish_write_data(var m)
    let _kept = xrcestream.history_store(var h, r.out_next, var m)
    let after = xrcestream.out_wrote(r)
    if not send(u, var m, var f)
        return rel_outcome(sent, after, rosret.ROS_RET_AGENT_UNREACHABLE, 0 - 1)
    rel_outcome(sent, after, rosret.ROS_RET_OK, 0 - 1)

// Count `elapsed_ms` of quiet on the reliable stream, and send a HEARTBEAT
// if one is due.
//
// The arguments and the rule are those of `rostransport.reliable_tick`.
pub @tier(embedded)
@no_alloc
fn reliable_tick<U: XrceUart[e]>(u: U, var m: Vec[u8; 512], var f: Vec[u8; 1037],
                                 s: rostransport.RosSession, r: xrcestream.RelStream,
                                 elapsed_ms: Int) -> xrcestream.RelStream [e]
    let q = xrcestream.out_quiet(r, elapsed_ms)
    if not rostransport.session_is_ready(s) or not xrcestream.out_heartbeat_due(q)
        return q
    let _built = xrcewire.heartbeat(var m, q.out_first, xrcestream.out_last(q),
                                    xrcewire.XRCE_STREAM_RELIABLE)
    let _sent = send(u, var m, var f)
    xrcestream.out_heartbeat_sent(q)

// Count `elapsed_ms` of silence, and send a ping if the agent has been
// quiet long enough to be asked.
//
// The send-only half of `heartbeat`, for a program that calls `poll`; the
// rule is that of `rostransport.keepalive`.
pub @tier(embedded)
@no_alloc
fn keepalive<U: XrceUart[e]>(u: U, var m: Vec[u8; 512], var f: Vec[u8; 1037],
                             s: rostransport.RosSession, elapsed_ms: Int)
                             -> rostransport.RosSession [e]
    let waited = rostransport.session_silent(s, elapsed_ms)
    if not rostransport.session_is_ready(waited)
        return waited
    if rostransport.session_is_stale(waited, rostransport.ROS_SESSION_TIMEOUT_MS)
        return rostransport.session_with_state(waited, rostransport.ROS_SESSION_LOST)
    if waited.silent_ms < rostransport.ROS_HEARTBEAT_MS
        return waited
    let _built = xrcewire.ping(var m, waited.next_request)
    let _sent = send(u, var m, var f)
    rostransport.session_next_request(waited)

// Send what a received message asks of this side of the reliable stream: the
// ACKNACK for the input side, and the messages of the history that an
// ACKNACK from the agent names.
//
// The replies are built in a scratch message on the stack, so the message
// that was received is left as it is.
@tier(embedded)
@no_alloc
fn answer_stream<U: XrceUart[e]>(u: U, var f: Vec[u8; 1037], var h: Vec[u8; 2056],
                                 ev: xrcestream.RelEvent) [e]
    var a: Vec[u8; 512] = Vec.new()
    if ev.ack
        let _built = xrcewire.acknack(var a, xrcestream.in_first(ev.stream),
                                      xrcestream.in_bitmap(ev.stream),
                                      xrcewire.XRCE_STREAM_RELIABLE)
        let _sent = send(u, var a, var f)
    if ev.resend
        for j in 0..xrcestream.XRCE_ACKNACK_SPAN
            if xrcestream.out_resend(ev.stream, ev.resend_first, ev.resend_bitmap, j)
                let n = xrcestream.history_load(var h, xrcestream.seq_add(ev.resend_first, j),
                                                var a)
                if n > 0
                    let _again = send(u, var a, var f)

// Take the next frame from the agent and act on it.
//
// Waits up to `timeout_ms` for one frame, as `receive` does, leaves its
// message in `m` and runs it through `xrcestream.receive`. A sample
// delivered in order is `sample` in the result, its bytes at
// `m[sample.start]` for `sample.length` bytes; `xrcewire.sample_i32` reads
// a number out of them. A message on the reliable stream is acknowledged,
// whatever it held, a HEARTBEAT is answered with an ACKNACK, and an ACKNACK
// acknowledges what the node wrote and sends again the messages from the
// history `h` that its bitmap names. The replies are built in a scratch
// message on the stack, so `m` still holds the sample when the call
// returns. One frame per call.
pub @tier(embedded)
@no_alloc
fn poll<U: XrceUart[e]>(u: U, var d: xrceframe.XrceDeframer, var m: Vec[u8; 512],
                        var f: Vec[u8; 1037], var h: Vec[u8; 2056],
                        s: rostransport.RosSession, r: xrcestream.RelStream,
                        timeout_ms: Int) -> RosPoll [e]
    if not rostransport.session_is_ready(s)
        return poll_none(s, r, rosret.ROS_RET_NOT_INIT, 0 - 1)
    if receive(u, var d, var m, timeout_ms) != xrceframe.XRCE_PUSH_FRAME
        return poll_none(s, r, rosret.ROS_RET_SUBSCRIPTION_TAKE_FAILED, 0 - 1)
    let reply = xrcewire.read_reply(var m)
    let ev = xrcestream.receive(var m, r)
    let heard = rostransport.session_heard(s)
    answer_stream(u, var f, var h, ev)
    if ev.sample.found
        return RosPoll { session: heard, stream: ev.stream, code: rosret.ROS_RET_OK,
                         status: 0 - 1, sample: ev.sample }
    if reply.kind == xrcewire.XRCE_REPLY_STATUS and not xrcewire.status_is_ok(reply.status)
        return poll_none(heard, ev.stream, rosret.ROS_RET_ERROR, reply.status)
    poll_none(heard, ev.stream, rosret.ROS_RET_SUBSCRIPTION_TAKE_FAILED, 0 - 1)

// What `poll_long` took from the UART.
pub @value
struct RosLongPoll
    // The session after the call. Any message from the agent clears its
    // silence.
    session: rostransport.RosSession
    // The reliable stream after the call.
    stream: xrcestream.RelStream
    // The reassembly after the call; pass it to the next `poll_long`.
    assembly: xrcefrag.FragState
    // `ROS_RET_OK` when `sample` was found, whole or joined from pieces;
    // `ROS_RET_SUBSCRIPTION_TAKE_FAILED` when no whole frame came in time, or
    // what came was a piece of a sample not yet whole, or held no sample,
    // which is not an error; `ROS_RET_BAD_ALLOC` when a sample is longer than
    // the reassembly allows and was dropped; `ROS_RET_NOT_INIT` for a session
    // that is not established; `ROS_RET_ERROR` when the agent answered a
    // request with a status that is not OK, and `status` has the number.
    code: Int
    // The agent's status number when `code` is `ROS_RET_ERROR`, else -1.
    status: Int
    // The sample. Its bytes are `a[0]` to `a[sample.length - 1]` of the
    // caller's reassembly buffer, whether the agent sent it in one message
    // or in pieces; `sample.start` is 0.
    sample: xrcewire.XrceSample

// A `RosLongPoll` that took no sample.
@tier(embedded)
@no_alloc
fn long_none(s: rostransport.RosSession, r: xrcestream.RelStream, state: xrcefrag.FragState,
             code: Int, status: Int) -> RosLongPoll []
    RosLongPoll { session: s, stream: r, assembly: state, code: code, status: status,
                  sample: xrcewire.XrceSample { found: false, request: 0, object: 0, start: 0,
                                                length: 0 } }

// Take the next frame from the agent and act on it, joining a sample the
// agent sent in pieces.
//
// `poll` for samples longer than one message, with the rule of
// `rostransport.poll_long`: the samples are asked for on the reliable
// stream, `a` is the buffer the pieces are joined in, and `state`, from
// `xrcefrag.reassembly`, says how large a sample it will take. The caller keeps
// `a` and passes the `assembly` of the result to the next call. A sample that
// is whole is left in `a`, from its first byte, until the next call. `m`
// holds the last frame, as it does after `poll`. One frame per call.
pub @tier(embedded)
@no_alloc
fn poll_long<U: XrceUart[e]>(u: U, var d: xrceframe.XrceDeframer, var m: Vec[u8; 512],
                             var f: Vec[u8; 1037], var h: Vec[u8; 2056],
                             var a: Vec[u8; 2048], s: rostransport.RosSession,
                             r: xrcestream.RelStream, state: xrcefrag.FragState,
                             timeout_ms: Int) -> RosLongPoll [e]
    let st = xrcefrag.begin(state, var a)
    if not rostransport.session_is_ready(s)
        return long_none(s, r, st, rosret.ROS_RET_NOT_INIT, 0 - 1)
    if receive(u, var d, var m, timeout_ms) != xrceframe.XRCE_PUSH_FRAME
        return long_none(s, r, st, rosret.ROS_RET_SUBSCRIPTION_TAKE_FAILED, 0 - 1)
    let reply = xrcewire.read_reply(var m)
    let ev = xrcestream.receive(var m, r)
    let heard = rostransport.session_heard(s)
    // A sample in one frame, or a piece of one, is joined before anything
    // else is built; the replies use a scratch message.
    var joined = xrcefrag.event(st, xrcefrag.FRAG_NONE)
    if ev.sample.found
        joined = xrcefrag.keep_sample(var m, ev.sample, st, var a)
    else if xrcestream.delivers(var m, r)
        joined = xrcefrag.push(var m, st, var a)
    answer_stream(u, var f, var h, ev)
    if joined.code == xrcefrag.FRAG_DONE
        return RosLongPoll { session: heard, stream: ev.stream, assembly: joined.assembly,
                             code: rosret.ROS_RET_OK, status: 0 - 1, sample: joined.sample }
    if joined.code == xrcefrag.FRAG_TOO_LONG
        return long_none(heard, ev.stream, joined.assembly, rosret.ROS_RET_BAD_ALLOC, 0 - 1)
    if reply.kind == xrcewire.XRCE_REPLY_STATUS and not xrcewire.status_is_ok(reply.status)
        return long_none(heard, ev.stream, joined.assembly, rosret.ROS_RET_ERROR, reply.status)
    long_none(heard, ev.stream, joined.assembly, rosret.ROS_RET_SUBSCRIPTION_TAKE_FAILED, 0 - 1)

// ── Services ─────────────────────────────────────────────────────────

// Create a requester, a service client, and wait for its status.
//
// The arguments and the outcome are those of `create` with the kind fixed:
// `requester` is the new entity's id (`xrcewire.object_id(n,
// xrcewire.XRCE_KIND_REQUESTER)`), `participant` the id of its participant and
// `xml` its description (see `xrcewire.create_requester`).
pub @tier(embedded)
@no_alloc
fn create_requester<U: XrceUart[e]>(u: U, var d: xrceframe.XrceDeframer, var m: Vec[u8; 512],
                                    var f: Vec[u8; 1037], s: rostransport.RosSession,
                                    requester: Int, participant: Int, xml: Str,
                                    timeout_ms: Int) -> rostransport.RosOutcome [e]
    create(u, var d, var m, var f, s, requester, xrcewire.XRCE_KIND_REQUESTER, participant, xml,
           timeout_ms)

// Create a replier, a service server, and wait for its status.
//
// The arguments and the outcome are those of `create_requester`, with the kind
// `xrcewire.XRCE_KIND_REPLIER`.
pub @tier(embedded)
@no_alloc
fn create_replier<U: XrceUart[e]>(u: U, var d: xrceframe.XrceDeframer, var m: Vec[u8; 512],
                                  var f: Vec[u8; 1037], s: rostransport.RosSession,
                                  replier: Int, participant: Int, xml: Str,
                                  timeout_ms: Int) -> rostransport.RosOutcome [e]
    create(u, var d, var m, var f, s, replier, xrcewire.XRCE_KIND_REPLIER, participant, xml,
           timeout_ms)

// What `send_request` did.
pub @value
struct RosCall
    // The session after the call.
    session: rostransport.RosSession
    // The reliable stream after the call.
    stream: xrcestream.RelStream
    // The codes of `publish_i32_reliable`: `ROS_RET_OK`, `ROS_RET_NOT_INIT`,
    // `ROS_RET_BAD_ALLOC` for a full history, `ROS_RET_INVALID_ARGUMENT` for a
    // request that does not fit and `ROS_RET_AGENT_UNREACHABLE` when the
    // transmitter refused.
    code: Int
    // The id of the request, which the agent's reply quotes back; 0 when
    // nothing was written.
    request: Int

// A `RosCall` that wrote nothing.
@tier(embedded)
@no_alloc
fn call_none(s: rostransport.RosSession, r: xrcestream.RelStream, code: Int) -> RosCall []
    RosCall { session: s, stream: r, code: code, request: 0 }

// Send the request in `payload` to a requester.
//
// `payload` holds the request in CDR without the representation header, from
// its first byte (`xrcewire.put_sample_i64(var payload, v, 0)` and its kind
// build one); the caller's `m` is the scratch the message is built in. The
// request goes out on the reliable stream and stays in the history `h` until
// the agent acknowledges it. The outcome's `request` is the id the reply
// carries, and `take_reply` reads the reply.
pub @tier(embedded)
@no_alloc
fn send_request<U: XrceUart[e]>(u: U, var m: Vec[u8; 512], var f: Vec[u8; 1037],
                                var h: Vec[u8; 2056], s: rostransport.RosSession,
                                r: xrcestream.RelStream, requester: Int,
                                var payload: Vec[u8; 512]) -> RosCall [e]
    if not rostransport.session_is_ready(s)
        return call_none(s, r, rosret.ROS_RET_NOT_INIT)
    if not xrcestream.out_can_write(r)
        return call_none(s, r, rosret.ROS_RET_BAD_ALLOC)
    let request = s.next_request
    let sent = rostransport.session_next_request(s)
    var ok = xrcewire.begin_write_data(var m, xrcewire.XRCE_STREAM_RELIABLE, r.out_next, request,
                                       requester)
    for i in 0..payload.len()
        ok = ok and xrcewire.put_sample_byte(var m, payload[i] as Int)
    if not ok
        return call_none(s, r, rosret.ROS_RET_INVALID_ARGUMENT)
    let _len = xrcewire.finish_write_data(var m)
    let _kept = xrcestream.history_store(var h, r.out_next, var m)
    let after = xrcestream.out_wrote(r)
    if not send(u, var m, var f)
        return RosCall { session: sent, stream: after,
                         code: rosret.ROS_RET_AGENT_UNREACHABLE, request: request }
    RosCall { session: sent, stream: after, code: rosret.ROS_RET_OK, request: request }

// Send the reply to a request.
//
// `identity` is the one `take_request` gave with the request and `payload` holds
// the reply in CDR without the representation header, as for `send_request`;
// `m` is the scratch the message is built in, so a request that was left in it
// is read before this is called. The outcome and the history are those of
// `publish_i32_reliable`.
pub @tier(embedded)
@no_alloc
fn send_reply<U: XrceUart[e]>(u: U, var m: Vec[u8; 512], var f: Vec[u8; 1037],
                              var h: Vec[u8; 2056], s: rostransport.RosSession,
                              r: xrcestream.RelStream, replier: Int,
                              identity: xrcewire.XrceIdentity,
                              var payload: Vec[u8; 512]) -> rostransport.RosRelOutcome [e]
    if not rostransport.session_is_ready(s)
        return rel_outcome(s, r, rosret.ROS_RET_NOT_INIT, 0 - 1)
    if not xrcestream.out_can_write(r)
        return rel_outcome(s, r, rosret.ROS_RET_BAD_ALLOC, 0 - 1)
    let request = s.next_request
    let sent = rostransport.session_next_request(s)
    var ok = xrcewire.begin_write_reply(var m, xrcewire.XRCE_STREAM_RELIABLE, r.out_next, request,
                                        replier, identity)
    for i in 0..payload.len()
        ok = ok and xrcewire.put_sample_byte(var m, payload[i] as Int)
    if not ok
        return rel_outcome(s, r, rosret.ROS_RET_INVALID_ARGUMENT, 0 - 1)
    let _len = xrcewire.finish_write_data(var m)
    let _kept = xrcestream.history_store(var h, r.out_next, var m)
    let after = xrcestream.out_wrote(r)
    if not send(u, var m, var f)
        return rel_outcome(sent, after, rosret.ROS_RET_AGENT_UNREACHABLE, 0 - 1)
    rel_outcome(sent, after, rosret.ROS_RET_OK, 0 - 1)

// What `take_reply` took from the UART.
pub @value
struct RosReplyPoll
    // The session after the call. Any message from the agent clears its
    // silence.
    session: rostransport.RosSession
    // The reliable stream after the call.
    stream: xrcestream.RelStream
    // `ROS_RET_OK` when `reply` was found; `ROS_RET_CLIENT_TAKE_FAILED` when no
    // whole frame came in time or what came held no reply, which is not an
    // error; `ROS_RET_NOT_INIT` for a session that is not established;
    // `ROS_RET_ERROR` when the agent refused a request, and `status` has the
    // number. A sample of another entity, a data reader's, is answered as
    // `ROS_RET_CLIENT_TAKE_FAILED` with `sample` found and still in `m`, for
    // the caller to read as `poll` leaves it.
    code: Int
    // The agent's status number when `code` is `ROS_RET_ERROR`, else -1.
    status: Int
    // The sample the frame held, found or not, and where its bytes are in the
    // caller's message buffer; `sample.object` is the entity it belongs to.
    sample: xrcewire.XrceSample
    // The reply, and where its bytes are in the caller's message buffer.
    reply: xrcewire.XrceResponse

// Take the next frame from the agent and, if it is a reply, read it.
//
// `poll` with the sample read as a service client reads it. The reply's bytes
// are `m[reply.start]` for `reply.length` bytes, and `reply.request` is the id
// of the call it answers (`send_request`'s `request`). One frame per call.
pub @tier(embedded)
@no_alloc
fn take_reply<U: XrceUart[e]>(u: U, var d: xrceframe.XrceDeframer, var m: Vec[u8; 512],
                              var f: Vec[u8; 1037], var h: Vec[u8; 2056],
                              s: rostransport.RosSession, r: xrcestream.RelStream,
                              timeout_ms: Int) -> RosReplyPoll [e]
    let got = poll(u, var d, var m, var f, var h, s, r, timeout_ms)
    let reply = xrcewire.response_of(var m, got.sample)
    if reply.found
        return RosReplyPoll { session: got.session, stream: got.stream,
                              code: rosret.ROS_RET_OK, status: 0 - 1, sample: got.sample,
                              reply: reply }
    var code = got.code
    if code == rosret.ROS_RET_SUBSCRIPTION_TAKE_FAILED or code == rosret.ROS_RET_OK
        code = rosret.ROS_RET_CLIENT_TAKE_FAILED
    RosReplyPoll { session: got.session, stream: got.stream, code: code, status: got.status,
                   sample: got.sample, reply: reply }

// What `take_request` took from the UART.
pub @value
struct RosRequestPoll
    // The session after the call. Any message from the agent clears its
    // silence.
    session: rostransport.RosSession
    // The reliable stream after the call.
    stream: xrcestream.RelStream
    // `ROS_RET_OK` when `request` was found; `ROS_RET_SERVICE_TAKE_FAILED` when
    // no whole frame came in time or what came held no request, which is not
    // an error; `ROS_RET_NOT_INIT` for a session that is not established;
    // `ROS_RET_ERROR` when the agent refused a request, and `status` has the
    // number. A sample of another entity is answered as
    // `ROS_RET_SERVICE_TAKE_FAILED` with `sample` found and still in `m`, for
    // the caller to read as `poll` leaves it.
    code: Int
    // The agent's status number when `code` is `ROS_RET_ERROR`, else -1.
    status: Int
    // The sample the frame held, found or not, and where its bytes are in the
    // caller's message buffer; `sample.object` is the entity it belongs to.
    sample: xrcewire.XrceSample
    // The request, its identity, and where its bytes are in the caller's
    // message buffer.
    request: xrcewire.XrceRequest

// Take the next frame from the agent and, if it is a request, read it.
//
// `poll` with the sample read as a service server reads it. The request's bytes
// are `m[request.start]` for `request.length` bytes, and `request.identity`
// goes to `send_reply`. One frame per call.
pub @tier(embedded)
@no_alloc
fn take_request<U: XrceUart[e]>(u: U, var d: xrceframe.XrceDeframer, var m: Vec[u8; 512],
                                var f: Vec[u8; 1037], var h: Vec[u8; 2056],
                                s: rostransport.RosSession, r: xrcestream.RelStream,
                                timeout_ms: Int) -> RosRequestPoll [e]
    let got = poll(u, var d, var m, var f, var h, s, r, timeout_ms)
    let request = xrcewire.request_of(var m, got.sample)
    if request.found
        return RosRequestPoll { session: got.session, stream: got.stream,
                                code: rosret.ROS_RET_OK, status: 0 - 1,
                                sample: got.sample, request: request }
    var code = got.code
    if code == rosret.ROS_RET_SUBSCRIPTION_TAKE_FAILED or code == rosret.ROS_RET_OK
        code = rosret.ROS_RET_SERVICE_TAKE_FAILED
    RosRequestPoll { session: got.session, stream: got.stream, code: code, status: got.status,
                     sample: got.sample, request: request }

// ── Samples longer than one message ──────────────────────────────────

// Write the bytes of `payload` from `at` on as pieces of a WRITE_DATA, as many
// as the history has room for.
//
// The rules are those of `rostransport.write_in_pieces`. The sample is the
// caller's `Vec[u8; 2048]`, which holds `xrcefrag.XRCE_LONG_MAX_SAMPLE` bytes
// and so cannot be longer than the largest sample; `m` is the scratch each
// message is built in, and `f` the frame.
@tier(embedded)
@no_alloc
fn write_in_pieces<U: XrceUart[e]>(u: U, var m: Vec[u8; 512], var f: Vec[u8; 1037],
                                   var h: Vec[u8; 2056], s: rostransport.RosSession,
                                   r: xrcestream.RelStream, object: Int, reply: Bool,
                                   identity: xrcewire.XrceIdentity, var payload: Vec[u8; 2048],
                                   at: Int) -> rostransport.RosLongSent [e]
    let length = payload.len()
    if not rostransport.session_is_ready(s)
        return rostransport.long_sent(s, r, rosret.ROS_RET_NOT_INIT, at, length, 0)
    if at < 0 or at > length
        return rostransport.long_sent(s, r, rosret.ROS_RET_INVALID_ARGUMENT, at, length, 0)
    var front = xrcewire.XRCE_SAMPLE_START
    if reply
        front = xrcewire.XRCE_REPLY_START
    if at == 0 and front + length <= 512
        // One message, built as `send_request` and `send_reply` build it.
        if not xrcestream.out_can_write(r)
            return rostransport.long_sent(s, r, rosret.ROS_RET_BAD_ALLOC, 0, length, 0)
        let request = s.next_request
        let sent = rostransport.session_next_request(s)
        if reply
            let _begun = xrcewire.begin_write_reply(var m, xrcewire.XRCE_STREAM_RELIABLE,
                                                    r.out_next, request, object, identity)
        else
            let _begun = xrcewire.begin_write_data(var m, xrcewire.XRCE_STREAM_RELIABLE,
                                                   r.out_next, request, object)
        for i in 0..length
            let _put = xrcewire.put_sample_byte(var m, payload[i] as Int)
        let _len = xrcewire.finish_write_data(var m)
        let _kept = xrcestream.history_store(var h, r.out_next, var m)
        let after = xrcestream.out_wrote(r)
        if not send(u, var m, var f)
            return rostransport.long_sent(sent, after, rosret.ROS_RET_AGENT_UNREACHABLE, length,
                                          length, request)
        return rostransport.long_sent(sent, after, rosret.ROS_RET_OK, length, length, request)
    var sess = s
    var st = r
    var pos = at
    var request = 0
    var code = rosret.ROS_RET_OK
    if pos < length and not xrcestream.out_can_write(st)
        code = rosret.ROS_RET_BAD_ALLOC
    for _p in 0..xrcestream.XRCE_HISTORY
        if code == rosret.ROS_RET_OK and pos < length and xrcestream.out_can_write(st)
            let id = sess.next_request
            let _begun = xrcefrag.piece_begin(var m, st.out_next, pos, length, id, object, reply,
                                              identity)
            var n = length - pos
            if n > xrcefrag.piece_room(var m)
                n = xrcefrag.piece_room(var m)
            for i in 0..n
                let _put = xrcewire.put_sample_byte(var m, payload[pos + i] as Int)
            if pos == 0
                sess = rostransport.session_next_request(sess)
                request = id
            pos = pos + n
            let _len = xrcewire.finish_fragment(var m, pos == length)
            let _kept = xrcestream.history_store(var h, st.out_next, var m)
            st = xrcestream.out_wrote(st)
            if not send(u, var m, var f)
                code = rosret.ROS_RET_AGENT_UNREACHABLE
    rostransport.long_sent(sess, st, code, pos, length, request)

// Write one sample to a data writer on the reliable stream, in pieces if it
// does not fit one message.
//
// `payload` holds the sample in CDR without the representation header, from its
// first byte, and `at` is 0 for the first call; `m` is the scratch each message
// is built in. The rules and the outcome are those of
// `rostransport.write_sample_long`: a sample of up to 500 bytes is one message,
// a longer one goes out as FRAGMENT submessages kept in the history `h`, a call
// writes at most `xrcestream.XRCE_HISTORY` of them, and the caller polls and
// calls again with the outcome's `at` until `done`. The 2,056 bytes of `payload`
// are the cost of a node that writes long samples; a node that also joins them
// can pass its reassembly buffer, once it has read what it joined.
pub @tier(embedded)
@no_alloc
fn write_sample_long<U: XrceUart[e]>(u: U, var m: Vec[u8; 512], var f: Vec[u8; 1037],
                                     var h: Vec[u8; 2056], s: rostransport.RosSession,
                                     r: xrcestream.RelStream, writer: Int,
                                     var payload: Vec[u8; 2048],
                                     at: Int) -> rostransport.RosLongSent [e]
    write_in_pieces(u, var m, var f, var h, s, r, writer, false, xrcewire.no_identity(),
                    var payload, at)

// Send a request to a requester, in pieces if it does not fit one message.
//
// `send_request` for a request of up to 2,048 bytes, with the rules of
// `write_sample_long`. The outcome's `request` is the id the reply quotes, set by
// the call that wrote the first piece.
pub @tier(embedded)
@no_alloc
fn send_request_long<U: XrceUart[e]>(u: U, var m: Vec[u8; 512], var f: Vec[u8; 1037],
                                     var h: Vec[u8; 2056], s: rostransport.RosSession,
                                     r: xrcestream.RelStream, requester: Int,
                                     var payload: Vec[u8; 2048],
                                     at: Int) -> rostransport.RosLongSent [e]
    write_in_pieces(u, var m, var f, var h, s, r, requester, false, xrcewire.no_identity(),
                    var payload, at)

// Send the reply to a request, in pieces if it does not fit one message.
//
// `send_reply` for a reply of up to 2,048 bytes, with the rules of
// `write_sample_long`; the sample identity of the request goes in the first
// piece, in front of the reply's bytes.
pub @tier(embedded)
@no_alloc
fn send_reply_long<U: XrceUart[e]>(u: U, var m: Vec[u8; 512], var f: Vec[u8; 1037],
                                   var h: Vec[u8; 2056], s: rostransport.RosSession,
                                   r: xrcestream.RelStream, replier: Int,
                                   identity: xrcewire.XrceIdentity,
                                   var payload: Vec[u8; 2048],
                                   at: Int) -> rostransport.RosLongSent [e]
    write_in_pieces(u, var m, var f, var h, s, r, replier, true, identity, var payload, at)

// What `take_reply_long` took from the UART.
pub @value
struct RosLongReplyPoll
    // The session after the call. Any message from the agent clears its
    // silence.
    session: rostransport.RosSession
    // The reliable stream after the call.
    stream: xrcestream.RelStream
    // The reassembly after the call; pass it to the next call.
    assembly: xrcefrag.FragState
    // As for `RosReplyPoll`, and `ROS_RET_BAD_ALLOC` for a reply longer than the
    // reassembly allows, which was dropped.
    code: Int
    // The agent's status number when `code` is `ROS_RET_ERROR`, else -1.
    status: Int
    // The sample the call completed, found or not; its bytes are `a[0]` to
    // `a[sample.length - 1]` of the caller's reassembly buffer, and
    // `sample.object` is the entity it belongs to.
    sample: xrcewire.XrceSample
    // The reply, and where its bytes are in the reassembly buffer.
    reply: xrcewire.XrceResponse

// Take the next frame from the agent and, if it completes a reply, read it.
//
// `take_reply` over `poll_long`: a reply the agent sent in pieces is joined in
// `a`, which the caller keeps between calls with the `assembly` of the result.
// The reply's bytes are `a[reply.start]` for `reply.length` bytes, and
// `reply.request` is the id of the call it answers. A call that took a piece
// answers `ROS_RET_CLIENT_TAKE_FAILED`. `m` is scratch: it holds the first
// bytes of the sample when the call returns, which is where
// `xrcewire.response_of` reads the request id.
pub @tier(embedded)
@no_alloc
fn take_reply_long<U: XrceUart[e]>(u: U, var d: xrceframe.XrceDeframer, var m: Vec[u8; 512],
                                   var f: Vec[u8; 1037], var h: Vec[u8; 2056],
                                   var a: Vec[u8; 2048], s: rostransport.RosSession,
                                   r: xrcestream.RelStream, state: xrcefrag.FragState,
                                   timeout_ms: Int) -> RosLongReplyPoll [e]
    let got = poll_long(u, var d, var m, var f, var h, var a, s, r, state, timeout_ms)
    let _head = xrcefrag.copy_head(var a, var m, 4)
    let reply = xrcewire.response_of(var m, got.sample)
    if reply.found
        return RosLongReplyPoll { session: got.session, stream: got.stream,
                                  assembly: got.assembly, code: rosret.ROS_RET_OK, status: 0 - 1,
                                  sample: got.sample, reply: reply }
    var code = got.code
    if code == rosret.ROS_RET_SUBSCRIPTION_TAKE_FAILED or code == rosret.ROS_RET_OK
        code = rosret.ROS_RET_CLIENT_TAKE_FAILED
    RosLongReplyPoll { session: got.session, stream: got.stream, assembly: got.assembly,
                       code: code, status: got.status, sample: got.sample, reply: reply }

// What `take_request_long` took from the UART.
pub @value
struct RosLongRequestPoll
    // The session after the call. Any message from the agent clears its
    // silence.
    session: rostransport.RosSession
    // The reliable stream after the call.
    stream: xrcestream.RelStream
    // The reassembly after the call; pass it to the next call.
    assembly: xrcefrag.FragState
    // As for `RosRequestPoll`, and `ROS_RET_BAD_ALLOC` for a request longer than
    // the reassembly allows, which was dropped.
    code: Int
    // The agent's status number when `code` is `ROS_RET_ERROR`, else -1.
    status: Int
    // The sample the call completed, found or not; its bytes are `a[0]` to
    // `a[sample.length - 1]` of the caller's reassembly buffer, and
    // `sample.object` is the entity it belongs to.
    sample: xrcewire.XrceSample
    // The request, its identity, and where its bytes are in the reassembly
    // buffer.
    request: xrcewire.XrceRequest

// Take the next frame from the agent and, if it completes a request, read it.
//
// `take_request` over `poll_long`, with the rules of `take_reply_long`. The
// request's bytes are `a[request.start]` for `request.length` bytes, and
// `request.identity` goes to `send_reply_long`.
pub @tier(embedded)
@no_alloc
fn take_request_long<U: XrceUart[e]>(u: U, var d: xrceframe.XrceDeframer, var m: Vec[u8; 512],
                                     var f: Vec[u8; 1037], var h: Vec[u8; 2056],
                                     var a: Vec[u8; 2048], s: rostransport.RosSession,
                                     r: xrcestream.RelStream, state: xrcefrag.FragState,
                                     timeout_ms: Int) -> RosLongRequestPoll [e]
    let got = poll_long(u, var d, var m, var f, var h, var a, s, r, state, timeout_ms)
    let _head = xrcefrag.copy_head(var a, var m, xrcewire.XRCE_IDENTITY_BYTES)
    let request = xrcewire.request_of(var m, got.sample)
    if request.found
        return RosLongRequestPoll { session: got.session, stream: got.stream,
                                    assembly: got.assembly, code: rosret.ROS_RET_OK,
                                    status: 0 - 1, sample: got.sample, request: request }
    var code = got.code
    if code == rosret.ROS_RET_SUBSCRIPTION_TAKE_FAILED or code == rosret.ROS_RET_OK
        code = rosret.ROS_RET_SERVICE_TAKE_FAILED
    RosLongRequestPoll { session: got.session, stream: got.stream, assembly: got.assembly,
                         code: code, status: got.status, sample: got.sample, request: request }
