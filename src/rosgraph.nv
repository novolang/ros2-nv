// rosgraph.nv — how many of each thing a node may have, counted
// against a table that was fixed before the program started.
//
// `[]` THROUGHOUT and `@tier(embedded)` on all of it.  Everything here
// is a count.
//
// THERE IS NO ALLOCATOR BEHIND A MICRO-ROS NODE.  On a workstation
// `rcl_publisher_init` allocates, and a program that creates a
// forty-first publisher gets a forty-first publisher.  Under
// rmw_microxrcedds the entity pools are arrays sized at COMPILE TIME —
// the maxima are set in the firmware's build configuration — and
// creating one past the end fails at run time, on a part whose only
// output is a serial line, with a return code that says an allocation
// failed.
//
// AND THE DEFAULTS ARE ONE OF EACH.  A stock micro-ROS build allows one
// node, one publisher, one subscription, one service and one client,
// and the first thing anybody writing a second publisher discovers is
// that the second one does not exist.  `default_pool` is those numbers,
// published rather than described, so a program can compare what it
// intends to create against what its firmware was built to hold — at
// startup, in one call, before the failure.
//
// A POOL IS A VALUE AND ADDING TO IT ANSWERS A NEW ONE.  Nothing here
// holds a name or a handle: those live wherever the program keeps them.
// What this module owns is the arithmetic that says whether the next
// entity fits.

use rosqos
use rosret

// ── The kinds of entity ──────────────────────────────────────────────

// A node.
pub const ROS_ENTITY_NODE = 0
// A publisher.
pub const ROS_ENTITY_PUBLISHER = 1
// A subscription.
pub const ROS_ENTITY_SUBSCRIPTION = 2
// A service server.
pub const ROS_ENTITY_SERVICE = 3
// A service client.
pub const ROS_ENTITY_CLIENT = 4
// A timer.  Not an entity the middleware holds — a timer is the
// client library's own — but it occupies an executor handle, which is
// the other table that runs out.
pub const ROS_ENTITY_TIMER = 5
// A guard condition, which is how something outside the wait set wakes
// it.
pub const ROS_ENTITY_GUARD = 6

// How many kinds there are: 7.
pub const ROS_ENTITY_KINDS = 7

// ── The pool ─────────────────────────────────────────────────────────

// What the firmware was built to hold, and what has been taken.
pub @value
struct RosGraph
    // The compile-time maxima.
    max_nodes: Int
    max_publishers: Int
    max_subscriptions: Int
    max_services: Int
    max_clients: Int
    // How many messages the middleware keeps per endpoint.  Not an
    // entity count: it is the other compile-time number, and a profile
    // asking to keep ten messages against a firmware built to hold four
    // keeps four.
    max_history: Int
    // What has been created so far.
    nodes: Int
    publishers: Int
    subscriptions: Int
    services: Int
    clients: Int

// The pool a stock micro-ROS build gives: one of everything, and four
// messages of history.
//
// The numbers a program most needs to see before it hits them.
//
// ```novo
// use rosgraph
//
// fn main() [io]
//     println("${rosgraph.default_pool().max_publishers}")   // 1
// ```
pub @tier(embedded)
fn default_pool() -> RosGraph []
    RosGraph {
        max_nodes: 1,
        max_publishers: 1,
        max_subscriptions: 1,
        max_services: 1,
        max_clients: 1,
        max_history: 4,
        nodes: 0,
        publishers: 0,
        subscriptions: 0,
        services: 0,
        clients: 0 }

// A pool from the maxima a firmware was built with.
pub @tier(embedded)
fn pool(max_nodes: Int, max_publishers: Int, max_subscriptions: Int, max_services: Int,
        max_clients: Int, max_history: Int) -> RosGraph []
    RosGraph {
        max_nodes: max_nodes,
        max_publishers: max_publishers,
        max_subscriptions: max_subscriptions,
        max_services: max_services,
        max_clients: max_clients,
        max_history: max_history,
        nodes: 0,
        publishers: 0,
        subscriptions: 0,
        services: 0,
        clients: 0 }

// The maximum for one kind of entity, or -1 for a kind the middleware
// does not pool.
//
// Timers and guard conditions answer -1: they cost an executor handle
// and not a middleware entity, and `rosexec` is where they are counted.
pub @tier(embedded)
fn capacity_of(g: RosGraph, kind: Int) -> Int []
    // A kind the firmware does not pool has no maximum, and -1 says so.
    match kind
        ROS_ENTITY_NODE         => g.max_nodes
        ROS_ENTITY_PUBLISHER    => g.max_publishers
        ROS_ENTITY_SUBSCRIPTION => g.max_subscriptions
        ROS_ENTITY_SERVICE      => g.max_services
        ROS_ENTITY_CLIENT       => g.max_clients
        // A timer and a guard condition cost an executor handle and not
        // a middleware entity, and `rosexec` is where they are counted.
        _                       => -1

// How many of one kind have been created.
pub @tier(embedded)
fn used_of(g: RosGraph, kind: Int) -> Int []
    // The same five kinds `capacity_of` answers a maximum for.  A kind
    // the pool does not hold has nothing created either, which is the
    // same -1.
    match kind
        ROS_ENTITY_NODE         => g.nodes
        ROS_ENTITY_PUBLISHER    => g.publishers
        ROS_ENTITY_SUBSCRIPTION => g.subscriptions
        ROS_ENTITY_SERVICE      => g.services
        ROS_ENTITY_CLIENT       => g.clients
        _                       => -1

// How many more of one kind will fit.
pub @tier(embedded)
fn remaining(g: RosGraph, kind: Int) -> Int []
    // A kind the middleware does not pool answers -1 for both its
    // maximum and its count, and the subtraction leaves the 0 that says
    // no more will fit.
    capacity_of(g, kind) - used_of(g, kind)

// Whether one more of this kind fits.
//
// The question to ask before creating anything, because the answer
// afterwards is a return code on a device with no console.
pub @tier(embedded)
fn can_add(g: RosGraph, kind: Int) -> Bool []
    remaining(g, kind) > 0

// The pool with one kind's count moved by `delta`.
//
// `add` and `remove` are the only callers, and this is the one place
// that spells the eleven fields out.  A `@value` struct is replaced
// whole, so the count that moves is named beside the four that do not.
// It carries the tier because an unannotated function is `app`, and an
// embedded caller cannot reach one above it.
@tier(embedded)
fn counts_moved(g: RosGraph, kind: Int, delta: Int) -> RosGraph
    var nodes = g.nodes
    var publishers = g.publishers
    var subscriptions = g.subscriptions
    var services = g.services
    var clients = g.clients
    if kind == ROS_ENTITY_NODE
        nodes = nodes + delta
    elif kind == ROS_ENTITY_PUBLISHER
        publishers = publishers + delta
    elif kind == ROS_ENTITY_SUBSCRIPTION
        subscriptions = subscriptions + delta
    elif kind == ROS_ENTITY_SERVICE
        services = services + delta
    elif kind == ROS_ENTITY_CLIENT
        clients = clients + delta
    // A timer, a guard condition and a kind this package does not know
    // are not counted by this pool at all, and move nothing.
    RosGraph {
        max_nodes: g.max_nodes,
        max_publishers: g.max_publishers,
        max_subscriptions: g.max_subscriptions,
        max_services: g.max_services,
        max_clients: g.max_clients,
        max_history: g.max_history,
        nodes: nodes,
        publishers: publishers,
        subscriptions: subscriptions,
        services: services,
        clients: clients }

// The pool with one more of this kind taken.
//
// UNCHANGED when there is no room, which is why `add_ret` exists beside
// it: a caller that ignored the refusal would otherwise count entities
// the middleware does not have.
pub @tier(embedded)
fn add(g: RosGraph, kind: Int) -> RosGraph []
    if not can_add(g, kind)
        return g
    counts_moved(g, kind, 1)

// The return code adding one of this kind would produce.
//
// `ROS_RET_OK`, or `ROS_RET_BAD_ALLOC` — which is what rmw_microxrcedds
// answers when a pool is exhausted, and which reads as "out of memory"
// when it means "this firmware was built for one".
pub @tier(embedded)
fn add_ret(g: RosGraph, kind: Int) -> Int []
    if can_add(g, kind)
        return rosret.ROS_RET_OK
    rosret.ROS_RET_BAD_ALLOC

// The pool with one of this kind given back.
pub @tier(embedded)
fn remove(g: RosGraph, kind: Int) -> RosGraph []
    // A release of something the pool never held must not make room for
    // another one: the count would go negative and `remaining` would
    // then report more room than the firmware was built with.
    if used_of(g, kind) <= 0
        return g
    counts_moved(g, kind, -1)

// Whether a pool can hold everything a program intends to create.
//
// The four counts are what the program will ask for.  One call at
// startup against `default_pool` is the check that turns a mysterious
// runtime failure into a line naming which maximum is too small.
pub @tier(embedded)
fn pool_admits(g: RosGraph, publishers: Int, subscriptions: Int, services: Int,
               clients: Int) -> Bool []
    // Against the room left in the pool as it stands, so a program that
    // has already created three publishers asks whether three more fit.
    // The nodes are not asked about: a micro-ROS node creates its one
    // node before it has anything to compare, and the four counts are
    // the ones that run out.
    publishers <= remaining(g, ROS_ENTITY_PUBLISHER)
        and subscriptions <= remaining(g, ROS_ENTITY_SUBSCRIPTION)
        and services <= remaining(g, ROS_ENTITY_SERVICE)
        and clients <= remaining(g, ROS_ENTITY_CLIENT)

// The first kind of entity a program would run out of, or -1.
pub @tier(embedded)
fn first_shortfall(g: RosGraph, publishers: Int, subscriptions: Int, services: Int,
                   clients: Int) -> Int []
    // In the order the four counts were given, because a program that
    // would run out of two of them can only fix one first.
    if publishers > remaining(g, ROS_ENTITY_PUBLISHER)
        return ROS_ENTITY_PUBLISHER
    if subscriptions > remaining(g, ROS_ENTITY_SUBSCRIPTION)
        return ROS_ENTITY_SUBSCRIPTION
    if services > remaining(g, ROS_ENTITY_SERVICE)
        return ROS_ENTITY_SERVICE
    if clients > remaining(g, ROS_ENTITY_CLIENT)
        return ROS_ENTITY_CLIENT
    -1

// The kind in words.
pub @tier(embedded)
fn entity_name(kind: Int) -> Str []
    match kind
        ROS_ENTITY_NODE         => "node"
        ROS_ENTITY_PUBLISHER    => "publisher"
        ROS_ENTITY_SUBSCRIPTION => "subscription"
        ROS_ENTITY_SERVICE      => "service"
        ROS_ENTITY_CLIENT       => "client"
        ROS_ENTITY_TIMER        => "timer"
        ROS_ENTITY_GUARD        => "guard condition"
        _                       => "unknown"

// ── An endpoint ──────────────────────────────────────────────────────

// One publisher or one subscription, as the three things that decide
// whether it connects to anything.
//
// NO TOPIC NAME.  A name is a string, a string is a heap value, and a
// firmware holds its names as literals wherever it holds them.  What
// travels with the endpoint is the INDEX the program filed it under,
// which is the same thing an rcl handle is.
pub @value
struct RosEndpoint
    // One of `ROS_ENTITY_PUBLISHER` or `ROS_ENTITY_SUBSCRIPTION`.
    kind: Int
    // Where the program keeps this endpoint.
    index: Int
    // The message type, as `rosname.type_id` computes it.
    type_id: Int
    // The settings this endpoint offers or requests.
    qos: RosQos
    // Whether the endpoint was created.
    valid: Bool

// An endpoint.
pub @tier(embedded)
fn endpoint(kind: Int, index: Int, type_id: Int, q: RosQos) -> RosEndpoint []
    RosEndpoint {
        kind: kind,
        index: index,
        type_id: type_id,
        qos: q,
        valid: true }

// An endpoint that was not created.
pub @tier(embedded)
fn no_endpoint(kind: Int) -> RosEndpoint []
    // The index and the type are -1 because there is no position and no
    // type to name, and the settings are the middleware's own defaults
    // because nothing was chosen: what matters is `valid`, which is the
    // first thing `can_connect` asks.
    RosEndpoint {
        kind: kind,
        index: -1,
        type_id: -1,
        qos: rosqos.system_default_profile(),
        valid: false }

// Whether two endpoints will connect, as a return code.
//
// `ROS_RET_OK` when they will.  `ROS_RET_INVALID_ARGUMENT` when either
// was not created or when they are not a publisher and a subscription.
// `ROS_RET_ERROR` when their message types differ.
// `ROS_RET_QOS_INCOMPATIBLE` when their settings cannot match.
//
// BOTH OF THE LAST TWO ARE SILENT IN ROS 2.  Two endpoints on one topic
// with different message types are both created, both healthy, and
// never connected; `ros2 topic info --verbose` is the only thing that
// shows it, and there is no `ros2` on a microcontroller.  The settings
// mismatch is the same story.  This function is the whole reason the
// endpoint carries its type and its settings rather than leaving them
// with the middleware.
//
// ```novo
// use rosgraph
// use rosqos
// use rosret
//
// fn main() [io]
//     let p = rosgraph.endpoint(rosgraph.ROS_ENTITY_PUBLISHER, 0, 1234,
//                               rosqos.sensor_data_profile())
//     let s = rosgraph.endpoint(rosgraph.ROS_ENTITY_SUBSCRIPTION, 0, 1234,
//                               rosqos.default_profile())
//     println(rosret.ros_ret_name(rosgraph.can_connect(p, s)))
//     // ROS_RET_QOS_INCOMPATIBLE
// ```
pub @tier(embedded)
fn can_connect(publisher: RosEndpoint, subscription: RosEndpoint) -> Int []
    // The argument is asked about first, then the types, then the
    // settings: each answer is more specific than the one before, and a
    // caller that fixes the first can ask again.
    if not publisher.valid or not subscription.valid
        return rosret.ROS_RET_INVALID_ARGUMENT
    if publisher.kind != ROS_ENTITY_PUBLISHER
        return rosret.ROS_RET_INVALID_ARGUMENT
    if subscription.kind != ROS_ENTITY_SUBSCRIPTION
        return rosret.ROS_RET_INVALID_ARGUMENT
    if not same_type(publisher, subscription)
        return rosret.ROS_RET_ERROR
    if not rosqos.compatible(publisher.qos, subscription.qos).compatible
        return rosret.ROS_RET_QOS_INCOMPATIBLE
    rosret.ROS_RET_OK

// Which quality-of-service policy stopped two endpoints, in full.
//
// `can_connect` answers a code and this answers the detail behind it.
// Compatible when the endpoints differ for some other reason, which is
// why `can_connect` is the question and this is the follow-up.
pub @tier(embedded)
fn connect_qos(publisher: RosEndpoint, subscription: RosEndpoint) -> RosQosCompat []
    // The whole detail, whatever `can_connect` answered: a pair that
    // differs for some other reason is still compatible here.
    rosqos.compatible(publisher.qos, subscription.qos)

// Whether two endpoints carry the same message type.
pub @tier(embedded)
fn same_type(a: RosEndpoint, b: RosEndpoint) -> Bool []
    // The type identity and nothing else: whether either endpoint was
    // created is a question `can_connect` asks before this one.
    a.type_id == b.type_id

// How many messages an endpoint's settings will actually be given.
//
// The smaller of the profile's depth and the pool's history maximum.  A
// subscription asking to keep ten against a firmware built to hold four
// keeps four, silently — so a burst of six arrives as four, and the
// program that sized its buffer from its own profile is wrong by two.
pub @tier(embedded)
fn effective_depth(g: RosGraph, e: RosEndpoint) -> Int []
    // The firmware's limit is the one the profile cannot raise, so the
    // smaller of the two is what the endpoint is really given.
    if e.qos.depth < g.max_history
        return e.qos.depth
    g.max_history

// Whether the pool will give this endpoint the depth its settings asked
// for.
pub @tier(embedded)
fn depth_is_honoured(g: RosGraph, e: RosEndpoint) -> Bool []
    effective_depth(g, e) == e.qos.depth
