// rostransport.nv — the session with the agent, and the byte pipe
// underneath it.
//
// A MICRO-ROS NODE IS NOT A ROS 2 PARTICIPANT.  A node on a workstation
// speaks DDS to every other node directly.  A node on a
// microcontroller speaks Micro XRCE-DDS to an AGENT — a process on
// another machine — and the agent is the DDS participant on its behalf.
// Everything follows from that: the node's topics do not exist until
// the agent has created them, an agent restart loses every entity the
// node made, and a node whose agent is not running publishes into
// nothing and is not told.
//
// `RosTransport[e]` IS THE TRAIT THAT CROSSES THE LAYER, and this
// module implements it nowhere.  `e` is the effect the byte pipe
// supplies: `[hw]` for a UART on a device, `[net]` for a socket on a
// host, and nothing for a recorded exchange in a test.  Every function
// written over it costs what its argument costs (SPEC § 5.6).
//
// THE STREAM KIND IS WHERE QUALITY OF SERVICE ACTUALLY HAPPENS HERE.
// A publisher's reliability setting is a DDS concept, and between a
// microcontroller and its agent there is no DDS: there is an XRCE
// stream, and a stream is either best-effort — send and forget — or
// reliable, with sequence numbers, acknowledgements and a
// retransmission buffer.  `stream_for` is the mapping, and the
// retransmission buffer is memory the firmware set aside at compile
// time, which is why a node with more reliable streams than its build
// allows fails at the last one.
//
// AND THE SESSION IS THE PART THAT GOES WRONG IN THE FIELD.  An agent
// that restarts leaves the client believing it has a participant, a
// topic and a publisher that no longer exist; every write after that
// succeeds locally and arrives nowhere.  The only thing that notices is
// the heartbeat, which is why `RosSession` carries one and why
// `session_is_stale` exists.

use std.list
use rosmsg
use rosret
use xrcewire

// ── Stream kinds ─────────────────────────────────────────────────────

// No stream at all: the message travels in the session's own
// out-of-band channel.  For the session handshake and nothing else.
pub const ROS_STREAM_NONE = 0
// Best effort: sent once, not numbered, not acknowledged.  What a
// sensor topic uses, and what costs no buffer.
pub const ROS_STREAM_BEST_EFFORT = 1
// Reliable: numbered, acknowledged, retransmitted.  What a command
// topic and every service call uses, and what costs a retransmission
// buffer sized at compile time.
pub const ROS_STREAM_RELIABLE = 2

// Which XRCE stream a quality-of-service reliability setting becomes.
//
// `ROS_RELIABILITY_RELIABLE` becomes a reliable stream and
// `ROS_RELIABILITY_BEST_EFFORT` a best-effort one.  The middleware's
// own default is reliable here, which is the safe direction: a
// best-effort topic on a reliable stream works and costs a buffer, and
// the other way round loses messages.
//
// ```novo
// use rostransport
// use rosqos
//
// fn main() [io]
//     println("${rostransport.stream_for(rosqos.ROS_RELIABILITY_BEST_EFFORT)}")
//     // 1, a best-effort stream
// ```
pub @tier(embedded)
@no_alloc
fn stream_for(reliability: Int) -> Int []
    // 2 is `rosqos.ROS_RELIABILITY_BEST_EFFORT`; a reliable setting
    // (1) and the middleware's own default (0) both take a reliable
    // stream, which is the safe direction.
    if reliability == 2
        ROS_STREAM_BEST_EFFORT
    else
        ROS_STREAM_RELIABLE

// The stream kind in words.
pub @tier(embedded)
@no_alloc
fn stream_name(kind: Int) -> Str []
    match kind
        0 => "none"   // ROS_STREAM_NONE
        1 => "best effort"   // ROS_STREAM_BEST_EFFORT
        2 => "reliable"   // ROS_STREAM_RELIABLE
        _ => "unknown"

// How many messages a reliable stream holds for retransmission in a
// stock micro-ROS build: 4.
//
// Fixed at compile time, and shared per stream.  A publisher on a
// reliable stream that gets four messages ahead of the agent's
// acknowledgements blocks or drops, depending on the build.
pub const ROS_STREAM_HISTORY = 4

// ── The session ──────────────────────────────────────────────────────

// The session has not been opened.
pub const ROS_SESSION_CLOSED = 0
// A create request has gone out and no status has come back.
pub const ROS_SESSION_OPENING = 1
// The agent has acknowledged the session.
pub const ROS_SESSION_ESTABLISHED = 2
// The agent stopped answering heartbeats.
pub const ROS_SESSION_LOST = 3

// One client's conversation with one agent.
//
// A `@value` of integers, so a driver holds it beside its transport
// handle with nothing on a heap.
pub @value
struct RosSession
    // One of `ROS_SESSION_*`.
    state: Int
    // The four bytes that identify this client to the agent.  Two
    // clients with the same key on one agent take each other's
    // entities, which is a failure that looks like a flapping node.
    client_key: Int
    // The session identifier the agent assigned.
    session_id: Int
    // The next request identifier to send.  Every create, write and
    // read carries one and the agent's status quotes it back.
    next_request: Int
    // The last sequence number written on the reliable stream.
    output_seq: Int
    // The last sequence number accepted from the agent.
    input_seq: Int
    // The transport's buffer size, in bytes.
    mtu: Int
    // How long since the agent last answered, in milliseconds.  The
    // caller measures it; this package has no clock.
    silent_ms: Int

// A session that has not been opened, for a client key and a transport
// size.
//
// ```novo
// use rostransport
//
// fn main() [io]
//     println("${rostransport.session(0xaabbccdd, 512).state}")   // 0
// ```
pub @tier(embedded)
@no_alloc
fn session(client_key: Int, mtu: Int) -> RosSession []
    // Every counter starts at zero and the session is closed until
    // an agent has answered.  The first request identifier is 1,
    // because 0 is what an XRCE header carries when there is no
    // request.
    RosSession {
        state: ROS_SESSION_CLOSED,
        client_key: client_key,
        session_id: 0,
        next_request: 1,
        output_seq: 0,
        input_seq: 0,
        mtu: mtu,
        silent_ms: 0 }

// Whether the session may carry messages.
pub @tier(embedded)
@no_alloc
fn session_is_ready(s: RosSession) -> Bool []
    s.state == ROS_SESSION_ESTABLISHED

// The session with `delta_ms` more milliseconds of silence.
pub @tier(embedded)
@no_alloc
fn session_silent(s: RosSession, delta_ms: Int) -> RosSession []
    // The caller owns the clock; this only accumulates what it is
    // told.
    RosSession {
        state: s.state,
        client_key: s.client_key,
        session_id: s.session_id,
        next_request: s.next_request,
        output_seq: s.output_seq,
        input_seq: s.input_seq,
        mtu: s.mtu,
        silent_ms: s.silent_ms + delta_ms }

// The session with the silence cleared, because the agent answered.
pub @tier(embedded)
@no_alloc
fn session_heard(s: RosSession) -> RosSession []
    // An answer from the agent is the only thing that clears the
    // silence.
    RosSession {
        state: s.state,
        client_key: s.client_key,
        session_id: s.session_id,
        next_request: s.next_request,
        output_seq: s.output_seq,
        input_seq: s.input_seq,
        mtu: s.mtu,
        silent_ms: 0 }

// Whether the agent has been silent longer than it should be.
//
// The one thing that notices an agent restart.  Until this answers
// true, every write succeeds locally and arrives nowhere, because the
// client still believes in entities the new agent has never heard of.
pub @tier(embedded)
@no_alloc
fn session_is_stale(s: RosSession, timeout_ms: Int) -> Bool []
    // Strictly longer: a silence exactly at the timeout has not yet
    // outlasted it.
    s.silent_ms > timeout_ms

// How long a client should wait between heartbeats, in milliseconds:
// 100.
pub const ROS_HEARTBEAT_MS = 100

// How long a client should let an agent be silent before declaring the
// session lost, in milliseconds: 1000.
pub const ROS_SESSION_TIMEOUT_MS = 1000

// The session after the agent acknowledged it.
pub @tier(embedded)
@no_alloc
fn session_established(s: RosSession, session_id: Int) -> RosSession []
    // The agent answered, so the silence is cleared as well as the
    // state changed.
    RosSession {
        state: ROS_SESSION_ESTABLISHED,
        client_key: s.client_key,
        session_id: session_id,
        next_request: s.next_request,
        output_seq: s.output_seq,
        input_seq: s.input_seq,
        mtu: s.mtu,
        silent_ms: 0 }

// The session with its next request identifier taken.
pub @tier(embedded)
@no_alloc
fn session_next_request(s: RosSession) -> RosSession []
    // Taken before it is used: a request carries this field's
    // value, and the request after it carries the next one.
    RosSession {
        state: s.state,
        client_key: s.client_key,
        session_id: s.session_id,
        next_request: s.next_request + 1,
        output_seq: s.output_seq,
        input_seq: s.input_seq,
        mtu: s.mtu,
        silent_ms: s.silent_ms }

// The session after one message went out on the reliable stream.
pub @tier(embedded)
@no_alloc
fn session_wrote(s: RosSession) -> RosSession []
    // Sixteen bits and wrap, which is the space a reliable stream's
    // sequence numbers live in.
    RosSession {
        state: s.state,
        client_key: s.client_key,
        session_id: s.session_id,
        next_request: s.next_request,
        output_seq: (s.output_seq + 1) % 65536,
        input_seq: s.input_seq,
        mtu: s.mtu,
        silent_ms: s.silent_ms }

// Whether a sequence number from the agent is the next one expected.
//
// A number that is not is either a retransmission, which is dropped, or
// a gap, which the client acknowledges negatively.  Getting this
// backwards makes a link that works until the first lost byte.
pub @tier(embedded)
@no_alloc
fn sequence_is_next(s: RosSession, seq: Int) -> Bool []
    // The number expected is the last accepted one plus one, sixteen
    // bits and wrap.
    seq == (s.input_seq + 1) % 65536

// Whether a sequence number is one already seen.
//
// XRCE sequence numbers are sixteen bits and WRAP, so "already seen" is
// a comparison in modular arithmetic and not a `<`.  A client that used
// a plain comparison rejects every message for half the sequence space
// once the counter has gone round, about an hour into a run at a
// hundred messages a second.
pub @tier(embedded)
@no_alloc
fn sequence_is_old(s: RosSession, seq: Int) -> Bool []
    // Sixteen bits and wrap: a number is behind the last accepted one
    // when its distance forward from it is less than half the space,
    // and it is not the number the next message will carry.
    let ahead = (seq + 65536 - s.input_seq) % 65536
    ahead < 32768 and ahead != 1

// The session state in words.
pub @tier(embedded)
@no_alloc
fn session_state_name(state: Int) -> Str []
    match state
        0 => "closed"   // ROS_SESSION_CLOSED
        1 => "opening"   // ROS_SESSION_OPENING
        2 => "established"   // ROS_SESSION_ESTABLISHED
        3 => "lost"   // ROS_SESSION_LOST
        _ => "unknown"

// ── Framing ───────────────────────────────────────────────────────────

// How many bytes the session puts around a message.
//
// The XRCE message header and the submessage header, which come out of
// the transport's buffer before the payload does.  `kind` is one of
// `ROS_STREAM_*`: a reliable stream costs two more bytes than a
// best-effort one, for its sequence number.
pub @tier(embedded)
@no_alloc
fn framing_overhead(kind: Int) -> Int []
    // The XRCE message header is four bytes and the submessage header
    // two, and a reliable stream adds its two-byte sequence number.
    let header_bytes = 6
    if kind == ROS_STREAM_RELIABLE
        header_bytes + 2
    else
        header_bytes

// Whether a message fits this session's transport.
//
// The payload, the encapsulation header and the framing, against the
// session's own buffer size.  A message that does not fit is DROPPED BY
// THE TRANSPORT, below the layer that could report it.
pub @tier(system)
fn message_fits(s: RosSession, m: RosMessage, kind: Int) -> Bool []
    // The payload, its encapsulation header and the session's framing
    // all come out of one buffer.
    rosmsg.wire_length(m) + framing_overhead(kind) <= s.mtu

// ── The byte pipe ────────────────────────────────────────────────────

// A pipe that carries whole XRCE messages between a client and its
// agent.
//
// WHOLE MESSAGES, NOT BYTES.  A serial link frames with a begin flag
// and an escape byte and a checksum; a TCP link puts a two-byte length
// in front; a UDP link needs neither because a datagram is already a
// frame.  All three are the transport's business and none of them is
// this package's, so the trait's unit is a message and an implementation
// does whatever its medium needs underneath.
pub trait RosTransport[e]
    // Send one whole message.  Answers whether every byte went out.
    fn ros_send(self, frame: Bytes) -> Bool [e]
    // Take the next whole message, or nothing when none has arrived.
    //
    // NOT A BLOCKING READ.  A node on a device polls this from its own
    // loop and a node on a host from a task, and a blocking read would
    // make the first impossible.  `timeout_ms` is passed to whatever
    // waiting the medium does; zero means take what is already there.
    fn ros_recv(self, timeout_ms: Int) -> ?Bytes [e]
    // Whether the pipe is open.
    fn ros_is_open(self) -> Bool [e]
    // Close it.
    fn ros_close(self) [e]
    // The largest message this pipe carries, in bytes.  Answered
    // without performing anything, because a driver asks it once.
    fn ros_mtu(self) -> Int

// A session and the code of the last thing done with it.
//
// The functions below answer the session as well as a result, because
// each of them changes the session (a sequence number is used, a
// request identifier is taken) and a `@value` cannot be changed through
// a pipe's `self`.
pub @value
struct RosOutcome
    // The session after the call.
    session: RosSession
    // One of the `rosret` codes: `ROS_RET_OK`; `ROS_RET_NOT_INIT` for
    // a session that is not established; `ROS_RET_INVALID_ARGUMENT` for
    // a message that does not fit; `ROS_RET_AGENT_UNREACHABLE` when the
    // pipe refused the bytes; `ROS_RET_TIMEOUT` when no status came
    // back in time; `ROS_RET_ERROR` when the agent answered with a
    // status that is not OK.
    code: Int
    // The agent's status number when it answered, else -1.  See
    // `xrcewire.status_name`.
    status: Int

// The bytes of a message built in a buffer, as a `Bytes`.
@tier(system)
fn wire_bytes(var m: Vec[u8; 512]) -> Bytes
    system
        var xs: [Int] = []
        // workaround(vec-has-no-list-conversion): this loop stands in for a Vec-to-list conversion the family lacks.
        for x in m
            let wide = x as Int
            xs = list.push(xs, wide)
        return bytes.from_byte_list(xs)

// A received `Bytes`, copied into a buffer.  A message longer than the
// buffer is cut at its end; the reply reader then finds no status.
@tier(system)
fn wire_read(var m: Vec[u8; 512], b: Bytes)
    system
        m.clear()
        for i in 0..bytes.len(b)
            let _ = m.push((bytes.byte_at(b, i) ?? 0) as u8)

// The session with its state replaced and every other field kept.
//
// The shape a `@value` struct needs: callers that change the state
// would otherwise each spell the same eight-field literal.
pub @tier(embedded)
@no_alloc
fn session_with_state(s: RosSession, state: Int) -> RosSession
    RosSession {
        state: state,
        client_key: s.client_key,
        session_id: s.session_id,
        next_request: s.next_request,
        output_seq: s.output_seq,
        input_seq: s.input_seq,
        mtu: s.mtu,
        silent_ms: s.silent_ms }

// An outcome from its three parts.
@tier(embedded)
@no_alloc
fn outcome(s: RosSession, code: Int, status: Int) -> RosOutcome
    RosOutcome { session: s, code: code, status: status }

// Open a session with the agent.
//
// `[e]`, so the cost is the pipe's.  Sends the CREATE_CLIENT message
// that carries the session's client key, takes the agent's STATUS_AGENT
// and answers the session with its state set to established, or to
// closed when no status came back within `timeout_ms`, the pipe
// refused the bytes, or the agent answered with a status that is not OK.
//
// ONE EXCHANGE, NOT A RETRY LOOP.  A node that cannot reach its agent
// has to decide what to do about it — wait, blink a light, carry on
// measuring into a buffer — and a library that hid the retry would
// decide for it.
pub @tier(system)
fn open_session<T: RosTransport[e]>(t: T, s: RosSession, timeout_ms: Int) -> RosSession [e]
    system
        // The advertised size is what this side can read back: a reply
        // longer than the 512-byte buffer is cut.
        var m: Vec[u8; 512] = Vec.new()
        let mtu = if s.mtu < 512
            s.mtu
        else
            512
        let _built = xrcewire.create_client(var m, s.client_key, mtu)
        if not t.ros_send(wire_bytes(var m))
            return session_with_state(s, ROS_SESSION_CLOSED)
        let status = t.ros_recv(timeout_ms)
        if status == None
            return session_with_state(s, ROS_SESSION_CLOSED)
        wire_read(var m, status ?? bytes.zeros(0))
        let reply = xrcewire.read_reply(var m)
        if reply.kind == xrcewire.XRCE_REPLY_STATUS_AGENT
            and xrcewire.status_is_ok(reply.status)
            return session_established(s, xrcewire.XRCE_SESSION_ID)
        return session_with_state(s, ROS_SESSION_CLOSED)

// Tell the agent the session is over.
pub @tier(system)
fn close_session<T: RosTransport[e]>(t: T, s: RosSession) -> RosSession [e]
    system
        // The delete request carries the session's own identifier.  The
        // client's state is closed whatever the pipe says, because the
        // decision to end the session is the client's.
        var m: Vec[u8; 512] = Vec.new()
        let _built = xrcewire.delete_client(var m, s.next_request)
        t.ros_send(wire_bytes(var m))
        return session_with_state(s, ROS_SESSION_CLOSED)

// Create one entity on the agent from an XML description, and wait for
// its status.
//
// `object` is the new entity's id (`xrcewire.object_id`), `kind` its
// kind (`xrcewire.XRCE_KIND_*`), `parent` the id of the entity it
// belongs to, or for a participant its DDS domain id.  The message goes
// out on the best-effort stream and replaces an entity of the same id,
// so a program that restarts does not meet its own leftovers.  The
// outcome's `code` is `ROS_RET_OK` when the agent answered OK or
// matched, and its `status` is the agent's number either way.
pub @tier(system)
fn create_entity<T: RosTransport[e]>(t: T, s: RosSession, object: Int, kind: Int, parent: Int,
                                     xml: Str, timeout_ms: Int) -> RosOutcome [e]
    system
        if not session_is_ready(s)
            return outcome(s, rosret.ROS_RET_NOT_INIT, 0 - 1)
        var m: Vec[u8; 512] = Vec.new()
        let request = s.next_request
        let sent = session_wrote(session_next_request(s))
        if not xrcewire.create_entity(var m, xrcewire.XRCE_STREAM_BEST_EFFORT, s.output_seq,
                                      request, object, kind, parent, xml,
                                      xrcewire.XRCE_CREATE_REPLACE)
            return outcome(s, rosret.ROS_RET_INVALID_ARGUMENT, 0 - 1)
        if not t.ros_send(wire_bytes(var m))
            return outcome(s, rosret.ROS_RET_AGENT_UNREACHABLE, 0 - 1)
        let answer = t.ros_recv(timeout_ms)
        if answer == None
            return outcome(sent, rosret.ROS_RET_TIMEOUT, 0 - 1)
        wire_read(var m, answer ?? bytes.zeros(0))
        let reply = xrcewire.read_reply(var m)
        if reply.kind != xrcewire.XRCE_REPLY_STATUS or reply.request != request
            return outcome(sent, rosret.ROS_RET_TIMEOUT, 0 - 1)
        if xrcewire.status_is_ok(reply.status)
            return outcome(session_heard(sent), rosret.ROS_RET_OK, reply.status)
        return outcome(session_heard(sent), rosret.ROS_RET_ERROR, reply.status)

// Write one sample to a data writer.
//
// `sample` is the CDR body WITHOUT the four-byte representation header:
// the agent writes that itself (see `xrcewire`).  Sent on the
// best-effort stream, which has no status to wait for; the outcome's
// `code` says whether the pipe took the bytes.
pub @tier(system)
fn write_sample<T: RosTransport[e]>(t: T, s: RosSession, writer: Int,
                                    sample: Bytes) -> RosOutcome [e]
    system
        if not session_is_ready(s)
            return outcome(s, rosret.ROS_RET_NOT_INIT, 0 - 1)
        var m: Vec[u8; 512] = Vec.new()
        let request = s.next_request
        let sent = session_wrote(session_next_request(s))
        var ok = xrcewire.begin_write_data(var m, xrcewire.XRCE_STREAM_BEST_EFFORT,
                                           s.output_seq, request, writer)
        for i in 0..bytes.len(sample)
            ok = ok and xrcewire.put_sample_byte(var m, bytes.byte_at(sample, i) ?? 0)
        if not ok
            return outcome(s, rosret.ROS_RET_INVALID_ARGUMENT, 0 - 1)
        let _len = xrcewire.finish_write_data(var m)
        if not t.ros_send(wire_bytes(var m))
            return outcome(s, rosret.ROS_RET_AGENT_UNREACHABLE, 0 - 1)
        return outcome(sent, rosret.ROS_RET_OK, 0 - 1)

// Send one message on a stream.
//
// Answers the return code: `ROS_RET_OK`, `ROS_RET_NOT_INIT` for a
// session that is not established, `ROS_RET_INVALID_ARGUMENT` for a
// message larger than the transport, and `ROS_RET_AGENT_UNREACHABLE`
// when the pipe refused it.
//
// WHAT GOES OUT IS THE MESSAGE'S ENVELOPE AND NOTHING ELSE: its
// four-byte header and its payload, with no XRCE message header around
// them, so an agent does not read it as a sample.  A program that
// publishes to a real agent calls `write_sample`.
pub @tier(system)
fn send_message<T: RosTransport[e]>(t: T, s: RosSession, m: RosMessage, kind: Int) -> Int [e]
    system
        // The checks are in the order the caller can act on them: an
        // established session, a message the transport can carry, and
        // then the pipe.
        if not session_is_ready(s)
            return rosret.ROS_RET_NOT_INIT
        if not message_fits(s, m, kind)
            return rosret.ROS_RET_INVALID_ARGUMENT
        if t.ros_send(rosmsg.encode_envelope(m))
            return rosret.ROS_RET_OK
        return rosret.ROS_RET_AGENT_UNREACHABLE

// Take one message from the agent, or nothing.
//
// Answers the raw bytes; `rosmsg.decode_envelope` is what turns them
// into a message, and which type they are is the caller's, because only
// the caller knows which subscription the object identifier belongs to.
pub @tier(system)
fn take_message<T: RosTransport[e]>(t: T, s: RosSession, timeout_ms: Int) -> ?Bytes [e]
    // The bytes and not a message: which type they hold is the
    // caller's, because only the caller knows which subscription the
    // object identifier belongs to.
    t.ros_recv(timeout_ms)

// Send a heartbeat if one is due, and answer the session.
//
// `elapsed_ms` is how long since this was last called.  The one
// periodic obligation a micro-ROS client has, and the only thing that
// notices an agent that went away.
//
// THE HEARTBEAT IS A PING.  A best-effort stream has no heartbeat of its
// own in XRCE, so what goes out is the GET_INFO the eProsima client
// uses to ask whether an agent is there; any INFO that comes back clears
// the silence.
pub @tier(system)
fn heartbeat<T: RosTransport[e]>(t: T, s: RosSession, elapsed_ms: Int) -> RosSession [e]
    system
        // Silence accumulates first: an agent quiet for longer than the
        // timeout is gone, and no heartbeat this client sends changes
        // that.
        let waited = session_silent(s, elapsed_ms)
        if not session_is_ready(waited)
            return waited
        if session_is_stale(waited, ROS_SESSION_TIMEOUT_MS)
            return session_with_state(waited, ROS_SESSION_LOST)
        if waited.silent_ms < ROS_HEARTBEAT_MS
            return waited
        var m: Vec[u8; 512] = Vec.new()
        let _built = xrcewire.ping(var m, waited.next_request)
        if not t.ros_send(wire_bytes(var m))
            return waited
        let answer = t.ros_recv(0)
        if answer == None
            return waited
        wire_read(var m, answer ?? bytes.zeros(0))
        let reply = xrcewire.read_reply(var m)
        if reply.kind == xrcewire.XRCE_REPLY_INFO
            return session_heard(session_next_request(waited))
        return waited

// Whether the pipe reports itself open and the session established.
pub @tier(system)
fn is_connected<T: RosTransport[e]>(t: T, s: RosSession) -> Bool [e]
    t.ros_is_open() and session_is_ready(s)
