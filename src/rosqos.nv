// rosqos.nv — the settings that decide whether two endpoints ever
// speak to each other, and the function that answers before either is
// created.
//
// `[]` THROUGHOUT and `@tier(embedded)` on all of it.
//
// THIS IS THE LOAD-BEARING INTERFACE OF THE PACKAGE, and the argument
// is that AN INCOMPATIBLE PAIR IS SILENT.  A publisher that offers
// best-effort delivery and a subscription that requests reliable
// delivery are both created successfully, both report healthy, and
// never connect.  Nothing is logged.  `ros2 topic list` shows the
// topic, `ros2 topic info` shows one publisher and one subscription,
// and the callback is never called.  The same is true of a volatile
// publisher against a transient-local subscription, and of an automatic
// liveliness publisher against a subscription that asks for manual
// liveliness.
//
// The failure is worse on a microcontroller than on a workstation,
// because the workstation at least has `ros2 topic echo` and a
// publisher whose settings can be read back from the graph.  A node on
// a Cortex-M has a UART and whatever it was compiled to print.
//
// So `compatible` is a pure function over two settings values, it
// answers WHICH policy is the offender, and it is meant to be called at
// startup — before the endpoint exists, on the device, with the answer
// printed once.
//
// THE RULE IS "REQUESTED VERSUS OFFERED" AND IT IS NOT SYMMETRIC.  The
// publisher OFFERS and the subscription REQUESTS, and a match needs the
// offer to be at least as strong as the request.  Reliable satisfies a
// request for best-effort; best-effort does not satisfy a request for
// reliable.  Swapping the two arguments of `compatible` therefore gives
// a different answer, which is why they are named rather than
// positional in the doc comments.
//
// AND TWO POLICIES DO NOT PARTICIPATE AT ALL.  History and its depth
// are local to each endpoint, and lifespan is the publisher's own
// business; none of them can prevent a match.  A depth of 1 against a
// depth of 100 is a perfectly good pair that will drop messages, which
// is a different problem with a different fix.

// ── History ──────────────────────────────────────────────────────────

// Keep the last `depth` messages.  Every profile below uses this.
pub const ROS_HISTORY_KEEP_LAST = 1
// Keep every message, up to the middleware's resource limits.
pub const ROS_HISTORY_KEEP_ALL = 2
// Whatever the middleware's own default is.
pub const ROS_HISTORY_SYSTEM_DEFAULT = 0

// ── Reliability ──────────────────────────────────────────────────────

// Retransmit until every subscription has the message.
pub const ROS_RELIABILITY_RELIABLE = 1
// Send once and do not look back.  What a sensor stream wants: a
// retransmitted reading from three cycles ago is worse than no reading.
pub const ROS_RELIABILITY_BEST_EFFORT = 2
// Whatever the middleware's own default is.
pub const ROS_RELIABILITY_SYSTEM_DEFAULT = 0

// ── Durability ───────────────────────────────────────────────────────

// Keep the last messages for subscriptions that join later.  What
// `/tf_static` and every "latched" topic uses, and the reason a node
// that starts second can still learn the robot's shape.
pub const ROS_DURABILITY_TRANSIENT_LOCAL = 1
// Keep nothing for a late joiner.
pub const ROS_DURABILITY_VOLATILE = 2
// Whatever the middleware's own default is.
pub const ROS_DURABILITY_SYSTEM_DEFAULT = 0

// ── Liveliness ───────────────────────────────────────────────────────

// The middleware asserts that the publisher is alive, by itself.
pub const ROS_LIVELINESS_AUTOMATIC = 1
// The publisher asserts it, per topic, by publishing or by saying so.
// A node whose process is running and whose control loop has stopped is
// alive under the automatic policy and dead under this one, which is
// the whole reason it exists.
pub const ROS_LIVELINESS_MANUAL_BY_TOPIC = 3
// Whatever the middleware's own default is.
pub const ROS_LIVELINESS_SYSTEM_DEFAULT = 0

// ── Which policy refused ─────────────────────────────────────────────

// Nothing refused.
pub const ROS_QOS_POLICY_NONE = 0
// Reliability.
pub const ROS_QOS_POLICY_RELIABILITY = 1
// Durability.
pub const ROS_QOS_POLICY_DURABILITY = 2
// Deadline.
pub const ROS_QOS_POLICY_DEADLINE = 3
// Liveliness.
pub const ROS_QOS_POLICY_LIVELINESS = 4
// The liveliness lease duration.
pub const ROS_QOS_POLICY_LEASE = 5

// The number that means "no duration at all", which is how ROS 2
// spells an infinite deadline, lifespan or lease: 0.
//
// Zero rather than a large number, because a deadline of zero is not a
// meaningful request and an infinity has to be spelled somehow.  A
// caller comparing durations must therefore test for it rather than
// comparing, which is what `deadline_satisfies` does.
pub const ROS_DURATION_INFINITE = 0

// ── The settings ─────────────────────────────────────────────────────

// One endpoint's quality of service settings.
//
// Durations are in MILLISECONDS rather than nanoseconds.  ROS 2's own
// structure carries seconds and nanoseconds in two fields; a deadline
// or a lease that anybody sets by hand is a number of milliseconds, and
// a nanosecond field on a thirty-two bit part invites the overflow that
// makes a ten-second lease into a four-second one.
pub @value
struct RosQos
    // One of `ROS_HISTORY_*`.
    history: Int
    // How many messages to keep, when the history is keep-last.
    depth: Int
    // One of `ROS_RELIABILITY_*`.
    reliability: Int
    // One of `ROS_DURABILITY_*`.
    durability: Int
    // The longest gap between messages the endpoint promises or
    // tolerates, in milliseconds, or `ROS_DURATION_INFINITE`.
    deadline_ms: Int
    // How long a message stays valid after it is published, in
    // milliseconds, or `ROS_DURATION_INFINITE`.  Local to the
    // publisher: it does not participate in matching.
    lifespan_ms: Int
    // One of `ROS_LIVELINESS_*`.
    liveliness: Int
    // How long the publisher may be silent before it is declared not
    // alive, in milliseconds, or `ROS_DURATION_INFINITE`.
    lease_ms: Int

// ROS 2's default profile: keep the last 10, reliable, volatile.
//
// What a topic gets when nothing asks for anything else, and the right
// answer for commands, states and anything a receiver must not miss.
//
// ```novo
// use rosqos
//
// fn main() [io]
//     println("${rosqos.default_profile().depth}")   // 10
// ```
pub @tier(embedded)
fn default_profile() -> RosQos []
    RosQos {
        history: ROS_HISTORY_KEEP_LAST,
        depth: 10,
        reliability: ROS_RELIABILITY_RELIABLE,
        durability: ROS_DURABILITY_VOLATILE,
        deadline_ms: ROS_DURATION_INFINITE,
        lifespan_ms: ROS_DURATION_INFINITE,
        liveliness: ROS_LIVELINESS_AUTOMATIC,
        lease_ms: ROS_DURATION_INFINITE }

// The sensor-data profile: keep the last 5, best effort, volatile.
//
// The profile every camera, laser scanner and inertial unit in ROS 2
// publishes with, and the one whose mismatch with the default is the
// single most common reason a ROS 2 subscription receives nothing.
pub @tier(embedded)
fn sensor_data_profile() -> RosQos []
    RosQos {
        history: ROS_HISTORY_KEEP_LAST,
        depth: 5,
        reliability: ROS_RELIABILITY_BEST_EFFORT,
        durability: ROS_DURABILITY_VOLATILE,
        deadline_ms: ROS_DURATION_INFINITE,
        lifespan_ms: ROS_DURATION_INFINITE,
        liveliness: ROS_LIVELINESS_AUTOMATIC,
        lease_ms: ROS_DURATION_INFINITE }

// The services profile: keep the last 10, reliable, volatile.
pub @tier(embedded)
fn services_profile() -> RosQos []
    RosQos {
        history: ROS_HISTORY_KEEP_LAST,
        depth: 10,
        reliability: ROS_RELIABILITY_RELIABLE,
        durability: ROS_DURABILITY_VOLATILE,
        deadline_ms: ROS_DURATION_INFINITE,
        lifespan_ms: ROS_DURATION_INFINITE,
        liveliness: ROS_LIVELINESS_AUTOMATIC,
        lease_ms: ROS_DURATION_INFINITE }

// The parameters profile: keep the last 1000, reliable, volatile.
//
// The depth is not a typo: parameter events are bursty and a node that
// sets fifty parameters at startup sends fifty messages in a
// millisecond.
pub @tier(embedded)
fn parameters_profile() -> RosQos []
    RosQos {
        history: ROS_HISTORY_KEEP_LAST,
        depth: 1000,
        reliability: ROS_RELIABILITY_RELIABLE,
        durability: ROS_DURABILITY_VOLATILE,
        deadline_ms: ROS_DURATION_INFINITE,
        lifespan_ms: ROS_DURATION_INFINITE,
        liveliness: ROS_LIVELINESS_AUTOMATIC,
        lease_ms: ROS_DURATION_INFINITE }

// The profile a latched topic wants: keep the last 1, reliable,
// transient local.
//
// What `/tf_static`, `/robot_description` and `/map` use.  A
// subscription that joins a minute after the publisher still gets the
// last message, which is the only way a topic that is published once at
// startup is useful at all.
pub @tier(embedded)
fn transient_local_profile() -> RosQos []
    RosQos {
        history: ROS_HISTORY_KEEP_LAST,
        depth: 1,
        reliability: ROS_RELIABILITY_RELIABLE,
        durability: ROS_DURABILITY_TRANSIENT_LOCAL,
        deadline_ms: ROS_DURATION_INFINITE,
        lifespan_ms: ROS_DURATION_INFINITE,
        liveliness: ROS_LIVELINESS_AUTOMATIC,
        lease_ms: ROS_DURATION_INFINITE }

// Every field set to the middleware's own default.
//
// The profile to avoid on a robot with more than one middleware in it:
// what it resolves to is the vendor's choice, so two nodes that both
// asked for it can still fail to match.
pub @tier(embedded)
fn system_default_profile() -> RosQos []
    // Every field is its family's `*_SYSTEM_DEFAULT`, which is 0 for
    // each of them — including the durations, where zero is also how an
    // infinite duration is spelled.
    RosQos {
        history: ROS_HISTORY_SYSTEM_DEFAULT,
        depth: 0,
        reliability: ROS_RELIABILITY_SYSTEM_DEFAULT,
        durability: ROS_DURABILITY_SYSTEM_DEFAULT,
        deadline_ms: ROS_DURATION_INFINITE,
        lifespan_ms: ROS_DURATION_INFINITE,
        liveliness: ROS_LIVELINESS_SYSTEM_DEFAULT,
        lease_ms: ROS_DURATION_INFINITE }

// A profile from its eight fields.
pub @tier(embedded)
fn qos(history: Int, depth: Int, reliability: Int, durability: Int, deadline_ms: Int,
       lifespan_ms: Int, liveliness: Int, lease_ms: Int) -> RosQos []
    RosQos {
        history: history,
        depth: depth,
        reliability: reliability,
        durability: durability,
        deadline_ms: deadline_ms,
        lifespan_ms: lifespan_ms,
        liveliness: liveliness,
        lease_ms: lease_ms }

// The same profile with a different reliability.
pub @tier(embedded)
fn with_reliability(q: RosQos, reliability: Int) -> RosQos []
    qos(q.history, q.depth, reliability, q.durability, q.deadline_ms, q.lifespan_ms,
        q.liveliness, q.lease_ms)

// The same profile with a different durability.
pub @tier(embedded)
fn with_durability(q: RosQos, durability: Int) -> RosQos []
    qos(q.history, q.depth, q.reliability, durability, q.deadline_ms, q.lifespan_ms,
        q.liveliness, q.lease_ms)

// The same profile with a different keep-last depth.
pub @tier(embedded)
fn with_depth(q: RosQos, depth: Int) -> RosQos []
    qos(q.history, depth, q.reliability, q.durability, q.deadline_ms, q.lifespan_ms,
        q.liveliness, q.lease_ms)

// The same profile with a different deadline, in milliseconds.
pub @tier(embedded)
fn with_deadline(q: RosQos, deadline_ms: Int) -> RosQos []
    qos(q.history, q.depth, q.reliability, q.durability, deadline_ms, q.lifespan_ms,
        q.liveliness, q.lease_ms)

// ── Compatibility ────────────────────────────────────────────────────

// Whether two endpoints can match, and which policy stopped them.
pub @value
struct RosQosCompat
    // Whether the pair will connect.
    compatible: Bool
    // Which policy refused, one of `ROS_QOS_POLICY_*`, or
    // `ROS_QOS_POLICY_NONE`.  The FIRST one found, in the order
    // reliability, durability, deadline, liveliness, lease — a pair can
    // disagree about several and a caller can only fix one at a time.
    policy: Int
    // What the publisher offered for that policy.
    offered: Int
    // What the subscription requested.
    requested: Int

// Whether a publisher's offer satisfies a subscription's request.
//
// The whole check, in the order the policies are listed above.
// `offered` is the PUBLISHER's profile and `requested` is the
// SUBSCRIPTION's; the relation is not symmetric and swapping them gives
// a different answer.
//
// ```novo
// use rosqos
//
// fn main() [io]
//     // The most common mismatch in ROS 2: a camera publishes best
//     // effort and a program subscribes with the default profile.
//     let c = rosqos.compatible(rosqos.sensor_data_profile(),
//                               rosqos.default_profile())
//     println("${c.compatible}")   // false
//     println(rosqos.policy_name(c.policy))   // reliability
// ```
pub @tier(embedded)
fn compatible(offered: RosQos, requested: RosQos) -> RosQosCompat []
    // The first refusal wins, and the order is the one the module
    // comment gives, because a pair can disagree about several policies
    // and a caller can only fix one at a time.
    if not reliability_satisfies(offered.reliability, requested.reliability)
        return RosQosCompat {
            compatible: false,
            policy: ROS_QOS_POLICY_RELIABILITY,
            offered: offered.reliability,
            requested: requested.reliability }
    if not durability_satisfies(offered.durability, requested.durability)
        return RosQosCompat {
            compatible: false,
            policy: ROS_QOS_POLICY_DURABILITY,
            offered: offered.durability,
            requested: requested.durability }
    if not deadline_satisfies(offered.deadline_ms, requested.deadline_ms)
        return RosQosCompat {
            compatible: false,
            policy: ROS_QOS_POLICY_DEADLINE,
            offered: offered.deadline_ms,
            requested: requested.deadline_ms }
    if not liveliness_satisfies(offered.liveliness, requested.liveliness)
        return RosQosCompat {
            compatible: false,
            policy: ROS_QOS_POLICY_LIVELINESS,
            offered: offered.liveliness,
            requested: requested.liveliness }
    if not lease_satisfies(offered.lease_ms, requested.lease_ms)
        return RosQosCompat {
            compatible: false,
            policy: ROS_QOS_POLICY_LEASE,
            offered: offered.lease_ms,
            requested: requested.lease_ms }
    // Nothing refused, so there is no policy to name and no pair of
    // values that decided it.
    RosQosCompat {
        compatible: true,
        policy: ROS_QOS_POLICY_NONE,
        offered: 0,
        requested: 0 }

// Whether a reliability offer satisfies a reliability request.
//
// Reliable satisfies both requests; best effort satisfies only a
// best-effort request.
pub @tier(embedded)
fn reliability_satisfies(offered: Int, requested: Int) -> Bool []
    // Reliable is the strongest thing a publisher can offer, so it
    // satisfies either request.  Best effort satisfies only a request
    // that asks for best effort: a request left to the middleware is
    // not claimed, because what it resolves to is the vendor's choice
    // and it may resolve to reliable.
    offered == ROS_RELIABILITY_RELIABLE
        or offered == ROS_RELIABILITY_BEST_EFFORT
            and requested == ROS_RELIABILITY_BEST_EFFORT

// Whether a durability offer satisfies a durability request.
//
// Transient local satisfies both; volatile satisfies only a volatile
// request.
pub @tier(embedded)
fn durability_satisfies(offered: Int, requested: Int) -> Bool []
    // Transient local is the strongest offer, so it satisfies either
    // request; volatile satisfies only a request that asks for
    // volatile, for the reason `reliability_satisfies` gives.
    offered == ROS_DURABILITY_TRANSIENT_LOCAL
        or offered == ROS_DURABILITY_VOLATILE
            and requested == ROS_DURABILITY_VOLATILE

// Whether an offered deadline satisfies a requested one.
//
// The publisher's deadline must be no LONGER than the subscription's: a
// publisher promising a message every hundred milliseconds satisfies a
// subscriber that will tolerate two hundred, and not the other way
// round.  An infinite offered deadline satisfies only an infinite
// request, which is the case a comparison on the numbers gets backwards
// because the infinity is spelled zero.
pub @tier(embedded)
fn deadline_satisfies(offered_ms: Int, requested_ms: Int) -> Bool []
    // A subscription that tolerates any gap cannot be disappointed, and
    // a publisher that promises nothing has promised nothing.  Both are
    // asked before the numbers are compared, because an infinite
    // duration is spelled zero and a comparison on the numbers reads it
    // as the shortest deadline of all.
    if requested_ms == ROS_DURATION_INFINITE
        return true
    if offered_ms == ROS_DURATION_INFINITE
        return false
    offered_ms <= requested_ms

// Whether a liveliness offer satisfies a liveliness request.
//
// Manual-by-topic satisfies both; automatic satisfies only an automatic
// request.
pub @tier(embedded)
fn liveliness_satisfies(offered: Int, requested: Int) -> Bool []
    // A publisher that asserts its own liveliness per topic satisfies
    // either request.  A publisher that lets the middleware assert for
    // it satisfies only the request that asks for automatic
    // liveliness: a process that is running but whose control loop has
    // stopped is alive under one and dead under the other.
    offered == ROS_LIVELINESS_MANUAL_BY_TOPIC
        or offered == ROS_LIVELINESS_AUTOMATIC
            and requested == ROS_LIVELINESS_AUTOMATIC

// Whether an offered lease satisfies a requested one.
//
// The same direction as the deadline: the publisher's lease must be no
// longer than the subscription's tolerance.
pub @tier(embedded)
fn lease_satisfies(offered_ms: Int, requested_ms: Int) -> Bool []
    // The same direction as the deadline: a promise against a
    // tolerance, with the infinity spelled the same way.
    deadline_satisfies(offered_ms, requested_ms)

// Whether this policy takes part in matching at all.
//
// False for history, depth and lifespan.  Published because the
// assumption that a depth mismatch prevents a connection is common, and
// it sends people looking in the wrong place: two endpoints with
// depths of 1 and 100 connect perfectly and drop messages, which is a
// different problem with a different fix.
pub @tier(embedded)
fn policy_affects_matching(policy: Int) -> Bool []
    // The five the RxO rules compare are one run of codes.  History,
    // depth and lifespan have no code of their own, and a policy a
    // caller invented is not one either.
    policy >= ROS_QOS_POLICY_RELIABILITY and policy <= ROS_QOS_POLICY_LEASE

// The policy in words.
pub @tier(embedded)
fn policy_name(policy: Int) -> Str []
    match policy
        ROS_QOS_POLICY_NONE        => "none"
        ROS_QOS_POLICY_RELIABILITY => "reliability"
        ROS_QOS_POLICY_DURABILITY  => "durability"
        ROS_QOS_POLICY_DEADLINE    => "deadline"
        ROS_QOS_POLICY_LIVELINESS  => "liveliness"
        ROS_QOS_POLICY_LEASE       => "lease"
        _                          => "unknown"

// A one-line description of what a caller should change.
//
// The difference between a diagnostic and a fix: "reliability" names
// the policy and "the subscription asks for reliable delivery and the
// publisher offers best effort; either relax the subscription or make
// the publisher reliable" names the two edits.
pub @tier(embedded)
fn compat_advice(c: RosQosCompat) -> Str []
    if c.compatible
        return "the settings match"
    // Each arm names both edits.  A diagnostic that names only the
    // policy sends the reader looking for the fix, and one that names
    // the values as numbers needs the constants to hand.
    match c.policy
        ROS_QOS_POLICY_RELIABILITY => "the subscription asks for reliable delivery and the publisher offers best effort; relax the subscription to best effort or make the publisher reliable"
        ROS_QOS_POLICY_DURABILITY  => "the subscription asks for transient local durability and the publisher offers volatile; relax the subscription to volatile or make the publisher transient local"
        ROS_QOS_POLICY_DEADLINE    => "the publisher promises a longer gap between messages than the subscription tolerates; shorten the publisher's deadline or lengthen the subscription's"
        ROS_QOS_POLICY_LIVELINESS  => "the subscription asks for manual-by-topic liveliness and the publisher only asserts automatically; assert the publisher's liveliness per topic or accept automatic"
        ROS_QOS_POLICY_LEASE       => "the publisher may be silent for longer than the subscription tolerates; shorten the publisher's lease or lengthen the subscription's"
        _                          => "the policy is not one this package knows"

// Whether every field of a profile holds a value this package knows.
//
// A profile built by hand with a reliability of 7 is accepted by the
// middleware on some vendors and refused on others.
pub @tier(embedded)
fn qos_is_valid(q: RosQos) -> Bool []
    // Each family's known values are a run of small numbers starting at
    // zero, which is the middleware's own default; liveliness skips 2,
    // which no ROS 2 liveliness policy uses.  A depth and a duration
    // are counts of messages and of milliseconds, and a negative count
    // is not a value this package knows either.
    q.history >= ROS_HISTORY_SYSTEM_DEFAULT and q.history <= ROS_HISTORY_KEEP_ALL
        and q.reliability >= ROS_RELIABILITY_SYSTEM_DEFAULT
        and q.reliability <= ROS_RELIABILITY_BEST_EFFORT
        and q.durability >= ROS_DURABILITY_SYSTEM_DEFAULT
        and q.durability <= ROS_DURABILITY_VOLATILE
        and (q.liveliness == ROS_LIVELINESS_SYSTEM_DEFAULT
             or q.liveliness == ROS_LIVELINESS_AUTOMATIC
             or q.liveliness == ROS_LIVELINESS_MANUAL_BY_TOPIC)
        and q.depth >= 0
        and q.deadline_ms >= 0
        and q.lifespan_ms >= 0
        and q.lease_ms >= 0

// Whether the profile leaves anything to the middleware.
//
// True when any field is a `*_SYSTEM_DEFAULT`.  Worth asking before two
// nodes on different vendors are expected to match.
pub @tier(embedded)
fn qos_has_system_default(q: RosQos) -> Bool []
    // The four fields with a `*_SYSTEM_DEFAULT` value.  The durations
    // are not among them: zero is how an infinite deadline, lifespan or
    // lease is spelled, and an infinite one is a choice the profile
    // made rather than one it left to the middleware.
    q.history == ROS_HISTORY_SYSTEM_DEFAULT
        or q.reliability == ROS_RELIABILITY_SYSTEM_DEFAULT
        or q.durability == ROS_DURABILITY_SYSTEM_DEFAULT
        or q.liveliness == ROS_LIVELINESS_SYSTEM_DEFAULT

// How many message slots this profile asks the middleware to hold.
//
// The depth for keep-last, and -1 for keep-all, which has no answer.
// The number that decides how much memory an endpoint costs on a
// device, and the reason `sensor_data_profile` keeps five and not ten.
pub @tier(embedded)
fn queue_slots(q: RosQos) -> Int []
    // Keep-all has no number to answer: it keeps everything the
    // middleware's resources allow, which is a vendor's limit and not
    // this profile's.  A history left to the middleware is a question
    // this cannot answer either, and both are -1.
    if q.history == ROS_HISTORY_KEEP_LAST
        return q.depth
    0 - 1
