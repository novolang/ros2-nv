// xrcewire.nv — the Micro XRCE-DDS messages a client sends and the two
// replies it reads, built in a buffer the caller owns.
//
// `[]` THROUGHOUT and `@tier(embedded)` on all of it.  A message is
// written into a `Vec[u8; 512]`, so a device builds one with no heap and
// a host builds the same bytes and wraps them for its own link.
//
// WHAT THE BYTES ARE.  The layout is the one the eProsima client
// writes (Micro-XRCE-DDS-Client, `src/c/core/session/session_info.c`,
// `create_entities_xml.c`, `common_create_entities.c`,
// `src/c/core/serialization/xrce_header.c` and `xrce_types.c`) and the
// agent reads (`src/cpp/processor/Processor.cpp`).  Every field is
// little-endian, which each submessage's flags byte declares, and a
// multi-byte field sits at a multiple of its own size counted from the
// first byte of the MESSAGE, not of the submessage.
//
//   message header   session id (1), stream id (1), sequence number (2),
//                    and the client key (4) only when the session id is
//                    below 128.  This module uses session id 0x81, which
//                    is above 128, so the header is four bytes.
//   submessage       submessage id (1), flags (1), length (2), at an
//                    offset that is a multiple of 4; the length counts
//                    the payload and not the header or the padding.
//
//   CREATE_CLIENT (0)  "XRCE", version 1.0, vendor 0x01 0x0F, client key
//                    (most significant byte first), session id, a zero
//                    byte for "no properties", the MTU (2).  16 bytes.
//                    Its message header carries session id 0x80 (the
//                    session id with only the top bit kept), stream 0,
//                    sequence 0.
//   CREATE (1)       request id (2), object id (2), object kind (1),
//                    representation format (1: 2 means an XML string),
//                    two bytes of padding, the string's length including
//                    its terminating zero (4), the string, and then the
//                    kind's own trailer: for a participant its domain id
//                    (2, aligned to 2), for every other kind the object
//                    id of its parent (2).
//   WRITE_DATA (7)   request id (2), object id (2), then the sample.
//   STATUS_AGENT (4) the agent's answer to CREATE_CLIENT: status (1),
//                    implementation status (1), then the agent's own
//                    representation.
//   STATUS (5)       request id (2), object id (2), status (1),
//                    implementation status (1).
//   GET_INFO (2)     request id (2), the agent's object id 0xFFFD (2),
//                    an information mask (4).  Sent outside a session,
//                    with session id 0x80, it is a ping: the agent
//                    answers INFO (6) to whoever asked, session or not.
//   READ_DATA (8)    request id (2), the data reader's object id (2), the
//                    stream the samples are to come back on (1), the data
//                    format (1: 0 means DATA, the sample's bytes as they
//                    are), two booleans (1 each: a content filter, absent,
//                    and a delivery control, present), and the delivery
//                    control: the most samples (2), the longest time in
//                    seconds (2), the most bytes a second (2) and the
//                    shortest pace (2).  16 bytes.  The agent reads that
//                    many samples from DDS and answers each with a DATA;
//                    it answers a STATUS only when it refuses.
//   DATA (9)         request id (2) and object id (2) of the READ_DATA
//                    that asked, then the sample.  The format rides in the
//                    flags byte, bits 1 to 3, and 0 means the sample is the
//                    rest of the payload with no length in front of it.
//   HEARTBEAT (11)   first unacknowledged sequence number (2), last one
//                    sent (2), stream id (1).  A reliable stream's sender
//                    says what it has sent, so a receiver that lost the
//                    last message learns there was one.
//   ACKNACK (10)     first sequence number not yet received (2), a bitmap
//                    of 16 bits (2, most significant byte first) whose
//                    bit j says the message first + j is missing, stream
//                    id (1).  A reliable stream's receiver says what it
//                    has and asks for the rest.
//
// A SERVICE IS TWO ENTITIES AND THE SAMPLE IDENTITY THAT PAIRS THEM.  A
// REQUESTER (kind 7) is a service client and a REPLIER (kind 8) is a service
// server; each is created from an XML string inside a participant, and each
// is written with WRITE_DATA and read with READ_DATA like a data writer and a
// data reader.  What differs is the front of the sample
// (Micro-XRCE-DDS-Client, `src/c/core/session/write_access.c` and
// `read_access.c`; Micro-XRCE-DDS-Agent, `src/cpp/requester/Requester.cpp`,
// `src/cpp/replier/Replier.cpp` and `src/cpp/middleware/fastdds/
// FastDDSEntities.cpp`):
//
//   a request    WRITE_DATA on the requester: request id (2), the requester's
//                id (2), the request's bytes.  The agent keeps the WRITE_DATA's
//                request id as the number the reply is matched to.
//   the reply    DATA from the requester: the ids of the READ_DATA (2 + 2), then
//                the request id of the WRITE_DATA it answers (2) and the
//                requester's id (2), then the reply's bytes.
//   a request    DATA from the replier: the ids of the READ_DATA (2 + 2), then
//   at a server  the SAMPLE IDENTITY of the request (24 bytes), then the
//                request's bytes.
//   a reply      WRITE_DATA on the replier: request id (2), the replier's id
//   at a server  (2), the sample identity of the request it answers (24 bytes,
//                as it arrived), then the reply's bytes.
//
// The sample identity is the request's writer GUID (a 12-byte prefix and a
// 4-byte entity id) and a 64-bit sequence number, as two 32-bit words, all
// little-endian.  A server does not read it; it copies it from the request
// into the reply, and the agent hands it to DDS as the reply's related
// sample identity, which is how the client that asked finds its answer.
// `XrceIdentity` holds it as six numbers so that a server keeps it between
// taking a request and sending the reply with no buffer of its own.
//
// AN OBJECT ID IS TWELVE BITS OF NUMBER AND FOUR OF KIND, written most
// significant byte first: id 1 of kind 5 is 0x00 0x15.
//
// THE SAMPLE CARRIES NO ENCAPSULATION HEADER.  The agent writes the
// four-byte representation header (0x00 0x01 0x00 0x00, plain CDR
// little-endian) itself before it hands the sample to the DDS writer
// (Micro-XRCE-DDS-Agent, `src/cpp/types/TopicPubSubType.cpp`,
// `serialize`), so the bytes after the WRITE_DATA payload header are the
// CDR body alone: for a std_msgs/msg/Int32 they are the four bytes of the
// number.  A sample that began with its own header would reach every
// subscriber with eight bytes of header and the number read from the
// wrong place.  `rosmsg.encode_envelope` is for a message that travels
// with its header, and is not what a WRITE_DATA carries.
//
// THE SAMPLE A DATA CARRIES HAS NONE EITHER.  The agent takes the header
// off a sample on its way to the client (`TopicPubSubType.cpp`,
// `deserialize`: the payload from byte 4), so the bytes after a DATA's
// payload header are the CDR body alone, and for std_msgs/msg/Int32 the
// four bytes of the number.  The header's byte order is lost with it: the
// agent writes plain little-endian CDR on the way out and does not look at
// what arrives, so a sample published by a big-endian node reaches this
// package unmarked.  Every ROS 2 node on an ordinary processor is
// little-endian.

use std.str

// The session id this module uses: 0x81.
//
// Above 127, so the message header has no client key and the agent finds
// the client from the link it came in on.
pub const XRCE_SESSION_ID = 0x81
// The stream that carries a session's own messages: 0.
pub const XRCE_STREAM_NONE = 0
// The first best-effort stream: 1.
pub const XRCE_STREAM_BEST_EFFORT = 1

// Submessage ids, from the client's `SubmessageId`.
pub const XRCE_SUB_CREATE_CLIENT = 0
// Submessage id of CREATE: 1.
pub const XRCE_SUB_CREATE = 1
// Submessage id of GET_INFO: 2.
pub const XRCE_SUB_GET_INFO = 2
// Submessage id of DELETE: 3.
pub const XRCE_SUB_DELETE = 3
// Submessage id of STATUS_AGENT, the answer to CREATE_CLIENT: 4.
pub const XRCE_SUB_STATUS_AGENT = 4
// Submessage id of STATUS, the answer to CREATE and DELETE: 5.
pub const XRCE_SUB_STATUS = 5
// Submessage id of INFO, the answer to GET_INFO: 6.
pub const XRCE_SUB_INFO = 6
// Submessage id of WRITE_DATA: 7.
pub const XRCE_SUB_WRITE_DATA = 7
// Submessage id of READ_DATA: 8.
pub const XRCE_SUB_READ_DATA = 8
// Submessage id of DATA, the agent's carrier of a sample: 9.
pub const XRCE_SUB_DATA = 9
// Submessage id of ACKNACK: 10.
pub const XRCE_SUB_ACKNACK = 10
// Submessage id of HEARTBEAT: 11.
pub const XRCE_SUB_HEARTBEAT = 11
// Submessage id of FRAGMENT: 13.  One piece of a submessage too long for
// one message.
pub const XRCE_SUB_FRAGMENT = 13

// The flag of a FRAGMENT that marks the last piece: 0x02.
pub const XRCE_FLAG_LAST_FRAGMENT = 0x02

// Object kinds, from the client's `DDS_XRCE_OBJK_*`.
pub const XRCE_KIND_PARTICIPANT = 1
// Object kind of a topic: 2.
pub const XRCE_KIND_TOPIC = 2
// Object kind of a publisher: 3.
pub const XRCE_KIND_PUBLISHER = 3
// Object kind of a data writer: 5.
pub const XRCE_KIND_DATAWRITER = 5
// Object kind of a subscriber: 4.
pub const XRCE_KIND_SUBSCRIBER = 4
// Object kind of a data reader: 6.
pub const XRCE_KIND_DATAREADER = 6
// Object kind of a requester, a service client: 7.
pub const XRCE_KIND_REQUESTER = 7
// Object kind of a replier, a service server: 8.
pub const XRCE_KIND_REPLIER = 8

// The first reliable stream: 0x80.  A stream id of 0x80 or more is
// reliable, and the index is the id less 0x80.
pub const XRCE_STREAM_RELIABLE = 0x80

// The data format DATA: 0.  A DATA submessage with this format carries
// the sample's bytes as they are, with no length in front.
pub const XRCE_FORMAT_DATA = 0
// The mask of the format in a submessage's flags byte: 0x0E.
pub const XRCE_FORMAT_MASK = 0x0E

// A delivery control that asks for samples without end: 0xFFFF.
pub const XRCE_SAMPLES_UNLIMITED = 0xFFFF

// What the agent answers, from the client's `UXR_STATUS_*`.
pub const XRCE_STATUS_OK = 0
// The request found an entity already there and reused it: 1.
pub const XRCE_STATUS_OK_MATCHED = 1
// The DDS layer behind the agent refused the request: 0x80.  An XML description it cannot parse answers this.
pub const XRCE_STATUS_ERR_DDS_ERROR = 0x80
// The entity exists with a description that differs: 0x81.
pub const XRCE_STATUS_ERR_MISMATCH = 0x81
// The entity exists and the request did not allow reuse or replacement: 0x82.
pub const XRCE_STATUS_ERR_ALREADY_EXISTS = 0x82
// The agent denied the request: 0x83.
pub const XRCE_STATUS_ERR_DENIED = 0x83
// The request names an entity the agent does not hold, such as a parent never created: 0x84.
pub const XRCE_STATUS_ERR_UNKNOWN_REFERENCE = 0x84
// The request was malformed, or its XML did not describe an entity of that kind: 0x85.
pub const XRCE_STATUS_ERR_INVALID_DATA = 0x85
// The agent and the client disagree on the protocol version: 0x86.
pub const XRCE_STATUS_ERR_INCOMPATIBLE = 0x86
// The agent ran out of room for the entity: 0x87.
pub const XRCE_STATUS_ERR_RESOURCES = 0x87

// Where a sample begins in a message built by `begin_write_data`: byte
// 12, after the message header (4), the submessage header (4) and the
// request and object ids (4).
pub const XRCE_SAMPLE_START = 12
// Where a reply's bytes begin in a message built by `begin_write_reply`: byte
// 36, after the 12 bytes of `XRCE_SAMPLE_START` and the 24 of the sample
// identity.
pub const XRCE_REPLY_START = 36
// The bytes of a sample identity: 24.
pub const XRCE_IDENTITY_BYTES = 24

// Creation flags, from the client's `UXR_REUSE` and `UXR_REPLACE`: they
// ride in the submessage's flags byte.
pub const XRCE_CREATE_REUSE = 0x02
// Creation flag: replace an entity of the same id: 0x04.
pub const XRCE_CREATE_REPLACE = 0x04

// Which reply a received message held.
pub const XRCE_REPLY_NONE = 0
// The message held a STATUS_AGENT: 4.
pub const XRCE_REPLY_STATUS_AGENT = 4
// The message held a STATUS: 5.
pub const XRCE_REPLY_STATUS = 5
// The message held an INFO: 6.
pub const XRCE_REPLY_INFO = 6

// The agent's answer, read out of a received message.
//
// `kind` is one of `XRCE_REPLY_*`; for `XRCE_REPLY_STATUS_AGENT` the
// `request` and `object` are 0.
pub @value
struct XrceReply
    kind: Int
    request: Int
    object: Int
    status: Int
    implementation: Int

// The id of an object of a kind, as the two bytes that go on the wire,
// folded into one number: `number` in the top twelve bits and `kind` in
// the low four.
//
// ```novo
// use xrcewire
//
// fn main() [io]
//     println("${xrcewire.object_id(1, xrcewire.XRCE_KIND_DATAWRITER)}")   // 21, which is 0x0015
// ```
pub @tier(embedded)
@no_alloc
fn object_id(number: Int, kind: Int) -> Int []
    ((number & 0xFFF) << 4) | (kind & 0xF)

// Append one byte.
@tier(embedded)
@no_alloc
fn put_u8(var m: Vec[u8; 512], v: Int) -> Bool []
    match m.push((v & 0xFF) as u8)
        Ok(_)  => true
        Err(_) => false

// Append two bytes, least significant first.
@tier(embedded)
@no_alloc
fn put_u16(var m: Vec[u8; 512], v: Int) -> Bool []
    put_u8(var m, v) and put_u8(var m, v >>> 8)

// Append four bytes, least significant first.
@tier(embedded)
@no_alloc
fn put_u32(var m: Vec[u8; 512], v: Int) -> Bool []
    put_u16(var m, v) and put_u16(var m, v >>> 16)

// Append two bytes, most significant first: an object id or a request id.
//
// Both are two-byte arrays on the wire rather than numbers, and the
// client fills them high byte first (`uxr_init_base_object_request`,
// `uxr_object_id_to_raw`); the agent echoes a request id back as it
// received it.
@tier(embedded)
@no_alloc
fn put_object(var m: Vec[u8; 512], v: Int) -> Bool []
    put_u8(var m, v >>> 8) and put_u8(var m, v)

// Append zero bytes until the length is a multiple of `to`.
@tier(embedded)
@no_alloc
fn put_pad(var m: Vec[u8; 512], to: Int) -> Bool []
    var ok = true
    for _i in 0..to
        if ok and m.len() % to != 0
            ok = put_u8(var m, 0)
    ok

// Append a string and its terminating zero.
@tier(embedded)
@no_alloc
fn put_text(var m: Vec[u8; 512], s: Str) -> Bool []
    var ok = true
    for i in 0..str.len(s)
        ok = ok and put_u8(var m, str.byte_at_or(s, i, 0))
    ok and put_u8(var m, 0)

// Append the message header: the four bytes every message starts with.
@tier(embedded)
@no_alloc
fn put_message_header(var m: Vec[u8; 512], session: Int, stream: Int, seq: Int) -> Bool []
    put_u8(var m, session) and put_u8(var m, stream) and put_u16(var m, seq)

// Append a submessage header at the next multiple of four.
@tier(embedded)
@no_alloc
fn put_submessage_header(var m: Vec[u8; 512], id: Int, flags: Int, length: Int) -> Bool []
    // Bit 0 of the flags says the numbers are little-endian.
    put_pad(var m, 4) and put_u8(var m, id) and put_u8(var m, flags | 1)
        and put_u16(var m, length)

// Build the message that opens a session, replacing what `m` held.
//
// `key` is the four-byte client key as one number, `mtu` the largest
// message the link carries.  The message is 24 bytes and always fits, so
// the answer is always true; it is a `Bool` so that the builders have one
// shape.
//
// ```novo
// use xrcewire
//
// fn main() [io]
//     var m: Vec[u8; 512] = Vec.new()
//     println("${xrcewire.create_client(var m, 0xAABBCCDD, 512)}")   // true
//     println("${m.len()}")   // 24
// ```
pub @tier(embedded)
@no_alloc
fn create_client(var m: Vec[u8; 512], key: Int, mtu: Int) -> Bool []
    m.clear()
    var ok = put_message_header(var m, XRCE_SESSION_ID & 0x80, XRCE_STREAM_NONE, 0)
    ok = ok and put_submessage_header(var m, XRCE_SUB_CREATE_CLIENT, 0, 16)
    // "XRCE", then the protocol version 1.0 and the vendor id.
    ok = ok and put_u8(var m, 0x58) and put_u8(var m, 0x52) and put_u8(var m, 0x43)
        and put_u8(var m, 0x45)
    ok = ok and put_u8(var m, 1) and put_u8(var m, 0) and put_u8(var m, 0x01)
        and put_u8(var m, 0x0F)
    // The key goes most significant byte first.
    ok = ok and put_u8(var m, key >>> 24) and put_u8(var m, key >>> 16)
        and put_u8(var m, key >>> 8) and put_u8(var m, key)
    ok = ok and put_u8(var m, XRCE_SESSION_ID) and put_u8(var m, 0) and put_u16(var m, mtu)
    ok

// Build the message that ends a session, replacing what `m` held.
// Always fits, and answers true.
pub @tier(embedded)
@no_alloc
fn delete_client(var m: Vec[u8; 512], request: Int) -> Bool []
    m.clear()
    var ok = put_message_header(var m, XRCE_SESSION_ID, XRCE_STREAM_NONE, 0)
    ok = ok and put_submessage_header(var m, XRCE_SUB_DELETE, 0, 4)
    // The object id of the client is 0xFFFE.
    ok = ok and put_object(var m, request) and put_object(var m, 0xFFFE)
    ok

// Build the message that asks the agent whether it is there, replacing
// what `m` held.
//
// A GET_INFO for the agent with the configuration and activity bits of
// the information mask, sent with session id 0x80, which the agent
// answers whether or not a session exists.  Any INFO that comes back
// means the agent is running.  The message is 16 bytes and always fits,
// and the answer is true.
pub @tier(embedded)
@no_alloc
fn ping(var m: Vec[u8; 512], request: Int) -> Bool []
    m.clear()
    var ok = put_message_header(var m, XRCE_SESSION_ID & 0x80, XRCE_STREAM_NONE, 0)
    ok = ok and put_submessage_header(var m, XRCE_SUB_GET_INFO, 0, 8)
    ok = ok and put_object(var m, request) and put_object(var m, 0xFFFD) and put_u32(var m, 3)
    ok

// Build a message that creates one entity from an XML string, replacing
// what `m` held.
//
// `stream` and `seq` are the stream and its next sequence number,
// `request` identifies the request in the agent's status, `object` is
// the new entity's id (see `object_id`), `kind` its kind, `parent` the
// id of the entity it belongs to (for a participant: its domain id),
// `xml` its description and `flags` is `XRCE_CREATE_REPLACE`,
// `XRCE_CREATE_REUSE` or 0.  Answers whether it fitted.
//
// ```novo
// use xrcewire
//
// fn main() [io]
//     var m: Vec[u8; 512] = Vec.new()
//     let xml = "<dds><topic><name>rt/x</name><dataType>T</dataType></topic></dds>"
//     let ok = xrcewire.create_entity(var m, 1, 0, 10, xrcewire.object_id(1, 2),
//                                     xrcewire.XRCE_KIND_TOPIC, xrcewire.object_id(1, 1),
//                                     xml, xrcewire.XRCE_CREATE_REPLACE)
//     println("${ok}")   // true
// ```
pub @tier(embedded)
@no_alloc
fn create_entity(var m: Vec[u8; 512], stream: Int, seq: Int, request: Int, object: Int, kind: Int,
                 parent: Int, xml: Str, flags: Int) -> Bool []
    m.clear()
    var ok = put_message_header(var m, XRCE_SESSION_ID, stream, seq)
    // The length of the payload: the request and object ids, the kind,
    // the format and two bytes of padding, the string's length and the
    // string with its zero, and the trailer of two bytes.  A participant
    // pads to an even offset before its domain id.
    let text = str.len(xml) + 1
    var length = 4 + 1 + 1 + 2 + 4 + text + 2
    if kind == XRCE_KIND_PARTICIPANT and (length - 2) % 2 != 0
        length = length + 1
    ok = ok and put_submessage_header(var m, XRCE_SUB_CREATE, flags, length)
    ok = ok and put_object(var m, request) and put_object(var m, object)
    ok = ok and put_u8(var m, kind) and put_u8(var m, 2) and put_u16(var m, 0)
    ok = ok and put_u32(var m, text) and put_text(var m, xml)
    if kind == XRCE_KIND_PARTICIPANT
        ok = ok and put_pad(var m, 2) and put_u16(var m, parent)
    else
        ok = ok and put_object(var m, parent)
    if not ok
        m.clear()
    ok

// The kind of an object id: its low four bits.
//
// ```novo
// use xrcewire
//
// fn main() [io]
//     println("${xrcewire.object_kind(0x18)}")   // 8, a replier
// ```
pub @tier(embedded)
@no_alloc
fn object_kind(object: Int) -> Int []
    object & 0xF

// Build a message that creates a requester, a service client, from an XML
// string, replacing what `m` held.
//
// The arguments are those of `create_entity` with the kind fixed:
// `requester` is the new entity's id (see `object_id`) and `participant` the
// id of the participant it belongs to.  The XML names the service, its two
// types and its two topics:
//
// ```
// <dds><requester profile_name="add_client" service_name="add_two_ints"
//      request_type="example_interfaces::srv::dds_::AddTwoInts_Request_"
//      reply_type="example_interfaces::srv::dds_::AddTwoInts_Response_">
//   <request_topic_name>rq/add_two_intsRequest</request_topic_name>
//   <reply_topic_name>rr/add_two_intsReply</reply_topic_name>
// </requester></dds>
// ```
//
// Answers whether it fitted.
//
// ```novo
// use xrcewire
//
// fn main() [io]
//     var m: Vec[u8; 512] = Vec.new()
//     let xml = "<dds><requester profile_name=\"c\" service_name=\"s\" request_type=\"A\" reply_type=\"B\"></requester></dds>"
//     let ok = xrcewire.create_requester(var m, 1, 0, 10, xrcewire.object_id(1, 7),
//                                        xrcewire.object_id(1, 1), xml,
//                                        xrcewire.XRCE_CREATE_REPLACE)
//     println("${ok}")   // true
// ```
pub @tier(embedded)
@no_alloc
fn create_requester(var m: Vec[u8; 512], stream: Int, seq: Int, request: Int, requester: Int,
                    participant: Int, xml: Str, flags: Int) -> Bool []
    create_entity(var m, stream, seq, request, requester, XRCE_KIND_REQUESTER, participant, xml,
                  flags)

// Build a message that creates a replier, a service server, from an XML
// string, replacing what `m` held.
//
// The arguments and the XML are those of `create_requester`, with
// `<replier ...>` for `<requester ...>`.  Answers whether it fitted.
pub @tier(embedded)
@no_alloc
fn create_replier(var m: Vec[u8; 512], stream: Int, seq: Int, request: Int, replier: Int,
                  participant: Int, xml: Str, flags: Int) -> Bool []
    create_entity(var m, stream, seq, request, replier, XRCE_KIND_REPLIER, participant, xml,
                  flags)

// Start a message that writes one sample, replacing what `m` held.
//
// The message header, the submessage header and the request and object
// ids are written; the caller then appends the sample's bytes with
// `put_sample_byte` and finishes with `finish_write_data`, which stamps
// the length.  The sample is the CDR body without the representation
// header (see the top of this file).
pub @tier(embedded)
@no_alloc
fn begin_write_data(var m: Vec[u8; 512], stream: Int, seq: Int, request: Int,
                    writer: Int) -> Bool []
    m.clear()
    var ok = put_message_header(var m, XRCE_SESSION_ID, stream, seq)
    ok = ok and put_submessage_header(var m, XRCE_SUB_WRITE_DATA, 0, 0)
    ok = ok and put_object(var m, request) and put_object(var m, writer)
    ok

// Append one byte of the sample.
pub @tier(embedded)
@no_alloc
fn put_sample_byte(var m: Vec[u8; 512], v: Int) -> Bool []
    put_u8(var m, v)

// Append a 32-bit integer to the sample, least significant byte first,
// padded so that it starts at a multiple of four from the start of the
// sample.
//
// CDR aligns a four-byte number to four bytes counted from the start of
// the sample body, which is byte 12 of a message built by
// `begin_write_data`.  Twelve is a multiple of four, so for four-byte
// alignment the message offset gives the same answer; an eight-byte
// field (a double) is aligned from byte 12, not from a multiple of
// eight in the message.
pub @tier(embedded)
@no_alloc
fn put_sample_i32(var m: Vec[u8; 512], v: Int) -> Bool []
    var ok = true
    for _i in 0..4
        if ok and (m.len() - XRCE_SAMPLE_START) % 4 != 0
            ok = put_u8(var m, 0)
    ok and put_u32(var m, v)

// Fix the length of a write-data submessage after its sample is in.
//
// Answers the submessage's length.
pub @tier(embedded)
@no_alloc
fn finish_write_data(var m: Vec[u8; 512]) -> Int []
    let length = m.len() - 8
    m[6] = (length & 0xFF) as u8
    m[7] = ((length >>> 8) & 0xFF) as u8
    length

// ── A write cut into pieces ──────────────────────────────────────────

// Start a message that holds one FRAGMENT of the reliable stream, replacing
// what `m` held.
//
// The message header, with the reliable stream and the sequence number `seq`,
// and a FRAGMENT's submessage header with no length and no flags but the byte
// order. The caller appends the piece's bytes with `put_sample_byte` and
// finishes with `finish_fragment`. This is how the eProsima client sends a
// WRITE_DATA that does not fit one message (Micro-XRCE-DDS-Client,
// `uxr_prepare_reliable_buffer_to_write`): the WRITE_DATA's own submessage
// header, with the length of the whole, is the first bytes of the first
// piece, and the pieces joined are the submessage.
pub @tier(embedded)
@no_alloc
fn begin_fragment(var m: Vec[u8; 512], seq: Int) -> Bool []
    m.clear()
    put_message_header(var m, XRCE_SESSION_ID, XRCE_STREAM_RELIABLE, seq)
        and put_submessage_header(var m, XRCE_SUB_FRAGMENT, 0, 0)

// Fix the length of a FRAGMENT after its piece is in, and mark the last piece.
//
// Answers the submessage's length, the piece's bytes.
pub @tier(embedded)
@no_alloc
fn finish_fragment(var m: Vec[u8; 512], last: Bool) -> Int []
    let length = m.len() - 8
    m[6] = (length & 0xFF) as u8
    m[7] = ((length >>> 8) & 0xFF) as u8
    if last
        m[5] = ((m[5] as Int) | XRCE_FLAG_LAST_FRAGMENT) as u8
    length

// Append the front of a WRITE_DATA for a sample of `sample_length` bytes: the
// submessage header, whose length is the whole submessage's, and the request
// and object ids. The sample's bytes follow, in this piece and in the pieces
// after it.
pub @tier(embedded)
@no_alloc
fn put_write_front(var m: Vec[u8; 512], sample_length: Int, request: Int, writer: Int) -> Bool []
    put_submessage_header(var m, XRCE_SUB_WRITE_DATA, 0, 4 + sample_length)
        and put_object(var m, request) and put_object(var m, writer)

// Append the front of a WRITE_DATA that writes a reply: as `put_write_front`,
// and then the sample identity of the request it answers.
pub @tier(embedded)
@no_alloc
fn put_reply_front(var m: Vec[u8; 512], sample_length: Int, request: Int, replier: Int,
                   identity: XrceIdentity) -> Bool []
    put_submessage_header(var m, XRCE_SUB_WRITE_DATA, 0,
                          4 + XRCE_IDENTITY_BYTES + sample_length)
        and put_object(var m, request) and put_object(var m, replier)
        and put_identity(var m, identity)

// The sample identity of a request: the writer GUID and the sequence number
// DDS gave it, as six little-endian 32-bit words.
//
// A server copies it from the request into the reply, unchanged.
pub @value
struct XrceIdentity
    // Bytes 0 to 3 of the writer's GUID prefix.
    prefix0: Int
    // Bytes 4 to 7 of the writer's GUID prefix.
    prefix1: Int
    // Bytes 8 to 11 of the writer's GUID prefix.
    prefix2: Int
    // The writer's entity id: three key bytes and the kind.
    entity: Int
    // The high 32 bits of the request's sequence number.
    seq_high: Int
    // The low 32 bits of the request's sequence number.
    seq_low: Int

// An identity with every word zero, which no DDS writer has.
pub @tier(embedded)
@no_alloc
fn no_identity() -> XrceIdentity []
    XrceIdentity { prefix0: 0, prefix1: 0, prefix2: 0, entity: 0, seq_high: 0, seq_low: 0 }

// Append a sample identity: six 32-bit numbers, least significant byte
// first.
@tier(embedded)
@no_alloc
fn put_identity(var m: Vec[u8; 512], id: XrceIdentity) -> Bool []
    put_u32(var m, id.prefix0) and put_u32(var m, id.prefix1) and put_u32(var m, id.prefix2)
        and put_u32(var m, id.entity) and put_u32(var m, id.seq_high)
        and put_u32(var m, id.seq_low)

// Start a message that writes one reply, replacing what `m` held.
//
// As `begin_write_data` with the replier's id as the writer, and then the
// sample identity of the request the reply answers. The caller appends the
// reply's bytes with `put_sample_byte` and finishes with `finish_write_data`;
// they begin at byte `XRCE_REPLY_START`.
pub @tier(embedded)
@no_alloc
fn begin_write_reply(var m: Vec[u8; 512], stream: Int, seq: Int, request: Int, replier: Int,
                     identity: XrceIdentity) -> Bool []
    begin_write_data(var m, stream, seq, request, replier) and put_identity(var m, identity)

// Append a 64-bit integer to a sample, least significant byte first, padded
// so that it starts at a multiple of eight counted from `origin`, the offset
// of the sample's first byte.
//
// `XRCE_SAMPLE_START` is the origin of a request and `XRCE_REPLY_START` of a
// reply built by `begin_write_reply`; a payload built in a buffer of its own
// has origin 0. CDR aligns an eight-byte number to eight bytes counted from
// the start of the sample body.
//
// ```novo
// use xrcewire
//
// fn main() [io]
//     var m: Vec[u8; 512] = Vec.new()
//     let _ = xrcewire.put_sample_i64(var m, 5, 0)
//     println("${m.len()}")   // 8
// ```
pub @tier(embedded)
@no_alloc
fn put_sample_i64(var m: Vec[u8; 512], v: Int, origin: Int) -> Bool []
    var ok = true
    for _i in 0..8
        if ok and (m.len() - origin) % 8 != 0
            ok = put_u8(var m, 0)
    ok and put_u32(var m, v) and put_u32(var m, v >>> 32)

// Read the first status in a received message.
//
// Walks the submessages of `m` and answers the first STATUS_AGENT,
// STATUS or INFO found; any other submessage (a heartbeat, an acknowledgement)
// is stepped over by its length.  A message with no status, or one cut
// short, answers `kind = XRCE_REPLY_NONE`.
pub @tier(embedded)
@no_alloc
fn read_reply(var m: Vec[u8; 512]) -> XrceReply []
    var out = XrceReply { kind: XRCE_REPLY_NONE, request: 0, object: 0, status: 0,
                          implementation: 0 }
    let header = if m.len() > 0 and (m[0] as Int) < 128
        8
    else
        4
    var at = header
    var done = false
    for _i in 0..16
        // A submessage starts at a multiple of four.
        at = (at + 3) / 4 * 4
        if not done and at + 4 <= m.len()
            let id = m[at] as Int
            let length = m[at + 2] as Int + m[at + 3] as Int * 256
            let body = at + 4
            if id == XRCE_SUB_STATUS_AGENT and body + 2 <= m.len()
                out = XrceReply { kind: XRCE_REPLY_STATUS_AGENT, request: 0, object: 0,
                                  status: m[body] as Int, implementation: m[body + 1] as Int }
                done = true
            else if id == XRCE_SUB_STATUS and body + 6 <= m.len()
                out = XrceReply { kind: XRCE_REPLY_STATUS,
                                  request: m[body] as Int * 256 + m[body + 1] as Int,
                                  object: m[body + 2] as Int * 256 + m[body + 3] as Int,
                                  status: m[body + 4] as Int,
                                  implementation: m[body + 5] as Int }
                done = true
            else if id == XRCE_SUB_INFO
                out = XrceReply { kind: XRCE_REPLY_INFO, request: 0, object: 0, status: 0,
                                  implementation: 0 }
                done = true
            else
                at = body + length
    out

// Whether a status number means the request was carried out.
//
// `XRCE_STATUS_OK`, and `XRCE_STATUS_OK_MATCHED` for a request that
// reused an entity already there.
pub @tier(embedded)
@no_alloc
fn status_is_ok(status: Int) -> Bool []
    status == XRCE_STATUS_OK or status == XRCE_STATUS_OK_MATCHED

// A status number in words.
pub @tier(embedded)
fn status_name(status: Int) -> Str []
    match status
        XRCE_STATUS_OK                    => "ok"
        XRCE_STATUS_OK_MATCHED            => "ok, matched an existing entity"
        XRCE_STATUS_ERR_DDS_ERROR         => "DDS error"
        XRCE_STATUS_ERR_MISMATCH          => "mismatch with the existing entity"
        XRCE_STATUS_ERR_ALREADY_EXISTS    => "already exists"
        XRCE_STATUS_ERR_DENIED            => "denied"
        XRCE_STATUS_ERR_UNKNOWN_REFERENCE => "unknown reference"
        XRCE_STATUS_ERR_INVALID_DATA      => "invalid data"
        XRCE_STATUS_ERR_INCOMPATIBLE      => "incompatible"
        XRCE_STATUS_ERR_RESOURCES         => "out of resources"
        _                                 => "unknown"

// Build a message that asks the agent for samples from a data reader,
// replacing what `m` held.
//
// `stream` and `seq` are the stream this request goes out on and its next
// sequence number, `request` identifies it, `reader` is the data reader's
// id (see `object_id`), `data_stream` is the stream the samples are to
// come back on (`XRCE_STREAM_BEST_EFFORT` or `XRCE_STREAM_RELIABLE`) and
// `max_samples` how many the agent is to deliver: 1 for one sample,
// `XRCE_SAMPLES_UNLIMITED` for every sample until the request is replaced,
// 0 to stop.  The message is 24 bytes and always fits, and the answer is
// true.
//
// ```novo
// use xrcewire
//
// fn main() [io]
//     var m: Vec[u8; 512] = Vec.new()
//     let reader = xrcewire.object_id(1, xrcewire.XRCE_KIND_DATAREADER)
//     let ok = xrcewire.read_data(var m, 1, 0, 5, reader, xrcewire.XRCE_STREAM_BEST_EFFORT, 1)
//     println("${ok} ${m.len()}")   // true 24
// ```
pub @tier(embedded)
@no_alloc
fn read_data(var m: Vec[u8; 512], stream: Int, seq: Int, request: Int, reader: Int,
             data_stream: Int, max_samples: Int) -> Bool []
    m.clear()
    var ok = put_message_header(var m, XRCE_SESSION_ID, stream, seq)
    ok = ok and put_submessage_header(var m, XRCE_SUB_READ_DATA, 0, 16)
    ok = ok and put_object(var m, request) and put_object(var m, reader)
    // The stream, the format, no content filter, a delivery control.
    ok = ok and put_u8(var m, data_stream) and put_u8(var m, XRCE_FORMAT_DATA)
        and put_u8(var m, 0) and put_u8(var m, 1)
    // The most samples, and no limit on time, rate or pace.
    ok = ok and put_u16(var m, max_samples) and put_u16(var m, 0) and put_u16(var m, 0)
        and put_u16(var m, 0)
    ok

// Build a HEARTBEAT, replacing what `m` held.
//
// `first` and `last` are the first sequence number the sender still holds
// unacknowledged and the last one it sent, on the reliable stream
// `stream`.  Goes out on stream 0, sequence 0, like every submessage that
// is about a stream and not on one.  The message is 13 bytes and always
// fits, and the answer is true.
pub @tier(embedded)
@no_alloc
fn heartbeat(var m: Vec[u8; 512], first: Int, last: Int, stream: Int) -> Bool []
    m.clear()
    var ok = put_message_header(var m, XRCE_SESSION_ID, XRCE_STREAM_NONE, 0)
    ok = ok and put_submessage_header(var m, XRCE_SUB_HEARTBEAT, 0, 5)
    ok = ok and put_u16(var m, first) and put_u16(var m, last) and put_u8(var m, stream)
    ok

// Build an ACKNACK, replacing what `m` held.
//
// `first` is the first sequence number the receiver has not got, `bitmap`
// has bit j set when the message `first + j` is missing although a later
// one is known to exist, and `stream` is the reliable stream the answer is
// about.  Goes out on stream 0, sequence 0.  The message is 13 bytes and
// always fits, and the answer is true.
pub @tier(embedded)
@no_alloc
fn acknack(var m: Vec[u8; 512], first: Int, bitmap: Int, stream: Int) -> Bool []
    m.clear()
    var ok = put_message_header(var m, XRCE_SESSION_ID, XRCE_STREAM_NONE, 0)
    ok = ok and put_submessage_header(var m, XRCE_SUB_ACKNACK, 0, 5)
    // The bitmap is two bytes, the high byte first.
    ok = ok and put_u16(var m, first) and put_u8(var m, bitmap >>> 8) and put_u8(var m, bitmap)
        and put_u8(var m, stream)
    ok

// One submessage found in a received message.
pub @value
struct XrceSub
    // The submessage id, or -1 when the message holds none of that id.
    id: Int
    // The flags byte.
    flags: Int
    // The offset of the first payload byte in the message.
    body: Int
    // The payload's length in bytes.
    length: Int

// The stream a received message arrived on: byte 1 of its header, or -1
// for a message shorter than a header.
pub @tier(embedded)
@no_alloc
fn message_stream(var m: Vec[u8; 512]) -> Int []
    if m.len() < 4
        return -1
    m[1] as Int

// The sequence number of a received message: bytes 2 and 3 of its header,
// or -1 for a message shorter than a header.
pub @tier(embedded)
@no_alloc
fn message_seq(var m: Vec[u8; 512]) -> Int []
    if m.len() < 4
        return -1
    m[2] as Int + m[3] as Int * 256

// The first submessage of an id in a received message.
//
// Walks the submessages of `m` and answers the first with this id whose
// payload lies wholly inside the message; any other is stepped over by its
// length. A message without one, or one cut short, answers `id = -1`.
pub @tier(embedded)
@no_alloc
fn find_submessage(var m: Vec[u8; 512], id: Int) -> XrceSub []
    var out = XrceSub { id: -1, flags: 0, body: 0, length: 0 }
    let header = if m.len() > 0 and (m[0] as Int) < 128
        8
    else
        4
    var at = header
    var done = false
    for _i in 0..16
        // A submessage starts at a multiple of four.
        at = (at + 3) / 4 * 4
        if not done and at + 4 <= m.len()
            let length = m[at + 2] as Int + m[at + 3] as Int * 256
            if m[at] as Int == id and at + 4 + length <= m.len()
                out = XrceSub { id: id, flags: m[at + 1] as Int, body: at + 4, length: length }
                done = true
            else
                at = at + 4 + length
    out

// A sample the agent delivered, and where its bytes are in the message.
pub @value
struct XrceSample
    // Whether the message held a DATA with a sample in the DATA format.
    found: Bool
    // The request id of the READ_DATA that asked for it.
    request: Int
    // The data reader's object id.
    object: Int
    // The offset of the sample's first byte in the message.
    start: Int
    // The sample's length in bytes.
    length: Int

// Read the sample out of a received message.
//
// Answers `found = false` for a message with no DATA, a DATA shorter than
// its two ids, or a DATA in a format other than `XRCE_FORMAT_DATA`, which
// is the only one `read_data` asks for. The sample's bytes are
// `m[start]` to `m[start + length - 1]`, and `copy_sample` moves them.
pub @tier(embedded)
@no_alloc
fn read_sample(var m: Vec[u8; 512]) -> XrceSample []
    let none = XrceSample { found: false, request: 0, object: 0, start: 0, length: 0 }
    let sub = find_submessage(var m, XRCE_SUB_DATA)
    if sub.id < 0 or sub.length < 4 or (sub.flags & XRCE_FORMAT_MASK) != XRCE_FORMAT_DATA
        return none
    XrceSample {
        found: true,
        request: m[sub.body] as Int * 256 + m[sub.body + 1] as Int,
        object: m[sub.body + 2] as Int * 256 + m[sub.body + 3] as Int,
        start: sub.body + 4,
        length: sub.length - 4 }

// Copy a sample's bytes out of the message into `out`, replacing what it
// held. Answers false, with `out` empty, for a sample that was not found.
pub @tier(embedded)
@no_alloc
fn copy_sample(var m: Vec[u8; 512], sample: XrceSample, var out: Vec[u8; 512]) -> Bool []
    out.clear()
    if not sample.found
        return false
    for i in 0..sample.length
        let _ = out.push(m[sample.start + i])
    true

// A HEARTBEAT read out of a received message.
pub @value
struct XrceHeartbeat
    // Whether the message held one.
    found: Bool
    // The reliable stream it is about.
    stream: Int
    // The first sequence number the sender still holds unacknowledged.
    first: Int
    // The last sequence number the sender sent.
    last: Int

// Read a HEARTBEAT out of a received message; `found = false` when there
// is none.
pub @tier(embedded)
@no_alloc
fn read_heartbeat(var m: Vec[u8; 512]) -> XrceHeartbeat []
    let sub = find_submessage(var m, XRCE_SUB_HEARTBEAT)
    if sub.id < 0 or sub.length < 5
        return XrceHeartbeat { found: false, stream: 0, first: 0, last: 0 }
    XrceHeartbeat {
        found: true,
        stream: m[sub.body + 4] as Int,
        first: m[sub.body] as Int + m[sub.body + 1] as Int * 256,
        last: m[sub.body + 2] as Int + m[sub.body + 3] as Int * 256 }

// An ACKNACK read out of a received message.
pub @value
struct XrceAckNack
    // Whether the message held one.
    found: Bool
    // The reliable stream it is about.
    stream: Int
    // The first sequence number the receiver has not got.
    first: Int
    // Bit j set: the message `first + j` is missing.
    bitmap: Int

// Read an ACKNACK out of a received message; `found = false` when there is
// none.
pub @tier(embedded)
@no_alloc
fn read_acknack(var m: Vec[u8; 512]) -> XrceAckNack []
    let sub = find_submessage(var m, XRCE_SUB_ACKNACK)
    if sub.id < 0 or sub.length < 5
        return XrceAckNack { found: false, stream: 0, first: 0, bitmap: 0 }
    XrceAckNack {
        found: true,
        stream: m[sub.body + 4] as Int,
        first: m[sub.body] as Int + m[sub.body + 1] as Int * 256,
        bitmap: m[sub.body + 2] as Int * 256 + m[sub.body + 3] as Int }

// A FRAGMENT read out of a received message.
pub @value
struct XrceFragment
    // Whether the message held one.
    found: Bool
    // Whether it is the last piece of its submessage.
    last: Bool
    // The offset of the piece's first byte in the message.
    start: Int
    // The piece's length in bytes.
    length: Int

// Read a FRAGMENT out of a received message; `found = false` when there
// is none.
//
// An agent sends a submessage longer than the message it may send as a
// run of messages on a reliable stream, each holding one FRAGMENT.  The
// pieces, joined in order, are the whole submessage with its own
// submessage header in front (Micro-XRCE-DDS-Agent,
// `ReliableOutputStream::push_submessage`), and the last piece has bit 1 of
// its flags set.  `xrcefrag` joins them.
pub @tier(embedded)
@no_alloc
fn read_fragment(var m: Vec[u8; 512]) -> XrceFragment []
    let sub = find_submessage(var m, XRCE_SUB_FRAGMENT)
    if sub.id < 0
        return XrceFragment { found: false, last: false, start: 0, length: 0 }
    XrceFragment {
        found: true,
        last: (sub.flags & XRCE_FLAG_LAST_FRAGMENT) != 0,
        start: sub.body,
        length: sub.length }

// The 32-bit integer a sample holds in its first four bytes, least
// significant first, as a signed number. The sample of a
// std_msgs/msg/Int32. Answers 0 for a sample shorter than four bytes or
// one that was not found, which a caller tells apart by `length`.
pub @tier(embedded)
@no_alloc
fn sample_i32(var m: Vec[u8; 512], sample: XrceSample) -> Int []
    if not sample.found or sample.length < 4
        return 0
    let v = m[sample.start] as Int + m[sample.start + 1] as Int * 256
        + m[sample.start + 2] as Int * 65536 + m[sample.start + 3] as Int * 16777216
    if v >= 2147483648
        return v - 4294967296
    v

// The 64-bit integer at byte `at` of a received message, least significant
// byte first, as a signed number. Answers 0 for a number that is not wholly
// inside the message.
//
// The seven low bytes are added and the top byte is signed, so that a
// negative number comes out negative.
pub @tier(embedded)
@no_alloc
fn i64_at(var m: Vec[u8; 512], at: Int) -> Int []
    if at < 0 or at + 8 > m.len()
        return 0
    var low = 0
    var scale = 1
    for i in 0..7
        low = low + m[at + i] as Int * scale
        scale = scale * 256
    var top = m[at + 7] as Int
    if top >= 128
        top = top - 256
    low + top * scale

// The sample identity at byte `at` of a received message. Answers
// `no_identity` for one that is not wholly inside the message.
pub @tier(embedded)
@no_alloc
fn identity_at(var m: Vec[u8; 512], at: Int) -> XrceIdentity []
    if at < 0 or at + XRCE_IDENTITY_BYTES > m.len()
        return no_identity()
    XrceIdentity {
        prefix0: u32_at(var m, at), prefix1: u32_at(var m, at + 4),
        prefix2: u32_at(var m, at + 8), entity: u32_at(var m, at + 12),
        seq_high: u32_at(var m, at + 16), seq_low: u32_at(var m, at + 20) }

// The 32-bit number at byte `at` of a received message, least significant
// byte first, unsigned. The caller has checked that it is inside.
@tier(embedded)
@no_alloc
fn u32_at(var m: Vec[u8; 512], at: Int) -> Int []
    m[at] as Int + m[at + 1] as Int * 256 + m[at + 2] as Int * 65536
        + m[at + 3] as Int * 16777216

// A request at a server, read out of a sample the replier delivered.
pub @value
struct XrceRequest
    // Whether the sample was a request: the object is a replier and the
    // sample holds a whole identity.
    found: Bool
    // The id of the entity the sample belongs to, 0 for none.
    object: Int
    // The request's sample identity, which the reply carries back.
    identity: XrceIdentity
    // The offset of the request's first byte in the message.
    start: Int
    // The request's length in bytes.
    length: Int

// Read a request out of a sample that `read_sample`, or the `sample` of a
// poll, found.
//
// A sample of a data reader, or one too short to hold an identity, answers
// `found = false`; the sample is still the caller's to handle, and `object`
// says whose it is. The request's bytes are `m[start]` to
// `m[start + length - 1]`.
pub @tier(embedded)
@no_alloc
fn request_of(var m: Vec[u8; 512], sample: XrceSample) -> XrceRequest []
    var object = 0
    if sample.found
        object = sample.object
    if not sample.found or object_kind(object) != XRCE_KIND_REPLIER
        or sample.length < XRCE_IDENTITY_BYTES
        return XrceRequest { found: false, object: object, identity: no_identity(), start: 0,
                             length: 0 }
    XrceRequest {
        found: true,
        object: object,
        identity: identity_at(var m, sample.start),
        start: sample.start + XRCE_IDENTITY_BYTES,
        length: sample.length - XRCE_IDENTITY_BYTES }

// A reply at a client, read out of a sample the requester delivered.
pub @value
struct XrceResponse
    // Whether the sample was a reply: the object is a requester and the
    // sample holds the request id.
    found: Bool
    // The id of the entity the sample belongs to, 0 for none.
    object: Int
    // The request id of the WRITE_DATA this reply answers.
    request: Int
    // The offset of the reply's first byte in the message.
    start: Int
    // The reply's length in bytes.
    length: Int

// Read a reply out of a sample that `read_sample`, or the `sample` of a poll,
// found.
//
// A sample of a data reader, or one too short to hold the request id, answers
// `found = false`, with `object` saying whose it is. The reply's bytes are
// `m[start]` to `m[start + length - 1]`.
pub @tier(embedded)
@no_alloc
fn response_of(var m: Vec[u8; 512], sample: XrceSample) -> XrceResponse []
    var object = 0
    if sample.found
        object = sample.object
    if not sample.found or object_kind(object) != XRCE_KIND_REQUESTER or sample.length < 4
        return XrceResponse { found: false, object: object, request: 0, start: 0, length: 0 }
    XrceResponse {
        found: true,
        object: object,
        request: m[sample.start] as Int * 256 + m[sample.start + 1] as Int,
        start: sample.start + 4,
        length: sample.length - 4 }
