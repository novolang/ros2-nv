// roslink.nv — the session of this package over a radio that moves octets in
// chunks, for a device.
//
// A RADIO LINK IS A BYTE STREAM TO THE SESSION.  A Bluetooth LE characteristic
// pair (writes one way, notifications the other) and an L2CAP credit based
// channel both carry octets in chunks of a few hundred at most, in order, with
// no octet lost while the link is up.  The serial framing of `xrceframe` has a
// begin flag, a length and a CRC and recovers from a lost octet at the next
// begin flag, so the session of `rosuart` runs over such a link with nothing
// changed: the octets of an `XrceUart` go through two rings that a radio fills
// and empties in chunks, and `link_put`, `link_get` and `link_pause` are the three
// methods of that `XrceUart`.
//
// THE RINGS ARE THE CALLER'S.  `LinkRings` holds the two rings, their lock and
// the counters, and every function of this module takes it as its first
// argument, as `rosuart`'s functions take the message buffer: no function here
// declares an effect of its own, and a program that never builds one pays
// nothing.  The methods of `XrceUart` take `self` by value, so a product holds
// its `LinkRings` in a module-level variable of its own, which is where it pays
// `[mutate]`, and the node's task and the radio's task name the same variable.
// There is one link in an image, which is what a node with one agent has.  Each
// ring holds `ROS_LINK_RING_BYTES`, the 1,037 octets of the largest frame and a
// little over.
//
// THE RADIO IS A TRAIT, `LinkRadio[e]`, for the reason `XrceUart[e]` is one.
// A product's radio type implements it and `XrceUart`, whose three methods are
// one call each of `link_put`, `link_get` and `link_pause` with the product's
// `LinkRings` (the two impls are in `tests/roslink_tests.nv` and
// `examples/link_stdio_node.nv`); a struct over a type parameter cannot be a
// `@value`, so the package supplies the methods as functions and not as a
// ready-made `XrceUart`.  The one function of `LinkRadio`, `link_service`, is
// what a product writes over its Bluetooth stack: it takes octets out of the
// transmit ring with `link_tx_take`, sends them in chunks of whatever the link
// carries (an ATT_MTU less 3 for a notification, an SDU for a channel), gives
// the octets that arrived to `link_rx_put`, and waits up to a number of
// milliseconds for the radio's own events.  A radio that takes no octet out of
// the ring in a call leaves them for the next, and a radio that cannot put an
// octet in the receive ring (it is full) tells its peer to wait if the link has
// flow control, and drops the octet if it has none: the loss is counted in
// `LinkCounters.rx_dropped`, and the frame it cut is discarded on its CRC or at
// the next begin flag.
//
// TWO TASKS MAY SHARE THE RINGS.  A Bluetooth LE Host allocates and `rosuart`'s
// functions are `@no_alloc`, which the compiler checks through the transport's
// methods, so on a board the Host is a task of its own and the node another,
// and they preempt each other.  Every access to a ring is made under the lock
// in `LinkRings`, and the radio is serviced outside it.  Where the node and the
// radio are one task, the lock is taken and released at once.
//
// WHEN THE RADIO IS SERVICED.  Without a call of the node's own, a frame the
// node wrote would sit in the transmit ring.  The transport services the radio
// when the transmit ring is full (to make room), when the node asks for an
// octet and the receive ring is empty (to take what has arrived), and in every
// pause the session takes while it waits for the agent.  A node that polls or
// waits needs no other call.  A program that only publishes calls `link_flush`
// after a write, once per sample.
//
// NO CLOCK AND NO ALLOCATION.  A wait is the number of milliseconds the
// session names, handed to `link_service`; the node holds no heap once its
// `LinkRings` is made.
//
// A disconnect leaves a frame half sent and half received.  `link_reset` clears
// both rings, and the node opens a session again with `rosuart.open`.

// The octets one ring holds: 1,100.
pub const ROS_LINK_RING_BYTES = 1100

// The octets that crossed to the radio from the node and from the radio to the
// node, and the octets that did not fit.
pub @value
struct LinkCounters
    // Octets the radio took out of the transmit ring.
    tx_octets: Int
    // Octets the node offered while the transmit ring was full and the radio
    // had made no room: each is an octet of a frame that was not sent whole.
    tx_refused: Int
    // Octets the radio put in the receive ring.
    rx_octets: Int
    // Octets the radio offered while the receive ring was full.
    rx_dropped: Int
    // Calls of `link_service` made by the transport.
    services: Int

// What a radio supplies to this package: one call that moves octets between
// the rings and the air and waits for the radio's events.
pub trait LinkRadio[e]
    // Move octets, then wait up to `wait_ms` milliseconds for the radio to
    // have something to move; 0 does not wait.
    fn link_service(self, wait_ms: Int) [e]

// A radio that moves nothing: the link of a program that has none yet, and the
// implementation of `LinkRadio` that the package itself carries, which is what
// lets the compiler read a body behind every call of `link_service` in a build
// of the package alone.
pub @value
struct NullRadio
    // Unused; a `@value` needs a field.
    unused: Int

impl LinkRadio[] for NullRadio
    @tier(embedded)
    @no_alloc
    fn link_service(self, wait_ms: Int) []
        ()

// A radio that moves nothing.
pub @tier(embedded)
@no_alloc
fn null_radio() -> NullRadio []
    NullRadio { unused: 0 }

// The two rings, the lock they are held under and the counters, made once with `link_rings` and passed to every function of this module.
pub struct LinkRings
    var tx: Deque[u8; ROS_LINK_RING_BYTES]
    var rx: Deque[u8; ROS_LINK_RING_BYTES]
    var lock: Mutex
    var tx_octets: Int
    var tx_refused: Int
    var rx_octets: Int
    var rx_dropped: Int
    var services: Int

// Two empty rings and zeroed counters.  A boxed struct is built inside `system` at the embedded tier, so a product calls this once at start-up.
pub @tier(embedded)
fn link_rings() -> LinkRings
    system
        LinkRings { tx: Deque.new(),
            rx: Deque.new(),
            lock: core.rt.mutex_new(0),
            tx_octets: 0,
            tx_refused: 0,
            rx_octets: 0,
            rx_dropped: 0,
            services: 0 }

// Offer one octet to the receive ring on behalf of the radio.  Answers whether
// it fitted; an octet that does not is counted and dropped.
pub @tier(embedded)
@no_alloc
fn link_rx_put(var l: LinkRings, byte: Int) -> Bool []
    core.rt.mutex_lock(l.lock)
    var fitted = false
    match l.rx.push_back((byte & 0xFF) as u8)
        Ok(_)  =>
            l.rx_octets = l.rx_octets + 1
            fitted = true
        Err(_) =>
            l.rx_dropped = l.rx_dropped + 1
    core.rt.mutex_unlock(l.lock)
    fitted

// The next octet the node wrote, taken out of the transmit ring on behalf of
// the radio, or -1 when the ring is empty.
pub @tier(embedded)
@no_alloc
fn link_tx_take(var l: LinkRings) -> Int []
    core.rt.mutex_lock(l.lock)
    var taken = 0 - 1
    match l.tx.pop_front()
        Some(b) =>
            l.tx_octets = l.tx_octets + 1
            taken = b as Int
        None    => ()
    core.rt.mutex_unlock(l.lock)
    taken

// Octet `i` of those waiting in the transmit ring, 0 for the oldest, or -1 past the last: a radio that sends a chunk and removes it only
// when the link has taken it reads the chunk with this and removes it with `link_tx_drop`.
pub @tier(embedded)
@no_alloc
fn link_tx_peek(l: LinkRings, i: Int) -> Int []
    core.rt.mutex_lock(l.lock)
    var seen = 0 - 1
    match l.tx.get(i)
        Some(b) =>
            seen = b as Int
        None    => ()
    core.rt.mutex_unlock(l.lock)
    seen

// Remove the `n` oldest octets of the transmit ring, which the radio has taken: they count as octets the radio took.  Fewer are removed
// when the ring holds fewer.
pub @tier(embedded)
@no_alloc
fn link_tx_drop(var l: LinkRings, n: Int) []
    core.rt.mutex_lock(l.lock)
    for _i in 0..n
        match l.tx.pop_front()
            Some(_) =>
                l.tx_octets = l.tx_octets + 1
            None    => ()
    core.rt.mutex_unlock(l.lock)

// The octets waiting in the transmit ring.
pub @tier(embedded)
@no_alloc
fn link_tx_pending(l: LinkRings) -> Int []
    core.rt.mutex_lock(l.lock)
    let n = l.tx.len()
    core.rt.mutex_unlock(l.lock)
    n

// The octets the receive ring has room for.
pub @tier(embedded)
@no_alloc
fn link_rx_room(l: LinkRings) -> Int []
    core.rt.mutex_lock(l.lock)
    let n = l.rx.capacity() - l.rx.len()
    core.rt.mutex_unlock(l.lock)
    n

// Clear both rings, after a disconnect or before a session is opened again.
// The counters are kept.
pub @tier(embedded)
@no_alloc
fn link_reset(var l: LinkRings) []
    core.rt.mutex_lock(l.lock)
    l.tx.clear()
    l.rx.clear()
    core.rt.mutex_unlock(l.lock)

// The counters of the link.
pub @tier(embedded)
@no_alloc
fn link_counters(l: LinkRings) -> LinkCounters []
    LinkCounters { tx_octets: l.tx_octets,
        tx_refused: l.tx_refused,
        rx_octets: l.rx_octets,
        rx_dropped: l.rx_dropped,
        services: l.services }

// Set the counters to zero.
pub @tier(embedded)
@no_alloc
fn link_counters_clear(var l: LinkRings) []
    l.tx_octets = 0
    l.tx_refused = 0
    l.rx_octets = 0
    l.rx_dropped = 0
    l.services = 0

// Service the radio once without waiting: what a program that only publishes
// calls after each write.
pub @tier(embedded)
@no_alloc
fn link_flush<R: LinkRadio[e]>(var l: LinkRings, radio: R) [e]
    l.services = l.services + 1
    radio.link_service(0)

// Offer one octet to the transmit ring, the body of `XrceUart.uart_put`.
//
// A full ring is given one service call to make room, and the octet is
// refused, and counted, when the radio made none.
pub @tier(embedded)
@no_alloc
fn link_put<R: LinkRadio[e]>(var l: LinkRings, radio: R, byte: Int) -> Bool [e]
    if link_tx_pending(l) >= ROS_LINK_RING_BYTES
        l.services = l.services + 1
        radio.link_service(0)
    core.rt.mutex_lock(l.lock)
    var fitted = false
    match l.tx.push_back((byte & 0xFF) as u8)
        Ok(_)  =>
            fitted = true
        Err(_) =>
            l.tx_refused = l.tx_refused + 1
    core.rt.mutex_unlock(l.lock)
    fitted

// The next octet from the receive ring, or -1, the body of `XrceUart.uart_get`.
//
// With nothing waiting, the radio is serviced once to take what has arrived.
pub @tier(embedded)
@no_alloc
fn link_get<R: LinkRadio[e]>(var l: LinkRings, radio: R) -> Int [e]
    var got = rx_pop(var l)
    if got < 0
        l.services = l.services + 1
        radio.link_service(0)
        got = rx_pop(var l)
    got

// The next octet of the receive ring under the lock, or -1.
@tier(embedded)
@no_alloc
fn rx_pop(var l: LinkRings) -> Int []
    core.rt.mutex_lock(l.lock)
    var got = 0 - 1
    match l.rx.pop_front()
        Some(b) =>
            got = b as Int
        None    => ()
    core.rt.mutex_unlock(l.lock)
    got

// A pause of the session, the body of `XrceUart.uart_pause_ms`: the radio is
// serviced and told to wait up to `ms` milliseconds for its events.
pub @tier(embedded)
@no_alloc
fn link_pause<R: LinkRadio[e]>(var l: LinkRings, radio: R, ms: Int) [e]
    l.services = l.services + 1
    radio.link_service(ms)
