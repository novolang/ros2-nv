// rosagent.nv — the byte pipe to a micro-ROS agent, over TCP.
//
// THE ONE MODULE IN THIS PACKAGE THAT PERFORMS ANYTHING, and its row is
// `[net]` and nothing else.  No clock: every timeout here is handed to
// the socket, which is what measures it.
//
// TCP, AND NOT THE TWO TRANSPORTS A REAL DEPLOYMENT WOULD RATHER USE.
// A micro-ROS agent listens on four: UDP, TCP, a serial line and CAN
// FD.  A board on a bench is almost always on the serial line and a
// board on a robot is almost always on UDP.  Neither can be written
// against the standard library today, and each is a row worth opening:
//
//   - a UDP datagram comes back from `net.udp_recv_from` as a
//     NUL-terminated string, so it is truncated at its first zero byte
//     — and an XRCE message's header has a zero in its second byte.
//     TCP has `net.send_bytes` and `net.recv_bytes`, which is why this
//     module exists at all.
//   - there is no serial port in the standard library.  No baud rate,
//     no parity, no inter-character timeout.
//
// So this is the transport a development machine and a continuous
// integration run use, and the one a test against a real agent can be
// written with.  A device brings its own `RosTransport` over its UART.
//
// A TCP MESSAGE IS LENGTH-PREFIXED, and the prefix is not part of the
// message.  Micro XRCE-DDS puts two bytes of little-endian length in
// front of every message on a stream transport, because TCP has no
// frames of its own and a reader that took whatever `recv` returned
// would get half a message as often as it got two.  `recv_frame` is
// what reassembles them, and it is the reason the link holds a buffer.

use rostransport

// The port a micro-ROS agent listens on by default: 8888.
pub const ROS_AGENT_DEFAULT_PORT = 8888

// How many bytes of length go in front of a message on a stream
// transport: 2.
pub const ROS_TCP_LENGTH_BYTES = 2

// The largest message this transport carries, in bytes: 2048.
//
// Larger than the 512 a serial link gets, because TCP has no such
// constraint and a development machine has memory — and small enough
// that a node written against this one still fits a serial link later
// if its messages fit here with room over.
pub const ROS_AGENT_MTU = 2048

// An open connection to an agent, and the bytes not yet reassembled
// into a message.
//
// A PLAIN STRUCT, because it holds a socket and a buffer.  The buffer
// is what a stream transport needs and a datagram one does not: a
// `recv` on TCP answers whatever bytes have arrived, which is very
// often part of a message and sometimes two.
pub struct RosAgentLink
    // The socket.
    sock: Sock
    // Bytes received and not yet part of a whole message.
    pending: Bytes
    // The largest message this link will carry.
    mtu: Int
    // Whether the socket is open.
    open: Bool

impl RosTransport[net] for RosAgentLink
    // Send one message, with its two-byte length in front.
    @tier(system)
    fn ros_send(self, frame: Bytes) -> Bool [net]
        system
            // The length is the stream transport's own framing and is
            // not part of the message; a link that skipped it would
            // have the agent read the first payload byte as a length.
            if not self.open
                return false
            if bytes.len(frame) > self.mtu
                return false
            return net.send_bytes(self.sock,
                                  length_prefix(bytes.len(frame)) + frame)

    // Take one whole message, or nothing.
    //
    // Reads into the link's buffer and answers a message only when a
    // whole one is there, which is what a length prefix is for.
    @tier(system)
    fn ros_recv(self, timeout_ms: Int) -> ?Bytes [net]
        system
            // What is already buffered is what this call trusts; the
            // rest is read from the socket one known length at a time,
            // and never past the end of the frame the prefix asks for.
            // A partial frame read here cannot be kept, because
            // `pending` belongs to a link this method may not write, so
            // a caller that needs the buffer drives `feed` and
            // `take_frame` itself.
            if not self.open
                return None
            if timeout_ms > 0
                net.set_recv_timeout(self.sock, timeout_ms)
            var buffered: Bytes = bytes.clone(self.pending)
            while true
                let frame_len = length_of_prefix(buffered)
                let wanted = if frame_len < 0
                    ROS_TCP_LENGTH_BYTES - bytes.len(buffered)
                else
                    ROS_TCP_LENGTH_BYTES + frame_len - bytes.len(buffered)
                if frame_len >= 0 and wanted <= 0
                    return Some(bytes.slice(buffered, ROS_TCP_LENGTH_BYTES,
                                            ROS_TCP_LENGTH_BYTES + frame_len))
                let chunk = net.recv_bytes(self.sock, wanted)
                let arrived: Bytes = chunk ?? bytes.zeros(0)
                if bytes.len(arrived) == 0
                    return None
                buffered = buffered + arrived

    @tier(system)
    fn ros_is_open(self) -> Bool [net]
        self.open

    @tier(system)
    fn ros_close(self) [net]
        // The field says how the link was opened and cannot be written
        // through `self`; what closing means here is closing the
        // socket.
        if self.open
            net.close(self.sock)

    @tier(system)
    fn ros_mtu(self) -> Int
        self.mtu

// Open a connection to an agent.
//
// `[net]`: one TCP connection and nothing else.  Answers nothing when
// the agent is not listening — which is the ordinary case on a machine
// where nobody started one, and the reason a node should say so rather
// than retrying silently.
//
// ```novo
// use rosagent
//
// fn main() [net, io]
//     match rosagent.connect("127.0.0.1", rosagent.ROS_AGENT_DEFAULT_PORT)
//         Some(_) => println("agent found")
//         None    => println("no agent on this machine")
// ```
pub @tier(system)
fn connect(host: Str, port: Int) -> ?RosAgentLink [net]
    // The default size is the agent transport's own; a caller with a
    // different one calls `connect_with_mtu`.
    connect_with_mtu(host, port, ROS_AGENT_MTU)

// Open a connection with a stated message size.
pub @tier(system)
fn connect_with_mtu(host: Str, port: Int, mtu: Int) -> ?RosAgentLink [net]
    system
        // An open socket makes a link, and no socket is nothing; the
        // link itself is built by `link_over`.
        let made = match net.connect(host, port)
            Some(sock) => Some(link_over(sock, mtu))
            None       => None
        return made

// Close the connection.
pub @tier(system)
fn disconnect(l: RosAgentLink) [net]
    // Closing twice is harmless, and the link's own field records how
    // it was opened.
    if l.open
        net.close(l.sock)

// A link over a socket somebody else opened.
//
// For a program that got its socket from elsewhere — a test harness, a
// connection accepted rather than made — and the reason `connect` is
// not the only way in.
pub @tier(system)
fn link_over(sock: Sock, mtu: Int) -> RosAgentLink []
    system
        // An empty buffer and an open socket, which is what a link that
        // has not read anything looks like.
        return RosAgentLink {
            sock: sock,
            pending: bytes.zeros(0),
            mtu: mtu,
            open: true }

// The two bytes that go in front of a message of this length.
//
// Little-endian, which is what Micro XRCE-DDS's stream framing uses
// whatever the payload's own byte order is.  Published because it is
// the one piece of framing a caller writing its own transport has to
// match.
pub @tier(system)
fn length_prefix(n: Int) -> Bytes []
    system
        // Little-endian, whatever the payload's own byte order is.
        return bytes.u16_le(n)

// The message length two prefix bytes describe, or -1.
pub @tier(system)
fn length_of_prefix(b: Bytes) -> Int []
    if bytes.len(b) < ROS_TCP_LENGTH_BYTES
        return 0 - 1
    bytes.u16_le_at(b, 0) ?? 0 - 1

// Whether the link's buffer holds a whole message.
//
// The question `ros_recv` asks before it answers anything, and the one
// a caller draining a link by hand has to ask too.
pub @tier(system)
fn has_whole_frame(l: RosAgentLink) -> Bool []
    // Two bytes before there is a length to trust, and then the whole
    // of what the length says.
    let frame_len = length_of_prefix(l.pending)
    frame_len >= 0 and bytes.len(l.pending) >= ROS_TCP_LENGTH_BYTES + frame_len

// The whole message at the front of the link's buffer, and the link
// without it.
//
// Answers an empty `Bytes` and the link unchanged when there is no
// whole message.  Two answers from one call, because taking a message
// and shortening the buffer are one operation and doing them
// separately is how a reader loses a message.
pub @tier(system)
fn take_frame(l: RosAgentLink) -> (RosAgentLink, Bytes) []
    system
        // A prefix and a length that are not all there answer an empty
        // message and the link untouched.
        let frame_len = length_of_prefix(l.pending)
        if frame_len < 0 or bytes.len(l.pending) < ROS_TCP_LENGTH_BYTES + frame_len
            return (l, bytes.zeros(0))
        let end = ROS_TCP_LENGTH_BYTES + frame_len
        let rest: Bytes = bytes.slice(l.pending, end, bytes.len(l.pending))
        let frame: Bytes = bytes.slice(l.pending, ROS_TCP_LENGTH_BYTES, end)
        let shortened = RosAgentLink {
            sock: l.sock,
            pending: rest,
            mtu: l.mtu,
            open: l.open }
        return (shortened, frame)

// The link with more bytes appended to its buffer.
pub @tier(system)
fn feed(l: RosAgentLink, chunk: Bytes) -> RosAgentLink []
    system
        // A whole-value replacement: the buffer grows, and the socket
        // and the size do not change.
        return RosAgentLink {
            sock: l.sock,
            pending: l.pending + chunk,
            mtu: l.mtu,
            open: l.open }

// How many bytes are waiting to become a message.
//
// Worth logging when a link stops producing messages: a number that
// grows without a message coming out means the length prefix and the
// stream have lost their alignment, which nothing else reports.
pub @tier(system)
fn pending_bytes(l: RosAgentLink) -> Int []
    bytes.len(l.pending)
