// host_talker.nv — a micro-ROS node on a workstation: it opens a session
// with a Micro XRCE-DDS Agent over TCP, creates a participant, the topic
// /novo_counter of type std_msgs/msg/Int32, a publisher and a data
// writer, and publishes a counter once a second.
//
// Run it with an agent listening, then watch it from ROS 2:
//
//   MicroXRCEAgent tcp4 --port 2018          (or micro-ros-agent tcp4 --port 2018)
//   novo run examples/host_talker.nv
//   ros2 topic echo /novo_counter std_msgs/msg/Int32
//
// The agent's TCP port is 2018 by convention; this program takes the host
// and the port from its arguments, and its defaults are 127.0.0.1 and 2018.
//
// WHAT MAKES A ROS 2 PARTICIPANT SEE IT.  The names are the ones
// micro-ROS's rmw layer gives: the DDS topic of the ROS topic
// /novo_counter is `rt/novo_counter` (the `rt/` prefix is how ROS 2 maps a
// topic to DDS), and the DDS type of std_msgs/msg/Int32 is
// `std_msgs::msg::dds_::Int32_`.  The participant lives in the ROS domain
// given as the participant's parent number below, 0 unless ROS_DOMAIN_ID
// says otherwise.  The sample is the four bytes of the number: the agent
// puts the CDR representation header in front itself.

use std.env
use std.str
use std.time
use rosagent
use rostransport
use xrcewire

// The DDS domain id the participant joins: ROS_DOMAIN_ID, 0 by default.
const DOMAIN = 0

// The four entities and the ids they are created with.
const PARTICIPANT = 0x11
const TOPIC = 0x12
const PUBLISHER = 0x13
const DATAWRITER = 0x15

const TOPIC_NAME = "rt/novo_counter"
const TYPE_NAME = "std_msgs::msg::dds_::Int32_"

fn say_status(what: Str, out: RosOutcome) [io]
    println("${what}: code ${out.code}, agent status ${out.status} (${xrcewire.status_name(out.status)})")

fn main() [net, io, time]
    let args = env.args()
    var host = "127.0.0.1"
    var port = 2018
    // args[0] is the program itself.
    if list.len(args) > 1
        host = args[1]
    if list.len(args) > 2
        port = str.to_int(args[2]) ?? 2018
    match rosagent.connect(host, port)
        None       => println("no agent at ${host}:${port}")
        Some(link) =>
            talk(link)
            rosagent.disconnect(link)

fn talk(link: RosAgentLink) [net, io, time]
    var s = rostransport.session(0xAABBCCDD, rosagent.ROS_AGENT_MTU)
    s = rostransport.open_session(link, s, 2000)
    println("session: ${rostransport.session_state_name(s.state)}")
    if not rostransport.session_is_ready(s)
        return

    let participant = rostransport.create_entity(link, s, PARTICIPANT,
        xrcewire.XRCE_KIND_PARTICIPANT, DOMAIN,
        "<dds><participant><rtps><name>novo_talker</name></rtps></participant></dds>", 2000)
    say_status("participant", participant)
    let topic = rostransport.create_entity(link, participant.session, TOPIC,
        xrcewire.XRCE_KIND_TOPIC, PARTICIPANT,
        "<dds><topic><name>${TOPIC_NAME}</name><dataType>${TYPE_NAME}</dataType></topic></dds>", 2000)
    say_status("topic", topic)
    let publisher = rostransport.create_entity(link, topic.session, PUBLISHER,
        xrcewire.XRCE_KIND_PUBLISHER, PARTICIPANT, "", 2000)
    say_status("publisher", publisher)
    let writer = rostransport.create_entity(link, publisher.session, DATAWRITER,
        xrcewire.XRCE_KIND_DATAWRITER, PUBLISHER,
        "<dds><data_writer><topic><kind>NO_KEY</kind><name>${TOPIC_NAME}</name><dataType>${TYPE_NAME}</dataType></topic></data_writer></dds>", 2000)
    say_status("datawriter", writer)
    if writer.code != 0
        return

    s = writer.session
    // Long enough for the agent's writer to find a subscriber before the
    // first sample, which a best-effort stream does not repeat.
    time.sleep(1.0)
    var n = 0
    let limit = 10
    while n < limit
        let out = rostransport.write_sample(link, s, DATAWRITER, bytes.u32_le(n))
        s = out.session
        println("published ${n}: code ${out.code}")
        n = n + 1
        time.sleep(1.0)
    s = rostransport.close_session(link, s)
