// dk_sensor_node.nv — a micro-ROS node on the nRF52840-DK that publishes
// the chip's die temperature, takes a command for its LEDs and adds two
// numbers on request.
//
// It opens a session with a Micro XRCE-DDS Agent over the board's UART,
// creates a participant, two topics, a publisher with a data writer, a
// subscriber with a data reader and a replier, and then does three things in
// one loop:
//   /dk/temperature  std_msgs/msg/Int32  out, once a second: the die
//                    temperature of the nRF52840's TEMP peripheral in
//                    hundredths of a degree Celsius, 2,550 for 25.50 C.
//                    The sensor's step is 0.25 C, so the last digit pair
//                    is 00, 25, 50 or 75.
//   /dk/led          std_msgs/msg/Int32  in: 0 switches the four LEDs off,
//                    1 to 4 switches that LED on and the others off; any
//                    other number is ignored.
//
// Built for the nRF52840-DK, whose UARTE0 is the J-Link's virtual COM
// port, with the console on the UART rather than on RTT:
//
//   novo build --target=nrf52840-dk --hci-uart=physical examples/dk_sensor_node.nv
//   probe-rs run --chip nRF52840_xxAA dk_sensor_node.elf
//
// and run against an agent on the PC end of that port:
//
//   MicroXRCEAgent serial --dev /dev/serial/by-id/usb-SEGGER_J-Link_<serial>-if00 -b 115200
//   ros2 topic echo /dk/temperature std_msgs/msg/Int32
//   ros2 topic pub --once /dk/led std_msgs/msg/Int32 "{data: 2}"
//   ros2 service call /dk/add_two_ints example_interfaces/srv/AddTwoInts "{a: 2, b: 3}"
//
// The wire carries the agent's frames and nothing else, so this program
// prints nothing.
//
// The names are the ones `examples/host_talker.nv` explains: the DDS topic
// of the ROS topic /dk/temperature is `rt/dk/temperature`, and the DDS type
// of std_msgs/msg/Int32 is `std_msgs::msg::dds_::Int32_`. The service
// /dk/add_two_ints is the DDS topic `rq/dk/add_two_intsRequest` carrying
// `example_interfaces::srv::dds_::AddTwoInts_Request_` and the topic
// `rr/dk/add_two_intsReply` carrying `AddTwoInts_Response_`.
//
// WHY INT32 AND NOT FLOAT32.  `rosuart` publishes an Int32 sample
// (`publish_i32`) and reads one (`xrcewire.sample_i32`), and nothing in the
// package writes a Float32. Hundredths of a degree in an Int32 carry
// everything the sensor measures, in a type every ROS 2 tool prints.
//
// WHY THE TEMPERATURE IS READ FROM THE REGISTERS.  The board's HAL
// (`hal.gpio`, `hal.uart`, `hal.timer`, `hal.adc`, ...) has no binding for
// the TEMP peripheral, which the board's `src/bsp.nv` describes and no
// driver uses, so this program starts a measurement, waits for DATARDY and
// reads the result with `hw.mem_read32` and `hw.mem_write32`, at the
// addresses of the nRF52840 product specification, section "TEMP".

use rosuart
use rostransport
use xrceframe
use xrcestream
use xrcewire

// The ids the entities are created with. The low four bits of an id are
// the entity's kind.
const PARTICIPANT = 0x11
const TOPIC_TEMPERATURE = 0x12
const PUBLISHER = 0x13
const SUBSCRIBER = 0x14
const DATAWRITER = 0x15
const DATAREADER = 0x16
const TOPIC_LED = 0x22
// Id 1 of the kind replier.
const REPLIER = 0x18

// The TEMP peripheral of the nRF52840.
const TEMP_TASKS_START = 0x4000C000
const TEMP_TASKS_STOP = 0x4000C004
const TEMP_EVENTS_DATARDY = 0x4000C100
const TEMP_RESULT = 0x4000C508

// How long between two samples, in milliseconds.
const PERIOD_MS = 1000

// One create request, and whether the agent accepted it.
@tier(embedded)
@no_alloc
fn created(out: rostransport.RosOutcome) -> Bool []
    out.code == 0

// The die temperature in hundredths of a degree Celsius.
//
// The result register holds a signed number of quarter degrees. A
// measurement takes about 36 microseconds, so the wait for DATARDY is a
// bounded poll of the event register.
@tier(embedded)
@no_alloc
fn die_temperature() -> Int [hw]
    hw.mem_write32(TEMP_EVENTS_DATARDY, 0)
    hw.mem_write32(TEMP_TASKS_START, 1)
    for _try in 0..100000
        if hw.mem_read32(TEMP_EVENTS_DATARDY) != 0
            break
    var raw = hw.mem_read32(TEMP_RESULT)
    hw.mem_write32(TEMP_TASKS_STOP, 1)
    hw.mem_write32(TEMP_EVENTS_DATARDY, 0)
    // The register is 32 bits wide and signed.
    if raw >= 0x80000000
        raw = raw - 0x100000000
    raw * 25

// The level of LED `led` (1 to 4) after the command `cmd`. The LEDs are
// active low: the pin is 0 when the LED is on.
@tier(embedded)
@no_alloc
fn led_level(cmd: Int, led: Int) -> Int []
    if cmd == led
        return 0
    1

// Apply a command to the four LEDs. A number outside 0 to 4 changes
// nothing.
@tier(embedded)
@no_alloc
fn set_leds(cmd: Int) [hw]
    if cmd >= 0 and cmd <= 4
        hal.gpio.set(bsp.board.led1(), led_level(cmd, 1))
        hal.gpio.set(bsp.board.led2(), led_level(cmd, 2))
        hal.gpio.set(bsp.board.led3(), led_level(cmd, 3))
        hal.gpio.set(bsp.board.led4(), led_level(cmd, 4))

// Answer one request of /dk/add_two_ints, which `m` holds at `request.start`:
// two 64-bit integers, and the reply is their sum. `p` is the buffer the reply
// is built in.
@tier(embedded)
@no_alloc
fn answer<U: XrceUart[e]>(u: U, var m: Vec[u8; 512], var f: Vec[u8; 1037], var h: Vec[u8; 2056],
                          var p: Vec[u8; 512], s: rostransport.RosSession, r: xrcestream.RelStream,
                          request: xrcewire.XrceRequest) -> rostransport.RosRelOutcome [e]
    let a = xrcewire.i64_at(var m, request.start)
    let b = xrcewire.i64_at(var m, request.start + 8)
    p.clear()
    let _ = xrcewire.put_sample_i64(var p, a + b, 0)
    rosuart.send_reply(u, var m, var f, var h, s, r, REPLIER, request.identity, var p)

// Open a session and create the eight entities. Answers the session,
// established with the writer, the reader and the replier in place, or closed.
@tier(embedded)
@no_alloc
fn bring_up<U: XrceUart[e]>(u: U, var d: xrceframe.XrceDeframer, var m: Vec[u8; 512],
                            var f: Vec[u8; 1037]) -> rostransport.RosSession [e]
    let s = rosuart.open(u, var d, var m, var f, rostransport.session(0xAABBCCDD, 512), 1000)
    if not rostransport.session_is_ready(s)
        return s
    let participant = rosuart.create(u, var d, var m, var f, s, PARTICIPANT,
                                     xrcewire.XRCE_KIND_PARTICIPANT, 0,
                                     "<dds><participant><rtps><name>novo_dk_sensor</name></rtps></participant></dds>",
                                     1000)
    let temperature = rosuart.create(u, var d, var m, var f, participant.session,
                                     TOPIC_TEMPERATURE, xrcewire.XRCE_KIND_TOPIC, PARTICIPANT,
                                     "<dds><topic><name>rt/dk/temperature</name><dataType>std_msgs::msg::dds_::Int32_</dataType></topic></dds>",
                                     1000)
    let led = rosuart.create(u, var d, var m, var f, temperature.session, TOPIC_LED,
                             xrcewire.XRCE_KIND_TOPIC, PARTICIPANT,
                             "<dds><topic><name>rt/dk/led</name><dataType>std_msgs::msg::dds_::Int32_</dataType></topic></dds>",
                             1000)
    let publisher = rosuart.create(u, var d, var m, var f, led.session, PUBLISHER,
                                   xrcewire.XRCE_KIND_PUBLISHER, PARTICIPANT, "", 1000)
    let writer = rosuart.create(u, var d, var m, var f, publisher.session, DATAWRITER,
                                xrcewire.XRCE_KIND_DATAWRITER, PUBLISHER,
                                "<dds><data_writer><topic><kind>NO_KEY</kind><name>rt/dk/temperature</name><dataType>std_msgs::msg::dds_::Int32_</dataType></topic></data_writer></dds>",
                                1000)
    let subscriber = rosuart.create(u, var d, var m, var f, writer.session, SUBSCRIBER,
                                    xrcewire.XRCE_KIND_SUBSCRIBER, PARTICIPANT, "", 1000)
    let reader = rosuart.create(u, var d, var m, var f, subscriber.session, DATAREADER,
                                xrcewire.XRCE_KIND_DATAREADER, SUBSCRIBER,
                                "<dds><data_reader><topic><kind>NO_KEY</kind><name>rt/dk/led</name><dataType>std_msgs::msg::dds_::Int32_</dataType></topic></data_reader></dds>",
                                1000)
    let replier = rosuart.create_replier(u, var d, var m, var f, reader.session, REPLIER,
                                         PARTICIPANT,
                                         "<dds><replier profile_name=\"dk_add_two_ints\" service_name=\"dk/add_two_ints\" request_type=\"example_interfaces::srv::dds_::AddTwoInts_Request_\" reply_type=\"example_interfaces::srv::dds_::AddTwoInts_Response_\"><request_topic_name>rq/dk/add_two_intsRequest</request_topic_name><reply_topic_name>rr/dk/add_two_intsReply</reply_topic_name></replier></dds>",
                                         1000)
    if created(participant) and created(temperature) and created(led) and created(publisher)
       and created(writer) and created(subscriber) and created(reader) and created(replier)
        // Ask for the commands, without a limit and on the best-effort
        // stream, and for the requests, without a limit and on the reliable
        // one.
        let asked = rosuart.request_data(u, var m, var f, replier.session, DATAREADER,
                                         xrcewire.XRCE_STREAM_BEST_EFFORT,
                                         xrcewire.XRCE_SAMPLES_UNLIMITED)
        let served = rosuart.request_data(u, var m, var f, asked.session, REPLIER,
                                          xrcewire.XRCE_STREAM_RELIABLE,
                                          xrcewire.XRCE_SAMPLES_UNLIMITED)
        return served.session
    rostransport.session_with_state(replier.session, rostransport.ROS_SESSION_CLOSED)

@tier(rt)
fn main() [hw]
    bsp.board.init()
    // The four LEDs are outputs and start off.
    hal.gpio.mode(bsp.board.led1(), 1)
    hal.gpio.mode(bsp.board.led2(), 1)
    hal.gpio.mode(bsp.board.led3(), 1)
    hal.gpio.mode(bsp.board.led4(), 1)
    set_leds(0)
    // 115200 baud, the rate the agent is told with `-b 115200`.
    hal.uart.init(115200)
    let u = rosuart.console_uart()
    var d = xrceframe.deframer(xrceframe.XRCE_ADDR_CLIENT)
    var m: Vec[u8; 512] = Vec.new()
    var f: Vec[u8; 1037] = Vec.new()
    var h = xrcestream.history()
    var p: Vec[u8; 512] = Vec.new()
    var rel = xrcestream.rel_stream()
    var s = rostransport.session(0xAABBCCDD, 512)
    var last_sample = hal.timer.ticks_us() / 1000
    var last_turn = last_sample
    loop
        // Without a session, try again once a second: whether to wait,
        // blink or carry on is this program's decision and not the
        // library's.
        if not rostransport.session_is_ready(s)
            s = bring_up(u, var d, var m, var f)
            // A new session is a new stream: the agent numbers from 0 again.
            rel = xrcestream.rel_stream()
            h = xrcestream.history()
            hal.timer.delay_ms(1000)
            last_sample = hal.timer.ticks_us() / 1000
            last_turn = last_sample
        else
            // A command or a request, if one arrives within 20 ms. A request
            // is a sample of the replier, a command one of the data reader.
            let got = rosuart.poll(u, var d, var m, var f, var h, s, rel, 20)
            s = got.session
            rel = got.stream
            if got.code == 0
                let request = xrcewire.request_of(var m, got.sample)
                if request.found
                    let sent = answer(u, var m, var f, var h, var p, s, rel, request)
                    s = sent.session
                    rel = sent.stream
                else
                    set_leds(xrcewire.sample_i32(var m, got.sample))
            let now = hal.timer.ticks_us() / 1000
            if now - last_sample >= PERIOD_MS
                let out = rosuart.publish_i32(u, var m, var f, s, DATAWRITER, die_temperature())
                s = out.session
                last_sample = last_sample + PERIOD_MS
            // The silence is counted in the time that passed. A restarted
            // agent is noticed here, and nowhere else: the session becomes
            // lost and the next turn opens a new one. The reliable stream
            // counts the same time, and announces a reply the agent has not
            // acknowledged.
            rel = rosuart.reliable_tick(u, var m, var f, s, rel, now - last_turn)
            s = rosuart.keepalive(u, var m, var f, s, now - last_turn)
            last_turn = now
