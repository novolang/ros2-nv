// tests/embedded_probe.nv — this package's device claim, as a program
// that either builds for a Cortex-M or does not.
//
// THE CONSUMER IS THE NODE THIS PACKAGE EXISTS FOR: a Cortex-M with a
// serial line to an agent, two subscriptions, a timer and no heap.
// Everything that node decides before it touches the wire — whether its
// firmware was built to hold the entities it wants, whether its
// publisher and its peer's subscription can match, which handle to
// dispatch next, whether a return code means anything is wrong — is
// integer arithmetic, and this program is that arithmetic compiled for
// the hardware rather than a sentence claiming it would compile.
//
// WHAT IS NOT HERE, AND WHY.  `rosname` is not, because expanding a
// relative name against a namespace concatenates and concatenation
// allocates.  `rosmsg` is not, because a payload is a `Bytes`.
// `rostransport` is not, because a session holds one too.  `rosagent`
// is not, because it is the host module and one host-only function
// anywhere in a compilation unit is an undefined symbol at embedded
// link time whether or not the firmware calls it.
//
// What that leaves is the four modules a node consults with nothing in
// its hands but numbers, which is also the four this package would be
// worth having for if the wire never worked at all.

use std.str
use rosexec
use rosgraph
use rosqos
use rosret
use rostransport
use rosuart
use xrceframe
use xrcefrag
use xrcestream
use xrcewire

// The pair a real ROS 2 system produces most often: a camera that
// offers best-effort delivery and a program that requests the default.
@tier(embedded)
fn a_mismatched_pair() -> RosQosCompat
    rosqos.compatible(rosqos.sensor_data_profile(), rosqos.default_profile())

// A STATUS as an agent sends it: request 1, object 0x0015, status OK.
const A_STATUS = [0x81, 0x01, 0x00, 0x00, 0x05, 0x01, 0x06, 0x00, 0x00, 0x01, 0x00, 0x15,
                  0x00, 0x00]

// The serial framing and the session messages, built and read back in
// buffers on the stack: no allocation, which is what `@no_alloc` makes
// the build prove.  Six checks.
@tier(embedded)
@no_alloc
fn wire_score() -> Int
    var n = 0
    // The catalogue's check value for CRC-16/ARC over "123456789".
    var c = 0
    for k in 0..9
        c = xrceframe.crc16_step(c, 49 + k)
    if c == 0xBB3D
        n = n + 1

    // A payload with a flag byte and an escape in it goes round.
    var p: Vec[u8; 512] = Vec.new()
    let _a = p.push(0x41)
    let _b = p.push(0x7E)
    let _c = p.push(0x7D)
    var f: Vec[u8; 1037] = Vec.new()
    if xrceframe.encode(var f, var p, 1, 0)
        n = n + 1
    var d = xrceframe.deframer(0)
    if xrceframe.feed(var d, var f, 0) == xrceframe.XRCE_PUSH_FRAME
        n = n + 1
    if d.payload.len() == 3 and d.payload[1] == 0x7E and d.payload[2] == 0x7D
        n = n + 1

    // The opening message is 24 bytes, and a status read out of a
    // message built by hand is the one that was put in.
    var m: Vec[u8; 512] = Vec.new()
    if xrcewire.create_client(var m, 0xAABBCCDD, 512) and m.len() == 24
        n = n + 1
    var r = rostransport.session(1, 512)
    r = rostransport.session_established(r, xrcewire.XRCE_SESSION_ID)
    var s: Vec[u8; 512] = Vec.new()
    for i in 0..14
        let _s = s.push(A_STATUS[i] as u8)
    let reply = xrcewire.read_reply(var s)
    if reply.kind == xrcewire.XRCE_REPLY_STATUS and reply.request == r.next_request
        n = n + 1
    n

// A UART with nothing on its line that takes every byte, so that the
// device functions of `rosuart` run in the probe with no board behind
// them.
@value
struct EmptyUart
    id: Int

impl XrceUart[] for EmptyUart
    fn uart_put(self, byte: Int) -> Bool []
        true

    fn uart_get(self) -> Int []
        0 - 1

    fn uart_pause_ms(self, ms: Int) []
        ()

// The reliable stream and the subscription path, in buffers on the stack:
// the history, the state machine, the sample reader and the device
// functions of `rosuart` over a UART that is not there.  Twelve checks.
@tier(embedded)
@no_alloc
fn stream_score() -> Int
    var n = 0
    var r = xrcestream.rel_stream()
    if xrcestream.out_idle(r)
        n = n + 1
    r = xrcestream.out_wrote(xrcestream.out_wrote(r))
    if xrcestream.out_in_flight(r) == 2
        n = n + 1
    if xrcestream.out_in_flight(xrcestream.out_ack(r, 1)) == 1
        n = n + 1

    // A message kept in the history comes back from the same slot.
    var h = xrcestream.history()
    var kept: Vec[u8; 512] = Vec.new()
    let _a = kept.push(0x81)
    let _b = kept.push(0x80)
    let _c = kept.push(0x07)
    if xrcestream.history_store(var h, 1, var kept)
        n = n + 1
    var back: Vec[u8; 512] = Vec.new()
    if xrcestream.history_load(var h, 1, var back) == 3 and back[2] == 0x07
        n = n + 1

    // Two messages in order, then one after a gap: the ACKNACK names the
    // three that are missing.
    var i = xrcestream.rel_stream()
    if xrcestream.in_verdict(i, 0) == xrcestream.REL_DELIVER
        n = n + 1
    i = xrcestream.in_receive(i, 2)
    if xrcestream.in_bitmap(i) == 7
        n = n + 1

    // A recorded DATA, read, and the requests built.
    var data: Vec[u8; 512] = Vec.new()
    for k in 0..16
        let _d = data.push(A_DATA[k] as u8)
    let sample = xrcewire.read_sample(var data)
    if sample.found and xrcewire.sample_i32(var data, sample) == 7
        n = n + 1
    var rd: Vec[u8; 512] = Vec.new()
    if xrcewire.read_data(var rd, 1, 0, 1, 0x16, xrcewire.XRCE_STREAM_RELIABLE,
                          xrcewire.XRCE_SAMPLES_UNLIMITED) and rd.len() == 24
        n = n + 1
    var ak: Vec[u8; 512] = Vec.new()
    if xrcewire.acknack(var ak, 1, 0, xrcewire.XRCE_STREAM_RELIABLE) and ak.len() == 13
        n = n + 1

    // The device functions over a line with nothing on it: a write goes
    // out and takes a slot, and a poll finds nothing, which is not an
    // error.
    let u = EmptyUart { id: 1 }
    var m: Vec[u8; 512] = Vec.new()
    var f: Vec[u8; 1037] = Vec.new()
    var d = xrceframe.deframer(xrceframe.XRCE_ADDR_CLIENT)
    let up = rostransport.session_established(rostransport.session(1, 512),
                                              xrcewire.XRCE_SESSION_ID)
    let w = rosuart.publish_i32_reliable(u, var m, var f, var h, up, xrcestream.rel_stream(),
                                         0x15, 5)
    if w.code == rosret.ROS_RET_OK and xrcestream.out_in_flight(w.stream) == 1
        n = n + 1
    let got = rosuart.poll(u, var d, var m, var f, var h, up, w.stream, 2)
    if got.code == rosret.ROS_RET_SUBSCRIPTION_TAKE_FAILED
        n = n + 1
    n

// A DATA carrying the integer 7, cut as the agent cuts one longer than its
// message: the first ten bytes of the submessage in one FRAGMENT and the last
// two in another, on stream 0x80 at sequences 0 and 1.
const A_PIECE_1 = [0x81, 0x80, 0x00, 0x00, 0x0D, 0x01, 0x0A, 0x00, 0x09, 0x01, 0x08, 0x00, 0x00,
                   0x05, 0x00, 0x16, 0x07, 0x00]
const A_PIECE_2 = [0x81, 0x80, 0x01, 0x00, 0x0D, 0x03, 0x02, 0x00, 0x00, 0x00]

// One of the two pieces, as a message in a buffer.
@tier(embedded)
@no_alloc
fn message_of_piece(first: Bool) -> Vec[u8; 512] []
    var m: Vec[u8; 512] = Vec.new()
    if first
        for k in 0..18
            let _p = m.push(A_PIECE_1[k] as u8)
    else
        for k in 0..10
            let _p = m.push(A_PIECE_2[k] as u8)
    m

// Fragments: the reader, the joining in a buffer on the stack, a sample too
// long for the buffer the caller allowed, and the device poll over a line
// with nothing on it.  Eight checks.
@tier(embedded)
@no_alloc
fn frag_score() -> Int
    var n = 0
    var p1 = message_of_piece(true)
    var p2 = message_of_piece(false)
    let f1 = xrcewire.read_fragment(var p1)
    if f1.found and not f1.last and f1.length == 10
        n = n + 1
    let f2 = xrcewire.read_fragment(var p2)
    if f2.found and f2.last and f2.start == 8
        n = n + 1

    var a: Vec[u8; 2048] = Vec.new()
    var state = xrcefrag.reassembly(100)
    let e1 = xrcefrag.push(var p1, state, var a)
    if e1.code == xrcefrag.FRAG_MORE and a.len() == 10
        n = n + 1
    let e2 = xrcefrag.push(var p2, e1.assembly, var a)
    if e2.code == xrcefrag.FRAG_DONE and e2.sample.length == 4 and a[0] == 7
        n = n + 1
    state = xrcefrag.begin(e2.assembly, var a)
    if a.len() == 0 and not state.finished
        n = n + 1

    // The smallest reassembly takes no sample, and drops this one with all
    // its pieces.
    let none = xrcefrag.reassembly(0)
    let d1 = xrcefrag.push(var p1, none, var a)
    let d2 = xrcefrag.push(var p2, d1.assembly, var a)
    if d1.code == xrcefrag.FRAG_TOO_LONG and d2.code == xrcefrag.FRAG_MORE and a.len() == 0
        n = n + 1

    let u = EmptyUart { id: 1 }
    var m: Vec[u8; 512] = Vec.new()
    var fr: Vec[u8; 1037] = Vec.new()
    var d = xrceframe.deframer(xrceframe.XRCE_ADDR_CLIENT)
    var h = xrcestream.history()
    let up = rostransport.session_established(rostransport.session(1, 512),
                                              xrcewire.XRCE_SESSION_ID)
    let got = rosuart.poll_long(u, var d, var m, var fr, var h, var a, up,
                                xrcestream.rel_stream(), state, 2)
    if got.code == rosret.ROS_RET_SUBSCRIPTION_TAKE_FAILED
        n = n + 1
    let kept = xrcefrag.keep_sample(var p1, xrcewire.XrceSample { found: true, request: 5,
                                    object: 0x16, start: 16, length: 2 },
                                    state, var a)
    if kept.code == xrcefrag.FRAG_DONE and a.len() == 2
        n = n + 1
    n

// Services: a requester and a replier created, a request and a reply written,
// and a request and a reply read back out of the agent's DATA, with a 64-bit
// number each way.  Eight checks.
@tier(embedded)
@no_alloc
fn service_score() -> Int
    var n = 0
    var m: Vec[u8; 512] = Vec.new()
    if xrcewire.create_replier(var m, 1, 0, 1, 0x18, 0x11, "<dds></dds>", 0) and m[12] == 8
        n = n + 1
    if xrcewire.create_requester(var m, 1, 0, 1, 0x17, 0x11, "<dds></dds>", 0) and m[12] == 7
        n = n + 1

    // A request, 40 and 2, as the agent accepted it, and a reply, 5, to an
    // identity of 24 bytes that are not zero.
    let _b = xrcewire.begin_write_data(var m, xrcewire.XRCE_STREAM_RELIABLE, 0, 4, 0x17)
    let _x = xrcewire.put_sample_i64(var m, 40, xrcewire.XRCE_SAMPLE_START)
    let _y = xrcewire.put_sample_i64(var m, 2, xrcewire.XRCE_SAMPLE_START)
    if xrcewire.finish_write_data(var m) == 20 and m.len() == 28
        n = n + 1
    let id = xrcewire.XrceIdentity { prefix0: 0x9C820F01, prefix1: 0x098B6C76, prefix2: 0,
                                     entity: 0x03140000, seq_high: 0, seq_low: 1 }
    let _r = xrcewire.begin_write_reply(var m, xrcewire.XRCE_STREAM_RELIABLE, 0, 57, 0x18, id)
    let _s = xrcewire.put_sample_i64(var m, 0 - 5, xrcewire.XRCE_REPLY_START)
    if xrcewire.finish_write_data(var m) == 36 and m.len() == 44 and m[12] == 1 and m[15] == 0x9C
        n = n + 1

    // The same bytes read as the agent sends them: the front of a DATA is the
    // ids of the READ_DATA, and the sample begins at byte 12.
    m[4] = 9
    m[8] = 0
    m[9] = 3
    var data = m
    let sample = xrcewire.read_sample(var data)
    let request = xrcewire.request_of(var data, sample)
    if sample.found and request.found and request.start == 36 and request.length == 8
        n = n + 1
    if request.identity.prefix0 == 0x9C820F01 and request.identity.seq_low == 1
        n = n + 1
    if xrcewire.i64_at(var data, request.start) == 0 - 5
        n = n + 1
    if not xrcewire.response_of(var data, sample).found
        n = n + 1

    // A reply at a requester: the call's request id 4, then 42.
    var r: Vec[u8; 512] = Vec.new()
    let _c = xrcewire.begin_write_data(var r, xrcewire.XRCE_STREAM_RELIABLE, 1, 3, 0x17)
    let _d = xrcewire.put_sample_byte(var r, 0)
    let _e = xrcewire.put_sample_byte(var r, 4)
    let _f = xrcewire.put_sample_byte(var r, 0)
    let _g = xrcewire.put_sample_byte(var r, 0x17)
    let _h = xrcewire.put_sample_i64(var r, 42, 4)
    let _i = xrcewire.finish_write_data(var r)
    r[4] = 9
    let reply_sample = xrcewire.read_sample(var r)
    let reply = xrcewire.response_of(var r, reply_sample)
    if reply.found and reply.request == 4 and xrcewire.i64_at(var r, reply.start) == 42
        n = n + 1
    n

// A sample cut into pieces and written: the FRAGMENT built and finished, the
// pieces of 700 bytes and of a reply, the history that keeps them, and the
// place a second call goes on from.  Six checks.
@tier(embedded)
@no_alloc
fn long_score() -> Int
    var n = 0
    var m: Vec[u8; 512] = Vec.new()
    if xrcewire.begin_fragment(var m, 3) and xrcewire.put_write_front(var m, 700, 5, 0x15)
        and m.len() == 16 and xrcefrag.piece_room(var m) == 496
        n = n + 1
    if xrcewire.finish_fragment(var m, true) == 8 and m[5] == 3 and m[6] == 8
        n = n + 1

    let u = EmptyUart { id: 1 }
    var f: Vec[u8; 1037] = Vec.new()
    var h = xrcestream.history()
    let up = rostransport.session_established(rostransport.session(1, 512),
                                              xrcewire.XRCE_SESSION_ID)
    var payload: Vec[u8; 2048] = Vec.new()
    for k in 0..700
        let _p = payload.push((k % 251) as u8)
    let w = rosuart.write_sample_long(u, var m, var f, var h, up, xrcestream.rel_stream(), 0x15,
                                      var payload, 0)
    if w.code == rosret.ROS_RET_OK and w.done and w.at == 700
        n = n + 1
    if xrcestream.out_in_flight(w.stream) == 2 and w.request == 1
        n = n + 1

    // A sample the window cannot hold at once is written as far as it goes.
    for k in 700..2040
        let _q = payload.push((k % 251) as u8)
    var h2 = xrcestream.history()
    let part = rosuart.send_reply_long(u, var m, var f, var h2, up, xrcestream.rel_stream(), 0x18,
                                       xrcewire.no_identity(), var payload, 0)
    if not part.done and part.at == 1984
        n = n + 1
    let blocked = rosuart.send_request_long(u, var m, var f, var h2, up, part.stream, 0x17,
                                            var payload, part.at)
    if blocked.code == rosret.ROS_RET_BAD_ALLOC
        n = n + 1

    // A sample a piece at a time: 4,000 bytes that are never held whole, the
    // first piece 496 bytes and the next 504, and the last place reached.
    var chunk: Vec[u8; 504] = Vec.new()
    var h3 = xrcestream.history()
    var rel = xrcestream.rel_stream()
    var sess = up
    var at = 0
    var pieces = 0
    for _k in 0..16
        if at < 4000
            if not xrcestream.out_can_write(rel)
                rel = xrcestream.out_ack(rel, rel.out_next)
            let take = xrcefrag.piece_take(4000, at, false)
            chunk.clear()
            for j in 0..take
                let _c = chunk.push(((at + j) % 251) as u8)
            let out = rosuart.write_piece(u, var m, var f, var h3, sess, rel, 0x15, false,
                                          xrcewire.no_identity(), 4000, at, var chunk)
            sess = out.session
            rel = out.stream
            at = out.at
            pieces = pieces + 1
    if at == 4000 and pieces == 8
        n = n + 1
    if xrcefrag.piece_take(4000, 0, false) == 496 and xrcefrag.piece_take(4000, 3500, false) == 500
        n = n + 1
    n

// The agent's DATA carrying the integer 7, as recorded.
const A_DATA = [0x81, 0x01, 0x04, 0x00, 0x09, 0x01, 0x08, 0x00, 0x00, 0x05, 0x00, 0x16,
                0x07, 0x00, 0x00, 0x00]

// Every answer this probe checks, folded into one number so a single
// comparison decides the run.
//
// A firmware image has one line of output; making it depend on all of
// them is what stops a passing run from meaning "the first check held".
@tier(embedded)
fn score() -> Int
    var n = 0

    // The return codes, and the four that are not failures.  A node
    // that logged all four prints errors under load.
    if rosret.ros_ret_is_ok(rosret.ROS_RET_OK)
        n = n + 1
    if not rosret.ros_ret_is_error(rosret.ROS_RET_SUBSCRIPTION_TAKE_FAILED)
        n = n + 1
    if not rosret.ros_ret_is_error(rosret.ROS_RET_CLIENT_TAKE_FAILED)
        n = n + 1
    if not rosret.ros_ret_is_error(rosret.ROS_RET_SERVICE_TAKE_FAILED)
        n = n + 1
    if not rosret.ros_ret_is_error(rosret.ROS_RET_TIMEOUT)
        n = n + 1
    if rosret.ros_ret_is_error(rosret.ROS_RET_WAIT_SET_FULL)
        n = n + 1
    if rosret.ros_ret_is_take_failed(rosret.ROS_RET_SUBSCRIPTION_TAKE_FAILED)
        n = n + 1
    if rosret.ros_ret_is_invalid_handle(rosret.ROS_RET_NODE_INVALID)
        n = n + 1
    if rosret.ros_ret_subsystem(rosret.ROS_RET_PUBLISHER_INVALID) == 3
        n = n + 1
    if rosret.ros_ret_is_extension(rosret.ROS_RET_QOS_INCOMPATIBLE)
        n = n + 1
    if not rosret.ros_ret_is_extension(rosret.ROS_RET_ERROR)
        n = n + 1
    if str.len(rosret.ros_ret_name(rosret.ROS_RET_NOT_INIT)) > 0
        n = n + 1
    if str.len(rosret.ros_ret_subsystem_name(2)) > 0
        n = n + 1

    // The quality-of-service arithmetic, which is the one thing a node
    // on a device cannot discover any other way: an incompatible pair
    // is created successfully and never connects.
    let bad = a_mismatched_pair()
    if not bad.compatible
        n = n + 1
    if bad.policy == rosqos.ROS_QOS_POLICY_RELIABILITY
        n = n + 1
    if str.len(rosqos.compat_advice(bad)) > 0
        n = n + 1
    if str.len(rosqos.policy_name(bad.policy)) > 0
        n = n + 1
    if rosqos.compatible(rosqos.default_profile(),
                         rosqos.sensor_data_profile()).compatible
        n = n + 1
    if rosqos.reliability_satisfies(rosqos.ROS_RELIABILITY_RELIABLE,
                                    rosqos.ROS_RELIABILITY_BEST_EFFORT)
        n = n + 1
    if not rosqos.durability_satisfies(rosqos.ROS_DURABILITY_VOLATILE,
                                       rosqos.ROS_DURABILITY_TRANSIENT_LOCAL)
        n = n + 1
    if rosqos.deadline_satisfies(100, 200)
        n = n + 1
    if not rosqos.deadline_satisfies(rosqos.ROS_DURATION_INFINITE, 100)
        n = n + 1
    if rosqos.lease_satisfies(500, 1000)
        n = n + 1
    if not rosqos.liveliness_satisfies(rosqos.ROS_LIVELINESS_AUTOMATIC,
                                       rosqos.ROS_LIVELINESS_MANUAL_BY_TOPIC)
        n = n + 1
    if rosqos.policy_affects_matching(rosqos.ROS_QOS_POLICY_DEADLINE)
        n = n + 1
    if not rosqos.policy_affects_matching(rosqos.ROS_QOS_POLICY_NONE)
        n = n + 1
    if rosqos.default_profile().depth == 10
        n = n + 1
    if rosqos.sensor_data_profile().depth == 5
        n = n + 1
    if rosqos.services_profile().reliability == rosqos.ROS_RELIABILITY_RELIABLE
        n = n + 1
    if rosqos.parameters_profile().depth == 1000
        n = n + 1
    let latched = rosqos.transient_local_profile().durability
    if latched == rosqos.ROS_DURABILITY_TRANSIENT_LOCAL
        n = n + 1
    if rosqos.qos_has_system_default(rosqos.system_default_profile())
        n = n + 1
    let hand = rosqos.qos(rosqos.ROS_HISTORY_KEEP_LAST, 7,
                          rosqos.ROS_RELIABILITY_BEST_EFFORT,
                          rosqos.ROS_DURABILITY_VOLATILE, 200, 1000,
                          rosqos.ROS_LIVELINESS_AUTOMATIC, 3000)
    if rosqos.qos_is_valid(hand)
        n = n + 1
    if not rosqos.qos_has_system_default(hand)
        n = n + 1
    let rel = rosqos.with_reliability(hand, rosqos.ROS_RELIABILITY_RELIABLE)
    if rel.reliability == rosqos.ROS_RELIABILITY_RELIABLE
        n = n + 1
    let dur = rosqos.with_durability(hand, rosqos.ROS_DURABILITY_TRANSIENT_LOCAL)
    if dur.durability == rosqos.ROS_DURABILITY_TRANSIENT_LOCAL
        n = n + 1
    if rosqos.with_depth(hand, 3).depth == 3
        n = n + 1
    if rosqos.with_deadline(hand, 50).deadline_ms == 50
        n = n + 1
    if rosqos.queue_slots(rosqos.sensor_data_profile()) == 5
        n = n + 1

    // The entity pool, which on this part is an array sized before the
    // program started.  A stock build allows one of everything.
    let pool = rosgraph.default_pool()
    if pool.max_publishers == 1
        n = n + 1
    if pool.max_history == 4
        n = n + 1
    if rosgraph.can_add(pool, rosgraph.ROS_ENTITY_PUBLISHER)
        n = n + 1
    let one = rosgraph.add(pool, rosgraph.ROS_ENTITY_PUBLISHER)
    if rosgraph.used_of(one, rosgraph.ROS_ENTITY_PUBLISHER) == 1
        n = n + 1
    if not rosgraph.can_add(one, rosgraph.ROS_ENTITY_PUBLISHER)
        n = n + 1
    if rosgraph.add_ret(one, rosgraph.ROS_ENTITY_PUBLISHER) == rosret.ROS_RET_BAD_ALLOC
        n = n + 1
    if rosgraph.remaining(one, rosgraph.ROS_ENTITY_PUBLISHER) == 0
        n = n + 1
    if rosgraph.can_add(rosgraph.remove(one, rosgraph.ROS_ENTITY_PUBLISHER),
                        rosgraph.ROS_ENTITY_PUBLISHER)
        n = n + 1
    if rosgraph.capacity_of(pool, rosgraph.ROS_ENTITY_TIMER) == -1
        n = n + 1
    if rosgraph.pool_admits(pool, 1, 1, 1, 1)
        n = n + 1
    if not rosgraph.pool_admits(pool, 2, 1, 0, 0)
        n = n + 1
    if rosgraph.first_shortfall(pool, 2, 1, 0, 0) == rosgraph.ROS_ENTITY_PUBLISHER
        n = n + 1
    if str.len(rosgraph.entity_name(rosgraph.ROS_ENTITY_SUBSCRIPTION)) > 0
        n = n + 1
    let big = rosgraph.pool(1, 8, 8, 2, 2, 16)
    if rosgraph.capacity_of(big, rosgraph.ROS_ENTITY_SUBSCRIPTION) == 8
        n = n + 1

    // Two endpoints, and the two mismatches that connect nothing and
    // say nothing.
    let p = rosgraph.endpoint(rosgraph.ROS_ENTITY_PUBLISHER, 0, 1111,
                              rosqos.sensor_data_profile())
    let s = rosgraph.endpoint(rosgraph.ROS_ENTITY_SUBSCRIPTION, 0, 1111,
                              rosqos.default_profile())
    let s_ok = rosgraph.endpoint(rosgraph.ROS_ENTITY_SUBSCRIPTION, 0, 1111,
                                 rosqos.sensor_data_profile())
    let s_other = rosgraph.endpoint(rosgraph.ROS_ENTITY_SUBSCRIPTION, 0, 2222,
                                    rosqos.sensor_data_profile())
    if rosgraph.can_connect(p, s) == rosret.ROS_RET_QOS_INCOMPATIBLE
        n = n + 1
    if rosgraph.can_connect(p, s_ok) == rosret.ROS_RET_OK
        n = n + 1
    if rosgraph.can_connect(p, s_other) == rosret.ROS_RET_ERROR
        n = n + 1
    let absent = rosgraph.no_endpoint(rosgraph.ROS_ENTITY_SUBSCRIPTION)
    if rosgraph.can_connect(p, absent) == rosret.ROS_RET_INVALID_ARGUMENT
        n = n + 1
    if not rosgraph.connect_qos(p, s).compatible
        n = n + 1
    if rosgraph.same_type(p, s)
        n = n + 1
    if not rosgraph.same_type(p, s_other)
        n = n + 1
    if rosgraph.effective_depth(pool, s) == 4
        n = n + 1
    if not rosgraph.depth_is_honoured(pool, s)
        n = n + 1

    // The executor, driven from outside.  A publisher is not a handle,
    // and the order handles were added is the schedule.
    if rosexec.handles_required(2, 1, 0, 0, 0) == 3
        n = n + 1
    if rosexec.ROS_EXEC_MAX_HANDLES == 64
        n = n + 1
    var e = rosexec.executor(3)
    if rosexec.handle_order(e) == 0
        n = n + 1
    e = rosexec.add_handle(e)
    e = rosexec.add_handle(e)
    e = rosexec.add_handle(e)
    if e.count == 3
        n = n + 1
    if not rosexec.can_add_handle(e)
        n = n + 1
    if rosexec.add_handle_ret(e) == rosret.ROS_RET_WAIT_SET_FULL
        n = n + 1
    if rosexec.remaining_handles(e) == 0
        n = n + 1
    if rosexec.ready_bit(2) == 4
        n = n + 1
    if rosexec.is_ready(0x5, 2)
        n = n + 1
    if rosexec.ready_count(0x7) == 3
        n = n + 1
    let all = rosexec.set_trigger(e, rosexec.ROS_TRIGGER_ALL, -1)
    if not rosexec.should_dispatch(all, 0x3)
        n = n + 1
    if rosexec.should_dispatch(all, 0x7)
        n = n + 1
    let one_h = rosexec.set_trigger(e, rosexec.ROS_TRIGGER_ONE, 2)
    if rosexec.should_dispatch(one_h, 0x4)
        n = n + 1
    if str.len(rosexec.trigger_name(rosexec.ROS_TRIGGER_ANY)) > 0
        n = n + 1
    let let_sem = rosexec.set_semantics(e, rosexec.ROS_SEMANTICS_LET)
    if rosexec.takeable(let_sem, 0x1, 0x7) == 0x1
        n = n + 1
    if str.len(rosexec.semantics_name(rosexec.ROS_SEMANTICS_LET)) > 0
        n = n + 1
    let begun = rosexec.spin_begin(e)
    if not rosexec.spin_done(begun)
        n = n + 1
    let step = rosexec.spin_step(begun, 0x1)
    if step.dispatch
        n = n + 1
    if step.index == 0
        n = n + 1
    if step.has_message
        n = n + 1
    if step.ret == rosret.ROS_RET_OK
        n = n + 1
    if step.kind >= 0
        n = n + 1
    if rosexec.spin_advance(begun).cursor > begun.cursor
        n = n + 1
    if rosexec.set_timeout(e, 50).timeout_ms == 50
        n = n + 1

    // The timer, counted in the caller's own milliseconds, with no
    // clock anywhere in the package.
    let late = rosexec.timer_advance(rosexec.timer(100, rosexec.ROS_TIMER_CATCH_UP),
                                     1000)
    if rosexec.timer_is_ready(late)
        n = n + 1
    if rosexec.timer_owed(late) == 10
        n = n + 1
    if rosexec.timer_owed(rosexec.timer_fired(late)) == 9
        n = n + 1
    let skipped = rosexec.timer_advance(
        rosexec.timer(100, rosexec.ROS_TIMER_SKIP_MISSED), 1000)
    if rosexec.timer_owed(skipped) == 1
        n = n + 1
    let early = rosexec.timer_advance(
        rosexec.timer(100, rosexec.ROS_TIMER_SKIP_MISSED), 40)
    if not rosexec.timer_is_ready(early)
        n = n + 1
    if rosexec.timer_next_ms(early) == 60
        n = n + 1
    if not rosexec.timer_is_ready(rosexec.timer_cancel(late))
        n = n + 1
    if rosexec.timer_next_ms(rosexec.timer_reset(early)) == 100
        n = n + 1
    if rosexec.spin_wait_ms(rosexec.set_timeout(e, 100), early) == 60
        n = n + 1

    n + wire_score() + stream_score() + frag_score() + service_score() + long_score()

@tier(rt)
fn main() [hw]
    bsp.board.init()
    // 137 is the number of checks in `score`, `wire_score`, `stream_score`, `frag_score`, `service_score` and `long_score`.  The count is printed on a
    // failure rather than only compared, so a device that disagrees with
    // the host says HOW MANY it lost and a bisect has somewhere to start.
    let n = score()
    if n == 137
        hal.uart.write("PASS: ros2-embedded\n")
    else
        hal.uart.write("FAIL: ros2-embedded score=")
        hal.uart.write(str.from_int(n))
        hal.uart.write("\n")
    loop
        hal.timer.delay_ms(1000)
